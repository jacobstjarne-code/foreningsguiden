#!/bin/sh
# Arbetsorder 2026-08-03, punkt 4 — valideringsgrinden. Installeras av
# `npm install` (package.json "prepare": git config core.hooksPath
# scripts/git-hooks). Kan kringgås (--no-verify) — CI:n (.github/workflows/
# validera.yml) kör samma kontroller och kan inte kringgås på samma sätt.
#
# 2026-08-04: validerar nu exakt det som faktiskt committas, inte hela
# arbetsträdet. Rot till produktionsutfallet samma dag (fixat i ded3eca):
# tio kommun-YAML låg okommitterade-men-närvarande på disk när en
# datavärde-omdöpning committades. Hooken validerade blandningen av
# committat+okommitterat och gav grönt — men det som faktiskt gick till
# origin/main saknade datafixen och failade i CI (som klonar den riktiga
# committen) och i Vercels build, oupptäckt i flera timmar eftersom ingen
# tittade på CI-status. `git stash push --keep-index` gömmer ospårade
# ändringar i SPÅRADE filer under körningen så grinden ser samma sak som
# CI/Vercel ser. Medvetet INTE --include-untracked: det här är ett delat
# arbetsträd med en parallell process pågående, och ospårade artefakter
# ska aldrig röras av den här hooken.
set -e

# INCIDENT 2026-08-25 (AA1.2-utveckling): en fixturs git-repo-skript
# skrev av misstag `git config user.email test@example.com` in i DETTA
# repos delade .git/config (samma GIT_DIR-arv-bugg som skrev fixturens
# commits på repots riktiga HEAD, se c3866f6:s commit-meddelande) —
# och en riktig commit gick sedan ut till origin/main författad av
# "Test <test@example.com>" innan någon märkte det. Ett testvärde i
# författarfältet ska aldrig kunna passera tyst, precis som ett
# sandbox-organisationsnummer inte ska kunna passera säljargaten
# (src/lib/saljargate.ts) — samma princip, samma fail-closed-regel.
EFFEKTIV_EPOST=$(git config user.email || echo "")
case "$EFFEKTIV_EPOST" in
  *example.com*)
    echo "BLOCKERAD — git config user.email är '$EFFEKTIV_EPOST', ett testvärde (example.com)."
    echo "Kör: git config --unset user.email && git config --unset user.name"
    echo "(rensar en eventuell lokal/repo-överskrivning, faller tillbaka på ~/.gitconfig)."
    exit 1
    ;;
esac

STASHED=0
if ! git diff --quiet; then
  git stash push --keep-index --quiet --message "pre-commit: temporär undanstoppning av ospårade ändringar i spårade filer"
  STASHED=1
fi
aterstall() {
  if [ "$STASHED" = "1" ]; then
    git stash pop --quiet
  fi
}
trap aterstall EXIT

echo "→ Schemavalidering..."
node --experimental-strip-types scripts/validera-data.ts

echo "→ POST-routes svarar 405 på GET (AB1.6)..."
node --experimental-strip-types scripts/verify-post-routes-405.ts

echo "→ Regressionsskydd (bidragsantal)..."
node --experimental-strip-types scripts/verify-ingen-bidrag-regression.ts --mot=HEAD

echo "→ Regressionsskydd (krav_fullstandiga)..."
node --experimental-strip-types scripts/verify-krav-fullstandiga-regression.ts --mot=HEAD

echo "→ Blandningsspärr (mekanisk omräkning + researchpass)..."
node --experimental-strip-types scripts/verify-mekanisk-verifiering-blandning.ts

echo "→ Avregistreringslänk i bevakningsmejlen (J1.3)..."
node --experimental-strip-types scripts/verify-mejl-avregistrering.ts

echo "→ astro build..."
npm run build

echo "→ Matchning + golden set..."
node --experimental-strip-types scripts/verify-matching.ts > /dev/null
node --experimental-strip-types scripts/verify-generator.ts > /dev/null

echo "→ Belopp-avser + renderingsregressioner..."
node --experimental-strip-types scripts/verify-belopp-avser.ts > /dev/null
node --experimental-strip-types scripts/verify-belopp-rendering.ts > /dev/null

echo "→ Giltighetsregler G1..."
node --experimental-strip-types scripts/verify-giltighet-regler.ts > /dev/null

echo "→ Källa/CTA-konsistens..."
node --experimental-strip-types scripts/verify-kalla-cta.ts > /dev/null

echo "→ KLAR.md-talet (rapport, fäller aldrig)..."
node --experimental-strip-types scripts/verify-kommun-klar.ts --ci

echo "Valideringsgrinden godkänd."
