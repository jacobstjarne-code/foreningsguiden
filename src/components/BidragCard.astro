---
// DataCard — riktning "1c" (designsystem/screenshots/top.png, explicit
// "vald riktning" i designsystem/Bidragskollen riktningar.dc.html Runda 2).
// Byggd för återbruk i vertikal 2 (§7 UPPDRAG_POC.md): känner bara till
// Bidrag-fälten, inte "kommun" som koncept. `verifierad`/`ansokningsUrl`
// kommer från kommunen (bidrag saknar egna fält för det i schemat).
//
// Avsiktligt UTELÄMNAT mot mockupen: beskrivningsstycke (schemat har inget
// fritextfält för det — malgrupp är målgrupp, inte programbeskrivning, och
// Code hittar inte på text), DNR (finns inget diarienummer i datat), status-
// pill "öppen för ansökan" (inget öppningsdatum i schemat att räkna mot),
// Bevaka-knapp (bevakningsflödet är på is, se statusrapport).
import type { Bidrag } from '../lib/kommuner';
import { KATEGORI_LABELS, formatRecurringDate, formatDate, relativFrist, harRiktigSenAnsokanText } from '../lib/kommuner';
import VerificationStamp from './VerificationStamp.astro';
import VoidMark from './VoidMark.astro';
import RelativeDeadline from './RelativeDeadline.astro';

export interface Props {
  bidrag: Bidrag;
  verifierad: string;
  ansokningsUrl: string;
  kommunSlug: string;
}

const { bidrag, verifierad, ansokningsUrl, kommunSlug } = Astro.props;
const beloppDatum = formatDate(bidrag.senast_verifierad ?? verifierad);

// deadlines.typ === 'relativ' avgörs INNAN denna funktion anropas (se
// dd-blocket nedan — RelativeDeadline-komponenten tar över helt då),
// så funktionen behöver bara skilja lopande/okand/fasta. 'ingen_regel'
// tillagd vid sammanslagningen 2026-08-03 (en parallell Code-session
// idé, bra) — en bekräftad "ingen fast frist" är ett annat besked än
// "vi vet inte", samma logik som VoidState/VoidMark-uppdelningen.
function formatDeadlines(b: Bidrag): string {
  if (b.deadline_status === 'ingen_regel') return 'Kommunen anger uttryckligen ingen fast ansökningsfrist.';
  if (b.deadlines.typ === 'lopande') return 'Löpande ansökan';
  if (b.deadlines.typ === 'okand') return 'Kommunen publicerar inget ansökningsdatum — kontrollera direkt hos kommunen.';
  return b.deadlines.datum.map(formatRecurringDate).join(' · ');
}

// H26 — status-notis i stället för CTA:n när kommunen pausat/avskaffat
// bidraget. 'pausad' är tillfälligt (attention), 'avskaffat' är permanent
// (urgent) — samma två-tonersmodell som resten av sajten.
const statusNotis: Record<'pausad' | 'avskaffat', string> = {
  pausad: 'Pausat av kommunen — sök inte just nu.',
  avskaffat: 'Avskaffat av kommunen.',
};
---
<li class="bidrag-card fg-card" id={`bidrag-${bidrag.id}`}>
  <div class="kategori-tags">
    {bidrag.kategori.map((k) => (
      <span class="kategori-tag fg-tag">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
        {KATEGORI_LABELS[k]}
      </span>
    ))}
  </div>

  <h3>{bidrag.namn}</h3>

  <dl>
    <dt>Målgrupp</dt>
    <dd>{bidrag.malgrupp}</dd>

    <dt>Deadline</dt>
    <dd>
      {bidrag.deadlines.typ === 'relativ' ? <RelativeDeadline bidrag={bidrag} /> : formatDeadlines(bidrag)}
    </dd>

    <dt>Belopp</dt>
    <dd>
      {bidrag.belopp_status === 'ingen_regel' ? (
        'Kommunen anger uttryckligen inget belopp eller tak.'
      ) : bidrag.belopp === null ? (
        // VoidMark bara vid genuint ingen uppgift alls — INTE när
        // belopp_status:overifierat kommer från en platshållarfras
        // ("Individuell bedömning") som fortfarande är riktig, användbar
        // text från källan (korrigera-belopp-platshallare.ts rör bara
        // statusfältet, aldrig själva texten).
        <VoidMark
          etikett="Ej angivet i källan"
          faltnamn="beloppsuppgift"
          faltnamnBestamd="beloppet"
          datum={beloppDatum}
          kallaUrl={bidrag.kalla_url}
          kommunSlug={kommunSlug}
          bidragId={bidrag.id}
          bidragNamn={bidrag.namn}
        />
      ) : (
        bidrag.belopp
      )}
    </dd>

    <dt>Krav</dt>
    <dd>
      {bidrag.krav_status === 'overifierat' ? (
        <p>Kraven är inte verifierade ännu — kontrollera källan innan du bedömer behörighet.</p>
      ) : bidrag.krav_status === 'ingen_regel' ? (
        <p>Kommunen anger uttryckligen inga särskilda krav.</p>
      ) : bidrag.krav.length > 0 ? (
        <ul>
          {bidrag.krav.map((k) => <li>{k}</li>)}
        </ul>
      ) : (
        <p>Inga strukturerade krav har registrerats.</p>
      )}
      {bidrag.krav_status === 'angivet' && !bidrag.krav_fullstandiga && (
        <p><strong>Ofullständigt:</strong> fler villkor kan finnas i kommunens normer eller riktlinjer.</p>
      )}
    </dd>

    {/* Giltighet hör hemma på Forutsattning (kommunens "hur länge gäller
        beslutet", inte per-bidrag) — se GiltighetsKontroll.astro,
        hittaGiltighetsregel() i kommunTyper.ts. En parallell Code-session
        lade tillfälligt giltighet/giltighet_status direkt på Bidrag vid
        sammanslagningen 2026-08-03; borttaget härifrån (dubblerad källa
        till samma sak, "en sanning, ett ställe"). */}

    {/* 2e + uppföljning (arbetsorder 2026-08-03): döljs för sentinelvärdet
        "Ej angivet i källan" OCH för feltaggningar som bara restaterar
        deadline-cykeln ("15 mars varje år") i stället för en konsekvens
        — se harRiktigSenAnsokanText (kommunTyper.ts) för motiveringen. */}
    {harRiktigSenAnsokanText(bidrag) && (
      <>
        <dt>Sen ansökan</dt>
        <dd>{bidrag.sen_ansokan}</dd>
      </>
    )}
  </dl>

  <div class="bidrag-card__divider"></div>

  <div class="bidrag-card__footer">
    <p class="bidrag-card__kalla">
      Källa: <a href={bidrag.kalla_url}>{bidrag.kalla_url}</a>
    </p>
    <VerificationStamp bidrag={bidrag} verifierad={verifierad} />
  </div>
  {/* Anteckningen döljs här om den redan visas i deadline-fältet ovan
      (relativFrist) — annars stod samma besked på kortet två gånger. */}
  {bidrag.anteckning && !relativFrist(bidrag) && <p class="bidrag-card__kalla">{bidrag.anteckning}</p>}

  <div class="felrapport" data-felrapport data-kommun-slug={kommunSlug} data-bidrag-id={bidrag.id} data-bidrag-namn={bidrag.namn}>
    <button type="button" class="felrapport-knapp">Det här stämmer inte</button>
  </div>

  {bidrag.status === 'aktiv' ? (
    <a href={ansokningsUrl} class="btn-primary bidrag-card__cta">Till ansökan</a>
  ) : (
    <p class={`bidrag-card__status-notis bidrag-card__status-notis--${bidrag.status === 'avskaffat' ? 'urgent' : 'attention'}`}>
      {statusNotis[bidrag.status]}
    </p>
  )}
</li>
