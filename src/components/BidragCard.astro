---
// DataCard — riktning "1c" (designsystem/screenshots/top.png, explicit
// "vald riktning" i designsystem/Bidragskollen riktningar.dc.html Runda 2).
// Byggd för återbruk i vertikal 2 (§7 UPPDRAG_POC.md): känner bara till
// Bidrag-fälten, inte "kommun" som koncept. `verifierad`/`ansokningsUrl`
// kommer från kommunen (bidrag saknar egna fält för det i schemat).
//
// Avsiktligt UTELÄMNAT mot mockupen: beskrivningsstycke (schemat har inget
// fritextfält för det — malgrupp är målgrupp, inte programbeskrivning, och
// Code hittar inte på text), DNR (finns inget diarienummer i datat), status-
// pill "öppen för ansökan" (inget öppningsdatum i schemat att räkna mot),
// Bevaka-knapp (bevakningsflödet är på is, se statusrapport).
import type { Bidrag } from '../lib/kommuner';
import {
  formatDate, relativFrist, earliestDeadlineISO, daysUntil, getUrgency, todayISO,
} from '../lib/kommuner';
import BidragDjup from './BidragDjup.astro';
import UrgencyChip from './UrgencyChip.astro';

export interface Props {
  bidrag: Bidrag;
  verifierad: string;
  ansokningsUrl: string;
  kommunSlug: string;
  kommunNamn: string;
  giltighetStatus: import('../lib/kommuner').Datatillstand;
}

const { bidrag, verifierad, ansokningsUrl, kommunSlug, kommunNamn, giltighetStatus } = Astro.props;

// R5.8 (OMFORDELA_TEXTMASSAN.md, Jacob 2026-08-06): kortet är nu en
// kollapsad rad, samma radmönster som station 4 (KommunProgression) —
// namn, datum, belopp. today() lokalt hellre än en ny prop: samma
// billiga, rena funktion som redan anropas överallt, ingen anropskedja
// att ändra för en enda kommunSlug-scopad sida.
const today = todayISO();
const dateISO = earliestDeadlineISO(bidrag, today);
const radDatumText = dateISO
  ? formatDate(dateISO)
  : bidrag.deadlines.typ === 'relativ' ? (relativFrist(bidrag) ?? 'löpande ansökan')
  : bidrag.deadlines.typ === 'okand' ? 'inget publicerat datum' : 'löpande ansökan';

// TILLSTANDET_OLAST.md (runda 4, "Vad Code behöver veta" §3): EN
// reservation per kort, aldrig per fält. Beräknas över de tre fält som
// faktiskt kan bära en synlig markör här (giltighet ligger på
// Forutsattning, inte per bidrag). Samma beräkning som BidragDjup gör
// för banderollen — den kollapsade radens ikon behöver den INNAN
// BidragDjup renderas, så duplicerad hellre än trådad som en prop för
// en tre-rads ren funktion.
const harOlastFalt = [bidrag.belopp_status, bidrag.deadline_status, bidrag.krav_status].includes('olast');
---
<li class="bidrag-card fg-card" data-bidrag-id={bidrag.id}>
  {/* R5.8 (OMFORDELA_TEXTMASSAN.md, Jacob 2026-08-06): kortet kollapsat
     till en rad — samma radmönster som station 4 (progression__list-row,
     återanvänd rakt av). Ankaret (id="bidrag-X") sitter nu på det
     FÄLLBARA elementet, inte på <li>, per instruktion — länkarna från
     station 2/4 (#bidrag-X) siktar alltså direkt på <details>, och
     scriptet i botten öppnar den om den är fragmentmålet (initial load
     + hashchange), utan att innehållet någonsin kräver JS för att
     FINNAS — bara för att auto-fällas upp. */}
  <details class="bidrag-card__disclosure" id={`bidrag-${bidrag.id}`} data-bidrag-disclosure>
    <summary class="bidrag-card__rad">
      <div class="progression__list-row__text">
        <div class="progression__list-row__namn">
          <span
            class={harOlastFalt ? 'fg-void-mark fg-void-mark--inline' : 'fg-read-mark fg-read-mark--inline'}
            aria-hidden="true"
          ></span>
          {bidrag.namn}
        </div>
      </div>
      <div class="progression__list-row__tal">
        {dateISO && <UrgencyChip urgency={getUrgency(daysUntil(dateISO, today))} />}
        <span class="progression__list-row__belopp">{bidrag.belopp ?? 'belopp inte publicerat'}</span>
        <span class="progression__list-row__datum">{radDatumText}</span>
      </div>
      <svg class="bidrag-card__rad-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
    </summary>
    <div class="bidrag-card__djup">
      <BidragDjup
        bidrag={bidrag}
        verifierad={verifierad}
        ansokningsUrl={ansokningsUrl}
        kommunSlug={kommunSlug}
        kommunNamn={kommunNamn}
        giltighetStatus={giltighetStatus}
      />
    </div>
  </details>
</li>
