---
// RegistreringsHjalp — grupp 3:s ("Börja här") CTA i matchningstratten
// (turn-11, GUIDE_TRATT_COPY.ts besked.borjaHar) OCH KommunProgression
// Station 3. Länkar till registreringsutkastet
// (/kommun/[slug]/registrera/, SPEC_UTKASTGENERATOR §4) i stället för att
// fälla ut ett e-postformulär direkt — checklistan är fri och omedelbar,
// ingen e-post krävs för att se den. E-postformuläret (personlig hjälp
// att fylla i den) sitter längst ner på den sidan, se registrera/
// index.astro.
//
// Klicket loggas ändå (fire-and-forget, keepalive) — samma
// intentmätning som innan, bara utan att blockera navigeringen.
import { TRATT } from '../../GUIDE_TRATT_COPY';

export interface Props {
  // Kommunen är okänd vid byggtid i tratten (väljs klientsidan,
  // src/pages/matcha/index.astro) — default tomt, länken sätts/uppdateras
  // via data-kommun-slug + JS när fråga 1 besvarats. I KommunProgression
  // (Station 3) är kommunen känd server-sidan och skickas direkt.
  kommunSlug?: string;
}

const { kommunSlug = '' } = Astro.props;
const href = kommunSlug ? `/kommun/${kommunSlug}/registrera/` : '#';
---
<div class="registrering-hjalp" data-registrering-hjalp data-kommun-slug={kommunSlug}>
  <p class="registrering-hjalp__text">{TRATT.besked.borjaHar.hjalpText}</p>
  <a href={href} class="btn-primary" data-registrering-lank>{TRATT.besked.borjaHar.hjalpKnapp}</a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-registrering-hjalp]').forEach((widget) => {
    const lank = widget.querySelector<HTMLAnchorElement>('[data-registrering-lank]');
    let klickLoggat = false;

    lank?.addEventListener('click', () => {
      if (klickLoggat) return;
      klickLoggat = true;
      const data = new FormData();
      data.set('kommun', widget.dataset.kommunSlug ?? '');
      data.set('syfte', 'registrering');
      fetch('/api/vantelista-klick', { method: 'POST', body: data, keepalive: true }).catch(() => {});
    });
  });
</script>
