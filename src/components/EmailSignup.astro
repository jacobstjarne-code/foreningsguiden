---
// Deadlinebevakning — §6 UPPDRAG_POC.md. LIVE (Handoff 2026-07-10): Fable
// bytte kvittoRubrik/kvittoText till en ärlig PoC-variant som inte lovar ett
// bekräftelsemejl som aldrig skickas — se content.ts BEVAKNING-kommentaren.
// Byt till dubbel-opt-in-varianten (kommenterad i content.ts) när Resend-
// utskicket byggs.
//
// Avregistrering utan mejllänk (Codes beslut, rapporterat till Fable):
// egen sida /avregistrera/ där man skriver in sin adress, samma princip
// som anmälan. Länkad härifrån tills integritetsraden är omskriven mot det.
import { loadKommuner } from '../lib/kommuner';
import { BEVAKNING } from '../lib/content';

export interface Props {
  submitted?: boolean;
  // P3.1a (Jacob 2026-08-05): radens kommun förkryssad när formuläret
  // nås med kontext (deadlines/index.astro läser ?kommun= server-sidan,
  // SSR — behöver ingen klient-JS för att förkrysstillståndet ska vara
  // rätt redan vid första render). undefined utanför radkontext (nav,
  // sidfot) = nuvarande beteende, ingen ruta förkryssad.
  preselectedKommunSlug?: string;
}

const { submitted = false, preselectedKommunSlug } = Astro.props;
const kommuner = loadKommuner();
const preselected = kommuner.find((k) => k.kommun_slug === preselectedKommunSlug);

// AB1.1 (Jacobs order): 290 färdigrenderade checkboxar (~123 KB, 593
// taggar — mätt) var den STÖRSTA enskilda posten på deadlinekalenderns
// första laddning, större än själva kalendertabellen efter dess egen
// AB1.1-fix. "Bygg rader först vid filtrering" (ordens andra godkända
// strategi, den första — server-scopa på vald kommun — gäller redan
// tabellerna): kompakt JSON (korta nycklar, ~4-5 KB för alla 290) i
// stället för färdig DOM, <script> nedan bygger en kryssruta per
// sökträff on demand. Riktig <form method="POST"> (ingen fetch) —
// dynamiskt tillagda checkboxar är fortfarande vanliga formulärfält
// och skickas med som vanligt så länge de finns i DOM vid submit.
const kommunerJson = JSON.stringify(kommuner.map((k) => ({ n: k.kommun, s: k.kommun_slug })));
---
{submitted ? (
  <div class="email-signup fg-card" id="email-signup" data-email-signup-submitted="1" data-email-signup-kommun={preselectedKommunSlug ?? ''}>
    <h2>{BEVAKNING.kvittoRubrik}</h2>
    <p>{BEVAKNING.kvittoText}</p>
  </div>
) : (
  <form class="email-signup fg-card" id="email-signup" method="POST" action="/api/prenumerera" data-email-signup-kommun={preselectedKommunSlug ?? ''}>
    <h2>{BEVAKNING.rubrik}</h2>
    <p>{BEVAKNING.ingress}</p>

    <label for="email-signup-email">{BEVAKNING.epostLabel}</label>
    <input type="email" id="email-signup-email" name="email" placeholder={BEVAKNING.epostPlaceholder} required autocomplete="email" />

    {/* C1 (ARBETSORDER 2026-08-11): frivilligt — inget required, ett namn
        på föreningen blockerar aldrig bevakningen. */}
    <label for="email-signup-foreningsnamn">{BEVAKNING.foreningsnamnLabel}</label>
    <input type="text" id="email-signup-foreningsnamn" name="foreningsnamn" autocomplete="organization" />

    <fieldset>
      <legend>{BEVAKNING.kommunLabel}</legend>
      {/* AB1.1: den förvalda kommunen (om en finns) är den enda
         checkbox som server-renderas — resten byggs av <script> nedan,
         en per sökträff, i stället för alla 290 i förväg. */}
      <div class="email-signup__valda" data-email-signup-valda>
        {preselected && (
          <label class="email-signup__kommun" data-email-signup-vald-rad={preselected.kommun_slug}>
            <input type="checkbox" name="kommuner" value={preselected.kommun_slug} checked />
            {preselected.kommun}
          </label>
        )}
      </div>
      <label class="email-signup__sok">
        Lägg till fler kommuner
        <input type="text" placeholder="Sök din kommun — t.ex. Gislaved" data-email-signup-sok autocomplete="off" />
      </label>
      <div class="email-signup__traffar" data-email-signup-traffar></div>
      <script type="application/json" data-email-signup-kommundata set:html={kommunerJson} />
    </fieldset>

    <label class="email-signup__consent">
      <input type="checkbox" name="samtycke" required />
      {BEVAKNING.samtycke}
    </label>

    <button type="submit" class="btn-primary">{BEVAKNING.knapp}</button>
    <p class="email-signup__integritet">
      {BEVAKNING.integritetsrad} <a href="/avregistrera/">Avregistrera dig</a>.
    </p>
  </form>
)}

<script>
  // M3 (MÄTNING, Jacob 2026-08-11): formuläret är ett riktigt POST + 303-
  // redirect (inte fetch), så "skickad" kan inte fångas i ett submit-
  // intercept — prenumerera.ts redirectar redan med ?bevakning=klar/
  // uppdaterad vid lyckat POST, och submitted-propen (satt server-sidan av
  // deadlines/index.astro utifrån SAMMA query-param) avgör om det är
  // kvittoläget vi ser just nu. En sida-load i det läget ÄR "skickad".
  import { trackEvent } from '../lib/umami';
  import { saveForeningsprofil } from '../lib/foreningsprofil';

  const root = document.getElementById('email-signup');
  if (root) {
    const kommun = root.dataset.emailSignupKommun || null;
    trackEvent(root.dataset.emailSignupSubmitted === '1' ? 'bevakning_skickad' : 'bevakning_visad', { kommun });

    // E1-uppföljning (Jacob 2026-08-11): speglar föreningsnamnet till
    // Foreningsprofil (localStorage) i SAMMA ögonblick som formuläret
    // postas — riktig POST+redirect, inget fetch-intercept, så det här
    // MÅSTE ske synkront i 'submit' innan navigeringen händer. Ett tomt
    // fält sparas aldrig (samma "tomt skriver aldrig över" som server-
    // sidans addPendingSubscriber).
    if (root instanceof HTMLFormElement) {
      root.addEventListener('submit', () => {
        const varde = (new FormData(root).get('foreningsnamn') ?? '').toString().trim();
        if (varde) saveForeningsprofil({ foreningsnamn: varde });
      });
    }

    // AB1.1 (Jacobs order): "bygg rader först vid filtrering" — bygger en
    // kryssruta per sökträff i stället för att servera alla 290 färdiga.
    // Fortfarande ett riktigt formulärfält (name="kommuner") så länge det
    // finns i DOM vid submit — riktig POST, ingen fetch, ingen särskild
    // hantering behövs på servern (api/prenumerera.ts oförändrad).
    const sokInput = root.querySelector<HTMLInputElement>('[data-email-signup-sok]');
    const traffarEl = root.querySelector<HTMLElement>('[data-email-signup-traffar]');
    const valdaEl = root.querySelector<HTMLElement>('[data-email-signup-valda]');
    const dataEl = root.querySelector<HTMLScriptElement>('[data-email-signup-kommundata]');

    if (sokInput && traffarEl && valdaEl && dataEl) {
      let kommunerData: { n: string; s: string }[] = [];
      try {
        kommunerData = JSON.parse(dataEl.textContent ?? '[]');
      } catch {
        kommunerData = [];
      }

      const redanVald = (slug: string) => !!valdaEl.querySelector(`[data-email-signup-vald-rad="${slug}"]`);

      function laggTill(kommun: { n: string; s: string }) {
        if (redanVald(kommun.s)) return;
        const label = document.createElement('label');
        label.className = 'email-signup__kommun';
        label.dataset.emailSignupValdRad = kommun.s;
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.name = 'kommuner';
        cb.value = kommun.s;
        cb.checked = true;
        const taBort = document.createElement('button');
        taBort.type = 'button';
        taBort.className = 'email-signup__ta-bort';
        taBort.setAttribute('aria-label', `Ta bort ${kommun.n}`);
        taBort.textContent = '×';
        taBort.addEventListener('click', () => label.remove());
        label.append(cb, ` ${kommun.n} `, taBort);
        valdaEl.append(label);
      }

      function visaTraffar() {
        const query = sokInput.value.trim().toLowerCase();
        traffarEl.replaceChildren();
        if (query === '') return;
        const traffar = kommunerData.filter((k) => k.n.toLowerCase().includes(query) && !redanVald(k.s)).slice(0, 8);
        for (const k of traffar) {
          const knapp = document.createElement('button');
          knapp.type = 'button';
          knapp.className = 'email-signup__traff';
          knapp.textContent = `+ ${k.n}`;
          knapp.addEventListener('click', () => {
            laggTill(k);
            sokInput.value = '';
            traffarEl.replaceChildren();
            sokInput.focus();
          });
          traffarEl.append(knapp);
        }
      }

      sokInput.addEventListener('input', visaTraffar);
    }
  }
</script>
