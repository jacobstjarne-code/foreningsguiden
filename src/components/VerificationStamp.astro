---
// VerificationStamp — "läst-stämpeln" (designsystem/screenshots/stamp.png).
// Bär hela förtroendemekaniken (Jacob, prioriterad före övrig tokenmigrering).
// Oxblod (--fg-verify) är RESERVERAD för just detta — sprids inte till annan UI.
//
// HISTORIK, kort: stämpeln har haft tre lager av nivåer. Först GRANSKAD
// oavsett hur många fält som var verifierade (2026-08-03, felaktigt). Sedan
// tre nivåer fullt/delvis/ogranskat med 'olast' uteslutet ur granskat-
// kriteriet (ÅTGÄRDSSPEC T4). Sedan samma tre nivåer men med kravet att minst
// ett av bidragets EGNA fält var granskat (2026-10-02, efter att Lommas
// startbidrag visat DELVIS med noll egna granskade fält).
//
// Jacob 2026-10-02, slutligt: nivåerna är borta. Stämpeln säger bara vad som
// faktiskt hänt — att vi läst kommunens sida, och när. FULLT och DELVIS
// KONTROLLÄST var två ord för en gradskillnad läsaren inte kan använda, och
// "KONTROLLÄST" påstod mer än "läst". Villkoret är oförändrat: minst ett av
// bidragets tre egna fält ska vara kontrollast eller ingen_regel, annars
// ingen stämpel alls. En "OGRANSKAT"-etikett hade bara varit ännu ett
// påstående om ett tomrum, samma fälla VoidMark finns för att undvika.
//
// kalla_borttagen: BidragDjup renderar inte komponenten alls då — en
// läst-stämpel på ett bidrag vars regeldokument är borta är en motsägelse.
import { formatDate, harLastFalt } from '../lib/kommuner';
import { OLAST_MARK } from '../lib/content';
import type { Bidrag } from '../lib/kommuner';

export interface Props {
  bidrag: Bidrag;
  verifierad: string; // ISO-datum, kommunens (fallback när bidraget saknar eget senast_verifierad)
}

const { bidrag, verifierad } = Astro.props;
const visa = harLastFalt(bidrag);
const datum = formatDate(bidrag.senast_verifierad ?? verifierad);
---
{visa && (
  <span class="fg-stamp">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="20 6 9 17 4 12" />
    </svg>
    {OLAST_MARK.radMedDatum.replace('{datum}', datum).replace(/\.$/, '')}
  </span>
)}
