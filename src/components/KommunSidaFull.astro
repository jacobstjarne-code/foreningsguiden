---
// Kommunsidans FULLA rendering (§5 punkt 2 UPPDRAG_POC.md) — utbruten ur
// pages/kommun/[slug]/index.astro (H4, SPEC_ATERSTAENDE_HAL.md Kluster 4)
// så routen kan grena tidigt mellan denna (kommun med datafil) och
// KommunLandningsSida.astro (giltig men ännu otäckt kommun) utan att
// blanda ihop två olika Kommun-typer (Kommun vs Kommun | null) i samma
// frontmatter. Logiken här är OFÖRÄNDRAD mot före utbrytningen — bara
// flyttad, `kommun`-propen är nu required i stället för hämtad via
// getStaticPaths.
import Base from '../layouts/Base.astro';
import BidragCard from './BidragCard.astro';
import StaleWarning from './StaleWarning.astro';
import OmverifieringsVarning from './OmverifieringsVarning.astro';
import TackningsVarning from './TackningsVarning.astro';
import BreadcrumbList from './BreadcrumbList.astro';
import VerificationRow from './VerificationRow.astro';
import KommunProgression from './KommunProgression.astro';
import GiltighetsKontroll from './GiltighetsKontroll.astro';
import {
  isStale, formatDate, formatRecurringDate, svenskLista,
  earliestDeadlineISO, todayISO, beloppTackning,
  KATEGORI_LABELS, KATEGORIER, bidragAnsokningsUrl, relativFrist, hittaGiltighetsstatus,
} from '../lib/kommuner';
import type { Kommun, Kategori } from '../lib/kommuner';
import { KOMMUN, KOMMUNSIFFRA, EKERN, OLAST_MARK } from '../lib/content';

export interface Props {
  kommun: Kommun;
}

const { kommun } = Astro.props;
const today = todayISO();

const kategorierMedBidrag = KATEGORIER.filter((k: Kategori) =>
  kommun.bidrag.some((b) => b.kategori.includes(k))
);

// H24 — kommunen har inte publicerat belopp för NÅGOT av sina bidrag.
const tackning = beloppTackning(kommun);
const visaTackningsvarning = tackning.medBelopp === 0 && tackning.utanBelopp > 0;

// Samma sortering (tidigast deadline först, löpande sist) som
// KommunProgression station 4, så ankarlänkarna dit landar i rätt ordning.
const sortedBidrag = [...kommun.bidrag].sort((a, b) => {
  const da = earliestDeadlineISO(a, today);
  const db = earliestDeadlineISO(b, today);
  if (da && db) return da.localeCompare(db);
  if (da) return -1;
  if (db) return 1;
  return 0;
});

const metaTitle = KOMMUN.metaTitleTemplate.replace(/{kommun}/g, kommun.kommun);
const metaDescription = KOMMUN.metaDescriptionTemplate.replace(/{kommun}/g, kommun.kommun);
const h1 = KOMMUN.h1Template.replace(/{kommun}/g, kommun.kommun);
const intro = KOMMUN.introTemplate.replace(/{kommun}/g, kommun.kommun);
const ansokningstext = KOMMUN.ansokningssystemTemplate
  .replace(/{kommun}/g, kommun.kommun)
  .replace(/{system}/g, kommun.ansokningssystem.namn);

// --- Svar-först-block (SOKBARHETSSPEC §3.1) — variant beroende på datat ---
const fastaDeadlines = kommun.bidrag.flatMap((b) => (b.deadlines.typ === 'fasta' ? b.deadlines.datum : []));
const kategorierText = svenskLista(kategorierMedBidrag.map((k) => KATEGORI_LABELS[k].toLowerCase()));

// TILLSTANDET_OLAST.md 4c, yta 1 (Jacob 2026-08-03 kväll): Arvika-
// motsägelsen var precis det här — ekern påstod ett datumintervall med
// full säkerhet, kortet hedgade samma datum. svarForstMedDeadlines
// (nedan) är den enda av de tre varianterna som faktiskt påstår ett
// datum (tidigaste/senaste) — markeras bara när minst en av de bidrag
// som bidrar till intervallet har deadline_status: olast.
const fastaDeadlineBidrag = kommun.bidrag.filter((b) => b.deadlines.typ === 'fasta');

let svarForst = '';
// Bara svarForstMedDeadlines faktiskt påstår ett datum — de andra två
// varianterna (ett bidrag, löpande) nämner aldrig ett tidigaste/senaste
// datum, så olast-markören ska bara kunna visas där.
let svarForstOlast = false;
if (kommun.bidrag.length === 1) {
  svarForst = KOMMUN.svarForstEtt
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{bidragsnamn}/g, kommun.bidrag[0].namn)
    .replace(/{system}/g, kommun.ansokningssystem.namn);
} else if (kommun.bidrag.length > 1 && fastaDeadlines.length === 0) {
  svarForst = KOMMUN.svarForstLopande
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{antal}/g, String(kommun.bidrag.length))
    .replace(/{kategorier}/g, kategorierText)
    .replace(/{system}/g, kommun.ansokningssystem.namn);
} else if (kommun.bidrag.length > 1) {
  const sorted = [...fastaDeadlines].sort();
  svarForst = KOMMUN.svarForstMedDeadlines
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{antal}/g, String(kommun.bidrag.length))
    .replace(/{kategorier}/g, kategorierText)
    .replace(/{tidigaste}/g, formatRecurringDate(sorted[0]))
    .replace(/{senaste}/g, formatRecurringDate(sorted[sorted.length - 1]))
    .replace(/{system}/g, kommun.ansokningssystem.namn);
  svarForstOlast = fastaDeadlineBidrag.some((b) => b.deadline_status === 'olast');
}

// --- FAQ (SOKBARHETSSPEC §3.3) — synlig sektion MÅSTE spegla schemat exakt ---
// 'okand'-bidrag utelämnas ur datumsvaret helt (samma uteslutning som
// deadlinekalendern, getDeadlineEntries) — ett okänt datum är inget vi kan
// svara på, och att formatera b.deadlines.datum (tom array) hade gett en
// trasig mening ("söks senast .").
//
// Uppföljning 2026-08-03 (arbetsorder, punkt 1 — statusstyrd rendering
// överallt): samma tomma-array-bugg fanns latent för deadlines.typ ===
// 'relativ' (tillagd samma dag) — datum: [] där också, men filtret
// släppte igenom typen eftersom det bara uteslöt 'okand'. relativFrist()
// ger formeln (samma text som RelativeDeadline-kortet), inte ett datum.
//
// D3 (ÅTGÄRDSSPEC, samma kväll): filtret läser nu deadline_status
// (statusfältet), inte deadlines.typ direkt — 'ingen_regel' är ett annat
// besked än 'okand' (bekräftad frånvaro av frist, inte ett hål i vår
// kunskap) och ska INTE uteslutas tyst. typ styr fortfarande FORMATET
// (fasta/lopande/relativ), status styr OM raden alls tas med.
const deadlinesammanfattning = kommun.bidrag
  .filter((b) => b.deadline_status !== 'okand')
  .map((b) => {
    if (b.deadline_status === 'ingen_regel') return `${b.namn} har ingen fast ansökningsfrist.`;
    if (b.deadlines.typ === 'lopande') return `${b.namn} söks löpande.`;
    if (b.deadlines.typ === 'relativ') {
      const frist = relativFrist(b);
      return frist ? `${b.namn} söks senast ${frist}` : `${b.namn} har en relativ ansökningsfrist.`;
    }
    return `${b.namn} söks senast ${b.deadlines.datum.map(formatRecurringDate).join(', ')}.`;
  })
  .join(' ');

const faqRubrik = KOMMUN.faqRubrik.replace(/{kommun}/g, kommun.kommun);
// TILLSTANDET_OLAST.md 4c, yta 5 (Jacob 2026-08-03 kväll, punkt 2 —
// "mest lästa texten och hela SEO-ytan"): FAQ-svaret är ren text (delas
// med JSON-LD:s acceptedAnswer.text, som INTE tillåter HTML) — markören
// kan alltså inte sättas INUTI meningen. Renderas i stället som en egen
// rad efter svaret, bara på deadline-frågan (identifierad genom att dess
// ORIGINALMALL innehåller {deadlinesammanfattning}), bara när minst ett
// bidrag bakom sammanfattningen har deadline_status: olast.
const deadlinesammanfattningHarOlast = kommun.bidrag.some((b) => b.deadline_status === 'olast');
const faqEntries = kommun.bidrag.length === 0 ? [] : KOMMUN.faq.map(({ fraga, svar }) => ({
  fraga: fraga.replace(/{kommun}/g, kommun.kommun),
  svar: svar
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{antal}/g, String(kommun.bidrag.length))
    .replace(/{system}/g, kommun.ansokningssystem.namn)
    .replace(/{forvaltning}/g, kommun.forvaltning)
    .replace(/{bidragslista}/g, svenskLista(kommun.bidrag.map((b) => b.namn)))
    .replace(/{deadlinesammanfattning}/g, deadlinesammanfattning),
  arDeadlineFraga: svar.includes('{deadlinesammanfattning}'),
}));

const faqJsonLd = faqEntries.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(({ fraga, svar }) => ({
    '@type': 'Question',
    name: fraga,
    acceptedAnswer: { '@type': 'Answer', text: svar },
  })),
} : null;

// --- Kommunsiffran (SPRINT_COPY.ts §KOMMUNSIFFRA) — bara där datat finns ---
const kommunsiffraText = kommun.kommunsiffra
  ? KOMMUNSIFFRA.template
      .replace(/{antalForeningar}/g, String(kommun.kommunsiffra.antal_foreningar))
      .replace(/{kommun}/g, kommun.kommun)
      .replace(/{summa}/g, kommun.kommunsiffra.summa_kr)
      .replace(/{bidragstyp}/g, kommun.kommunsiffra.bidragstyp)
  : null;
const kommunsiffraKalla = kommun.kommunsiffra
  ? KOMMUNSIFFRA.kalla.replace(/{utlamnadDatum}/g, kommun.kommunsiffra.utlamnad_datum)
  : null;

// T4 (ÅTGÄRDSSPEC 2026-08-03 kväll): kommun-nivå, samma värde för varje
// bidrag på sidan — beräknas en gång, inte per BidragCard.
const giltighetStatus = hittaGiltighetsstatus(kommun.forutsattningar);

// dateModified ur verifierad (SOKBARHETSSPEC §4.5) — färskhetssignal.
const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: h1,
  dateModified: kommun.verifierad,
};
---
<Base title={metaTitle} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
  <BreadcrumbList items={[
    { name: 'Startsida', url: '/' },
    { name: kommun.kommun, url: `/kommun/${kommun.kommun_slug}/` },
  ]} />

  <div class="kommun-header">
    <h1>{h1}</h1>
    <p class="kommun-header__meta">
      {kommun.lan} · {kommun.forvaltning} · Källan läst {formatDate(kommun.verifierad)}
    </p>
  </div>

  <p class="bevakning-antal" data-bevakning-antal data-kommun-slug={kommun.kommun_slug} data-kommun-namn={kommun.kommun} hidden></p>

  {isStale(kommun.verifierad) && <StaleWarning verifierad={kommun.verifierad} />}
  <OmverifieringsVarning kommunSlug={kommun.kommun_slug} kommunNamn={kommun.kommun} />

  <VerificationRow kommun={kommun.kommun} verifierad={kommun.verifierad} kallaUrl={kommun.kalla_url} />

  {kommunsiffraText && (
    <p class="kommunsiffra">
      {kommunsiffraText} <span class="kommunsiffra__kalla">{kommunsiffraKalla}</span>
    </p>
  )}

  <p>{intro}</p>

  {/* 1a — SPEC_HUVUDPROCESSEN (Opus/Fable 2026-08-01), MOCKAR_huvudprocessen.md
     §1a: "kommunsidans ekern in i tratten". Ersätter den tidigare enkla
     kommun-till-tratt-länken (2026-07-31) med det fulla trebandskortet.
     Band 1 äger nu svar-först-texten (flyttad hit ur den gamla fristående
     <p class="svar-forst">, inte duplicerad) + ett eget färskhetsdatum
     (G2 — samma kommun.verifierad som VerificationRow ovan, en källa).
     Band 2 är trattinbjudan, band 3 sekundära vägar (in-page-ankare till
     #alla-bidrag / #sista-ansokningsdatum, tillagda på respektive
     sektion). Datarättelserna G10/G11 (förkravet är inte ett andra
     bidrag) kräver ingen ny kod här — svarForstEtt-mallen och den
     tidigare Gislaved-datastädningen (2026-07-31) redan strukturellt
     korrekta: bara kommun.bidrag[] (aldrig forutsattningar[]) räknas. */}
  {svarForst && (
    <div class="ekern">
      <div class="ekern__band ekern__band--1">
        <p class="ekern__svar-forst">{svarForst}</p>
        {/* TILLSTANDET_OLAST.md 4c, yta 1 (Jacob 2026-08-03 kväll):
           Arvika-motsägelsen — ekern påstod ett datumintervall med full
           säkerhet, kortet hedgade samma datum. Markören + samma
           OLAST_MARK-text som kortets banderoll, ingen ny prosa. */}
        {svarForstOlast && (
          <p class="ekern__olast">
            <span class="fg-void-mark fg-void-mark--inline" aria-hidden="true"></span>
            {OLAST_MARK.rad}
          </p>
        )}
        <p class="ekern__verifierad">
          <span class="ekern__verifierad-dot" aria-hidden="true"></span>
          {EKERN.verifieradPrefix} {formatDate(kommun.verifierad).toUpperCase()}
        </p>
      </div>
      <div class="ekern__band ekern__band--2">
        <p class="ekern__eyebrow">{EKERN.band2Eyebrow}</p>
        <p class="ekern__band2-rubrik">{EKERN.band2Rubrik}</p>
        <p class="ekern__band2-text">{EKERN.band2Text}</p>
        <a href={`/matcha/?fortsatt=${encodeURIComponent(JSON.stringify({ kommunSlug: kommun.kommun_slug }))}`} class="btn-primary ekern__cta">
          {EKERN.band2Cta} →
        </a>
        <p class="ekern__cta-underrad">{EKERN.band2CtaUnderrad}</p>
      </div>
      <div class="ekern__band ekern__band--3">
        <p class="ekern__eyebrow">{EKERN.band3Eyebrow}</p>
        <a href="#alla-bidrag" class="ekern__sekundar-lank">{EKERN.band3Lank1.replace('{kommun}', kommun.kommun)} ↓</a>
        <a href="#sista-ansokningsdatum" class="ekern__sekundar-lank">{EKERN.band3Lank2} ↓</a>
      </div>
    </div>
  )}

  {kommun.bidrag.length === 0 ? (
    <p>{KOMMUN.ingaBidrag}</p>
  ) : (
    <>
      <KommunProgression kommun={kommun} today={today} />
      <GiltighetsKontroll kommun={kommun} today={today} />
    </>
  )}

  <section>
    <h2>{KOMMUN.ansokningssystemRubrik}</h2>
    <p>
      {ansokningstext}{' '}
      <a href={kommun.ansokningssystem.url}>{kommun.ansokningssystem.url}</a>
    </p>
  </section>

  {kommun.bidrag.length > 0 && (
    <section id="alla-bidrag">
      <h2>Alla bidrag i {kommun.kommun}, i detalj</h2>
      {visaTackningsvarning && <TackningsVarning kommun={kommun.kommun} />}
      <ul class="bidrag-list">
        {sortedBidrag.map((bidrag) => (
          <BidragCard bidrag={bidrag} verifierad={kommun.verifierad} ansokningsUrl={bidragAnsokningsUrl(bidrag, kommun)} kommunSlug={kommun.kommun_slug} kommunNamn={kommun.kommun} giltighetStatus={giltighetStatus} />
        ))}
      </ul>
    </section>
  )}

  {faqEntries.length > 0 && (
    <section>
      <h2>{faqRubrik}</h2>
      {/* R5.1(d) (OMFORDELA_TEXTMASSAN.md runda 5): "fråga som synlig
         rad, svar fällt" — samma disclosure som stationerna. dl/dt/dd
         bytt mot details/summary per fråga (JSON-LD nedan läser
         fortfarande samma faqEntries-array, oberoende av vilken
         markup som visar dem — svar-strängen är orörd, ren text). */}
      <div class="faq-list">
        {faqEntries.map(({ fraga, svar, arDeadlineFraga }) => (
          <details class="faq-item">
            <summary class="progression__slutsats faq-item__fraga">
              <span class="progression__slutsats-text">{fraga}</span>
              <svg class="progression__slutsats-chevron" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            </summary>
            <div class="progression__fallbart faq-item__svar">
              {svar}
              {arDeadlineFraga && deadlinesammanfattningHarOlast && (
                <p class="faq-list__olast">
                  <span class="fg-void-mark fg-void-mark--inline" aria-hidden="true"></span>
                  {OLAST_MARK.rad}
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>
  )}
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
</Base>

<script>
  import { hamtaBevakningsantal, BEVAKNING_GOLV } from '../lib/bevakningKlient';
  import { VANTELISTA } from '../lib/content';
  import { initFelrapportWidgets } from '../lib/felrapportKlient';

  const el = document.querySelector<HTMLElement>('[data-bevakning-antal]');
  const slug = el?.dataset.kommunSlug;
  const namn = el?.dataset.kommunNamn ?? '';
  if (el && slug) {
    hamtaBevakningsantal(slug).then((antal) => {
      if (antal !== null && antal >= BEVAKNING_GOLV) {
        el.textContent = VANTELISTA.socialProof.replace('{antal}', String(antal)).replace(/{kommun}/g, namn);
        el.hidden = false;
      }
    });
  }

  initFelrapportWidgets();
</script>

<style>
  /* 1a — ekern (MOCKAR_huvudprocessen.md §1a). Exakta mått ur mocken,
     inte avrundade mot närmaste befintliga token där de skiljer sig
     (17px/19px/15px/11px har inga exakta motsvarigheter i skalan). */
  .ekern {
    background: var(--fg-surface);
    border: var(--fg-border-structural) solid var(--fg-ink);
    border-radius: 10px;
    margin: var(--fg-space-6) 0 var(--fg-space-7);
    overflow: hidden;
  }

  .ekern__band {
    padding: var(--fg-card-padding);
    border-top: var(--fg-border-inner) dashed var(--fg-border);
  }

  .ekern__band--1 {
    border-top: none;
  }

  .ekern__band--2 {
    background: var(--fg-surface-sunken);
  }

  .ekern__svar-forst {
    font-size: 17px;
    line-height: 1.55;
    margin: 0 0 var(--fg-space-4);
  }

  .ekern__olast {
    display: flex;
    align-items: baseline;
    gap: var(--fg-space-2);
    font-size: var(--fg-text-label);
    color: var(--fg-void-ink);
    margin: var(--fg-space-2) 0 0;
  }

  .ekern__verifierad {
    display: flex;
    align-items: center;
    gap: var(--fg-space-2);
    font-family: var(--fg-font-mono);
    font-size: 12px;
    letter-spacing: var(--fg-tracking-label);
    color: var(--fg-ink-muted);
    margin: 0;
  }

  .ekern__verifierad-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--fg-accent);
    flex-shrink: 0;
  }

  .ekern__eyebrow {
    font-family: var(--fg-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--fg-tracking-label);
    color: var(--fg-ink-muted);
    margin: 0 0 var(--fg-space-2);
  }

  .ekern__band2-rubrik {
    font-size: 19px;
    font-weight: var(--fg-weight-bold);
    margin: 0 0 var(--fg-space-2);
  }

  .ekern__band2-text {
    font-size: 15px;
    color: var(--fg-ink-muted);
    margin: 0 0 var(--fg-space-5);
  }

  .ekern__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    font-size: var(--fg-text-body-lg);
  }

  .ekern__cta-underrad {
    font-size: var(--fg-text-label);
    color: var(--fg-ink-muted);
    text-align: center;
    margin: var(--fg-space-3) 0 0;
  }

  .ekern__band--3 {
    display: flex;
    flex-direction: column;
    gap: var(--fg-space-3);
  }

  .ekern__sekundar-lank {
    font-size: var(--fg-text-body);
    color: var(--fg-accent);
    font-weight: var(--fg-weight-bold);
  }
</style>
