---
// Kommunsidans FULLA rendering (§5 punkt 2 UPPDRAG_POC.md) — utbruten ur
// pages/kommun/[slug]/index.astro (H4, SPEC_ATERSTAENDE_HAL.md Kluster 4)
// så routen kan grena tidigt mellan denna (kommun med datafil) och
// KommunLandningsSida.astro (giltig men ännu otäckt kommun) utan att
// blanda ihop två olika Kommun-typer (Kommun vs Kommun | null) i samma
// frontmatter. Logiken här är OFÖRÄNDRAD mot före utbrytningen — bara
// flyttad, `kommun`-propen är nu required i stället för hämtad via
// getStaticPaths.
import Base from '../layouts/Base.astro';
import BidragRegisterRad from './BidragRegisterRad.astro';
import VarmSkarm from './VarmSkarm.astro';
import StaleWarning from './StaleWarning.astro';
import OmverifieringsVarning from './OmverifieringsVarning.astro';
import TackningsVarning from './TackningsVarning.astro';
import BreadcrumbList from './BreadcrumbList.astro';
import VerificationRow from './VerificationRow.astro';
import KommunProgression from './KommunProgression.astro';
import IgenkanningsRad from './IgenkanningsRad.astro';
import {
  isStale, formatDate, formatRecurringDate, svenskLista,
  earliestDeadlineISO, todayISO, beloppTackning,
  KATEGORI_LABELS, KATEGORIER, relativFrist,
} from '../lib/kommuner';
import type { Kommun, Kategori } from '../lib/kommuner';
import { KOMMUN, KOMMUNSIFFRA, EKERN, OLAST_MARK } from '../lib/content';
import { trappa } from '../lib/arlighetstrappa';

export interface Props {
  kommun: Kommun;
}

const { kommun } = Astro.props;
const today = todayISO();

const kategorierMedBidrag = KATEGORIER.filter((k: Kategori) =>
  kommun.bidrag.some((b) => b.kategori.includes(k))
);

// H24 — kommunen har inte publicerat belopp för NÅGOT av sina bidrag.
const tackning = beloppTackning(kommun);
const visaTackningsvarning = tackning.medBelopp === 0 && tackning.utanBelopp > 0;

// Samma sortering (tidigast deadline först, löpande sist) som
// KommunProgression station 4, så ankarlänkarna dit landar i rätt ordning.
const sortedBidrag = [...kommun.bidrag].sort((a, b) => {
  const da = earliestDeadlineISO(a, today);
  const db = earliestDeadlineISO(b, today);
  if (da && db) return da.localeCompare(db);
  if (da) return -1;
  if (db) return 1;
  return 0;
});

// B1 (ARBETSORDER 2026-08-11) — "två bidrag med belopp och datum".
// Ärlighetstrappan: påståendet kräver BÅDA fälten, aldrig ett gissat
// belopp för att fylla ut listan. Faller ett steg (bara datum) om
// färre än två bidrag har både, och till botten (ingen förhandsvisning
// alls) om färre än två har ens ett datum — se trappa() i
// arlighetstrappa.ts, samma mönster som F①/F②/F③ senare i ordern.
const bidragMedBeloppOchDatum = sortedBidrag.filter(
  (b) => b.belopp !== null && earliestDeadlineISO(b, today) !== null
);
const bidragMedBaraDatum = sortedBidrag.filter((b) => earliestDeadlineISO(b, today) !== null);

const forhandsvisningBidrag = trappa([
  { villkor: bidragMedBeloppOchDatum.length >= 2, varde: { bidrag: bidragMedBeloppOchDatum.slice(0, 2), visaBelopp: true } },
  { villkor: bidragMedBaraDatum.length >= 2, varde: { bidrag: bidragMedBaraDatum.slice(0, 2), visaBelopp: false } },
  { villkor: true, varde: { bidrag: [] as typeof sortedBidrag, visaBelopp: false } },
]);

const metaTitle = KOMMUN.metaTitleTemplate.replace(/{kommun}/g, kommun.kommun);
const metaDescription = KOMMUN.metaDescriptionTemplate.replace(/{kommun}/g, kommun.kommun);
const h1 = KOMMUN.h1Template.replace(/{kommun}/g, kommun.kommun);
const intro = KOMMUN.introTemplate.replace(/{kommun}/g, kommun.kommun);

// --- Svar-först-block (SOKBARHETSSPEC §3.1) — variant beroende på datat ---
const fastaDeadlines = kommun.bidrag.flatMap((b) => (b.deadlines.typ === 'fasta' ? b.deadlines.datum : []));
const kategorierText = svenskLista(kategorierMedBidrag.map((k) => KATEGORI_LABELS[k].toLowerCase()));

// TILLSTANDET_OLAST.md 4c, yta 1 (Jacob 2026-08-03 kväll): Arvika-
// motsägelsen var precis det här — ekern påstod ett datumintervall med
// full säkerhet, kortet hedgade samma datum. svarForstMedDeadlines
// (nedan) är den enda av de tre varianterna som faktiskt påstår ett
// datum (tidigaste/senaste) — markeras bara när minst en av de bidrag
// som bidrar till intervallet har deadline_status: olast.
const fastaDeadlineBidrag = kommun.bidrag.filter((b) => b.deadlines.typ === 'fasta');

let svarForst = '';
// Bara svarForstMedDeadlines faktiskt påstår ett datum — de andra två
// varianterna (ett bidrag, löpande) nämner aldrig ett tidigaste/senaste
// datum, så olast-markören ska bara kunna visas där.
let svarForstOlast = false;
if (kommun.bidrag.length === 1) {
  svarForst = KOMMUN.svarForstEtt
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{bidragsnamn}/g, kommun.bidrag[0].namn)
    .replace(/{system}/g, kommun.ansokningssystem.namn);
} else if (kommun.bidrag.length > 1 && fastaDeadlines.length === 0) {
  svarForst = KOMMUN.svarForstLopande
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{antal}/g, String(kommun.bidrag.length))
    .replace(/{kategorier}/g, kategorierText)
    .replace(/{system}/g, kommun.ansokningssystem.namn);
} else if (kommun.bidrag.length > 1) {
  const sorted = [...fastaDeadlines].sort();
  svarForst = KOMMUN.svarForstMedDeadlines
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{antal}/g, String(kommun.bidrag.length))
    .replace(/{kategorier}/g, kategorierText)
    .replace(/{tidigaste}/g, formatRecurringDate(sorted[0]))
    .replace(/{senaste}/g, formatRecurringDate(sorted[sorted.length - 1]))
    .replace(/{system}/g, kommun.ansokningssystem.namn);
  svarForstOlast = fastaDeadlineBidrag.some((b) => b.deadline_status === 'olast');
}

// --- FAQ (SOKBARHETSSPEC §3.3) — synlig sektion MÅSTE spegla schemat exakt ---
// 'okand'-bidrag utelämnas ur datumsvaret helt (samma uteslutning som
// deadlinekalendern, getDeadlineEntries) — ett okänt datum är inget vi kan
// svara på, och att formatera b.deadlines.datum (tom array) hade gett en
// trasig mening ("söks senast .").
//
// Uppföljning 2026-08-03 (arbetsorder, punkt 1 — statusstyrd rendering
// överallt): samma tomma-array-bugg fanns latent för deadlines.typ ===
// 'relativ' (tillagd samma dag) — datum: [] där också, men filtret
// släppte igenom typen eftersom det bara uteslöt 'okand'. relativFrist()
// ger formeln (samma text som RelativeDeadline-kortet), inte ett datum.
//
// D3 (ÅTGÄRDSSPEC, samma kväll): filtret läser nu deadline_status
// (statusfältet), inte deadlines.typ direkt — 'ingen_regel' är ett annat
// besked än 'okand' (bekräftad frånvaro av frist, inte ett hål i vår
// kunskap) och ska INTE uteslutas tyst. typ styr fortfarande FORMATET
// (fasta/lopande/relativ), status styr OM raden alls tas med.
const deadlinesammanfattning = kommun.bidrag
  .filter((b) => b.deadline_status !== 'okand')
  .map((b) => {
    if (b.deadline_status === 'ingen_regel') return `${b.namn} har ingen fast ansökningsfrist.`;
    if (b.deadlines.typ === 'lopande') return `${b.namn} söks löpande.`;
    if (b.deadlines.typ === 'relativ') {
      const frist = relativFrist(b);
      return frist ? `${b.namn} söks senast ${frist}` : `${b.namn} har en relativ ansökningsfrist.`;
    }
    return `${b.namn} söks senast ${b.deadlines.datum.map(formatRecurringDate).join(', ')}.`;
  })
  .join(' ');

const faqRubrik = KOMMUN.faqRubrik.replace(/{kommun}/g, kommun.kommun);
// TILLSTANDET_OLAST.md 4c, yta 5 (Jacob 2026-08-03 kväll, punkt 2 —
// "mest lästa texten och hela SEO-ytan"): FAQ-svaret är ren text (delas
// med JSON-LD:s acceptedAnswer.text, som INTE tillåter HTML) — markören
// kan alltså inte sättas INUTI meningen. Renderas i stället som en egen
// rad efter svaret, bara på deadline-frågan (identifierad genom att dess
// ORIGINALMALL innehåller {deadlinesammanfattning}), bara när minst ett
// bidrag bakom sammanfattningen har deadline_status: olast.
const deadlinesammanfattningHarOlast = kommun.bidrag.some((b) => b.deadline_status === 'olast');
// A6.3 (2026-08-11): faq[0].svar har en singularvariant (KOMMUN.faqSvarEtt)
// för "kommunen har exakt ett bidrag" — bytt in FÖRE samma .map()-
// ersättningskedja körs, så {kommun}/{bidragslista}/{forvaltning} fylls
// i likadant oavsett vilken mall det gäller.
const faqMallar = kommun.bidrag.length === 1
  ? [{ ...KOMMUN.faq[0], svar: KOMMUN.faqSvarEtt }, ...KOMMUN.faq.slice(1)]
  : KOMMUN.faq;
const faqEntries = kommun.bidrag.length === 0 ? [] : faqMallar.map(({ fraga, svar }) => ({
  fraga: fraga.replace(/{kommun}/g, kommun.kommun),
  svar: svar
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{antal}/g, String(kommun.bidrag.length))
    .replace(/{system}/g, kommun.ansokningssystem.namn)
    .replace(/{forvaltning}/g, kommun.forvaltning)
    .replace(/{bidragslista}/g, svenskLista(kommun.bidrag.map((b) => b.namn)))
    .replace(/{deadlinesammanfattning}/g, deadlinesammanfattning),
  arDeadlineFraga: svar.includes('{deadlinesammanfattning}'),
}));

const faqJsonLd = faqEntries.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(({ fraga, svar }) => ({
    '@type': 'Question',
    name: fraga,
    acceptedAnswer: { '@type': 'Answer', text: svar },
  })),
} : null;

// --- Kommunsiffran (SPRINT_COPY.ts §KOMMUNSIFFRA) — bara där datat finns ---
const kommunsiffraText = kommun.kommunsiffra
  ? KOMMUNSIFFRA.template
      .replace(/{antalForeningar}/g, String(kommun.kommunsiffra.antal_foreningar))
      .replace(/{kommun}/g, kommun.kommun)
      .replace(/{summa}/g, kommun.kommunsiffra.summa_kr)
      .replace(/{bidragstyp}/g, kommun.kommunsiffra.bidragstyp)
  : null;
const kommunsiffraKalla = kommun.kommunsiffra
  ? KOMMUNSIFFRA.kalla.replace(/{utlamnadDatum}/g, kommun.kommunsiffra.utlamnad_datum)
  : null;

// dateModified ur verifierad (SOKBARHETSSPEC §4.5) — färskhetssignal.
const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: h1,
  dateModified: kommun.verifierad,
};
---
<Base title={metaTitle} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
  <BreadcrumbList items={[
    { name: 'Startsida', url: '/' },
    { name: kommun.kommun, url: `/kommun/${kommun.kommun_slug}/` },
  ]} />

  {/* B1 (ARBETSORDER 2026-08-11, Kalla besökaren, runda 13) — första
     skärmen: avsändaren först, frågan ur URL:en, arbetet som värme, två
     bidrag, sedan matchningen som inbjudan (band 2 nedan, B2). */}
  <div class="kommun-header">
    <p class="kommun-header__avsandare">{EKERN.avsandare}</p>
    <h1>{h1}</h1>
    <p class="kommun-header__sokt-fraga fg-lasbredd">{EKERN.soktFraga.replace('{kommun}', kommun.kommun)}</p>
    <p class="kommun-header__meta">
      {kommun.lan} · {kommun.forvaltning} · Källan läst {formatDate(kommun.verifierad)}
    </p>
  </div>

  <p class="bevakning-antal" data-bevakning-antal data-kommun-slug={kommun.kommun_slug} data-kommun-namn={kommun.kommun} hidden></p>

  {isStale(kommun.verifierad) && <StaleWarning verifierad={kommun.verifierad} />}
  <OmverifieringsVarning kommunSlug={kommun.kommun_slug} kommunNamn={kommun.kommun} />

  <VerificationRow kommun={kommun.kommun} verifierad={kommun.verifierad} kallaUrl={kommun.kalla_url} />

  {kommunsiffraText && (
    <p class="kommunsiffra">
      {kommunsiffraText} <span class="kommunsiffra__kalla">{kommunsiffraKalla}</span>
    </p>
  )}

  {/* D2.2 (2026-08-12, Jacob) — svar-först slås ihop till EN yta.
     kommun-varme (egen "vi har läst X åt er"-rad) och den fristående
     intro-paragrafen TAGNA BORT som egna block — inget innehåll
     förloras, båda rollerna täcks redan av svarForst/VARM_SKARM.intro
     (samma "vi har läst allt åt er"-besked, en gång, inte tre).
     kommun-forhandsvisning (den fristående tvåradslistan) flyttad IN i
     ekerns band 1 nedan i stället för att stå som ett eget block före
     kortet — samma markup/klasser, bara ny plats. Talet {antal
     bidrag} stod tidigare i kommun-varme OCH svarForst/VARM_SKARM.intro
     (tre källor räknat båda ekern/VarmSkarm-varianterna som alltid
     SSR-renderas): nu bara i svarForst/VARM_SKARM.intro, en gång per
     variant.

     VarmSkarm rörs INTE — den har redan sin egen självständiga
     intro+bidragsförhandsvisning (VARM_SKARM.intro, forsta-korten) och
     behövde ingen dubblett tillagd. Bara ekern (nedan) fick
     kommun-forhandsvisning+intro flyttade in, för att bli lika
     självbärande som VarmSkarm redan var. */}
  {/* E1 (ARBETSORDER 2026-08-11, "den varma skärmen"): VarmSkarm ersätter
     ekern (nedan) klientsidan när Foreningsprofil.foreningsnamn är känt —
     SSR-renderad hidden, precis som ekern SSR-renderas visible. Ordningen
     (VarmSkarm före ekern i DOM) spelar ingen roll, bara en av dem är
     synlig åt gången (se <script> nedan). */}
  <VarmSkarm kommun={kommun} today={today} sortedBidrag={sortedBidrag} />

  {svarForst && (
    <div class="ekern" data-ekern-kall>
      <div class="ekern__band ekern__band--1">
        <p class="ekern__svar-forst fg-lasbredd">{svarForst}</p>
        {/* TILLSTANDET_OLAST.md 4c, yta 1 (Jacob 2026-08-03 kväll):
           Arvika-motsägelsen — ekern påstod ett datumintervall med full
           säkerhet, kortet hedgade samma datum. Markören + samma
           OLAST_MARK-text som kortets banderoll, ingen ny prosa. */}
        {svarForstOlast && (
          <p class="ekern__olast">
            <span class="fg-void-mark fg-void-mark--inline" aria-hidden="true"></span>
            {OLAST_MARK.rad}
          </p>
        )}
        {forhandsvisningBidrag.bidrag.length > 0 && (
          <ul class="kommun-forhandsvisning">
            {forhandsvisningBidrag.bidrag.map((bidrag) => {
              const dateISO = earliestDeadlineISO(bidrag, today);
              return (
                <li class="kommun-forhandsvisning__rad">
                  <span class="kommun-forhandsvisning__namn">{bidrag.namn}</span>
                  <span class="kommun-forhandsvisning__meta">
                    {forhandsvisningBidrag.visaBelopp && <span>{bidrag.belopp}</span>}
                    {dateISO && <span>{formatDate(dateISO)}</span>}
                  </span>
                </li>
              );
            })}
          </ul>
        )}
        <p class="ekern__verifierad">
          <span class="ekern__verifierad-dot" aria-hidden="true"></span>
          {EKERN.verifieradPrefix} {formatDate(kommun.verifierad).toUpperCase()}
        </p>
      </div>
      <div class="ekern__band ekern__band--2">
        <p class="ekern__eyebrow">{EKERN.band2Eyebrow}</p>
        <p class="ekern__band2-rubrik">{EKERN.band2Rubrik}</p>
        <p class="ekern__band2-text">{EKERN.band2Text}</p>
        {/* A5.2 (2026-08-11): sekundär — "Så blir ni godkända i {kommun}"
           (KommunProgression, station 3) är sidans ENDA färgade drag. */}
        <a href={`/matcha/?fortsatt=${encodeURIComponent(JSON.stringify({ kommunSlug: kommun.kommun_slug }))}`} class="fg-btn--ghost ekern__cta">
          {EKERN.band2Cta} →
        </a>
        <p class="ekern__cta-underrad">{EKERN.band2CtaUnderrad}</p>
      </div>
      {/* B3 — insats-nudgen (14a). EN per skärm, efter svaret (band 2)
         och före listan (band 3:s länkar in i den). */}
      <p class="ekern__nudge fg-lasbredd">{EKERN.insatsNudge}</p>
      <div class="ekern__band ekern__band--3">
        <p class="ekern__eyebrow">{EKERN.band3Eyebrow}</p>
        {/* D2.2 — den forna fristående intro-paragrafen (KOMMUN.introTemplate),
           oförändrad text, flyttad hit: den förklarar exakt det registret
           nedan länken går till (gruppering, länkar, senast avstämt). */}
        <p class="ekern__band3-intro fg-lasbredd">{intro}</p>
        <a href="#alla-bidrag" class="ekern__sekundar-lank">{EKERN.band3Lank1.replace('{kommun}', kommun.kommun)} ↓</a>
        <a href="#sista-ansokningsdatum" class="ekern__sekundar-lank">{EKERN.band3Lank2} ↓</a>
      </div>
    </div>
  )}

  {kommun.bidrag.length === 0 ? (
    <p>{KOMMUN.ingaBidrag}</p>
  ) : (
    <KommunProgression kommun={kommun} today={today} />
  )}

  {/* D2/D3 (ARBETSORDER 2026-08-11, mock 9g "BORT/FLYTT/KVAR"): "Så
     ansöker du"-sektionen BORT härifrån — dubblerade snart samma besked
     som varje bidrags egen "Till ansökan"-knapp. Samma text
     (KOMMUN.ansokningssystemRubrik/ansokningssystemTemplate, oförändrad)
     flyttad till S2 (bidragets egen sida) i stället, se
     kommun/[slug]/bidrag/[bidragId]/index.astro. */}

  {kommun.bidrag.length > 0 && (
    <section id="alla-bidrag">
      {/* D2 (2026-08-12, Jacob): rubriken "Alla bidrag i {kommun}, i
         detalj" TAGEN BORT — raderna länkar till bidragets egen D1-URL
         i stället för att visa hela innehållet inline (det var själva
         dubbletten ordern pekade ut), så "i detalj" är inte längre sant
         om den HÄR sidan. "Registret ÄR sidan": ingen ny rubrik i
         stället — sektionen behöver ingen egen announcing-rubrik utöver
         #alla-bidrag-ankaret som redan pekas ut från ekerns band 3
         (EKERN.band3Lank1, oförändrad — den länken är fortfarande sann,
         den leder till "alla bidrag", bara inte längre till en "i
         detalj"-vy). Ingenting raderas: full information finns kvar,
         bara på bidragets egen URL (D1), inte upprepad här. */}
      {visaTackningsvarning && <TackningsVarning kommun={kommun.kommun} />}
      <IgenkanningsRad kommunSlug={kommun.kommun_slug} />
      {/* R7.4 (EN_PROFIL_ALLA_YTOR.md, runda 7): grupperad vy, dold tills
         klientskriptet (nedan) vet att profilen har verksamhet — annars
         den ogrupperade fullständiga listan, precis som i dag. Sortera,
         aldrig filtrera: samma <li data-bidrag-id>-noder FLYTTAS mellan
         listorna, ingen dubblering, ingen bortfiltrerad post. */}
      <div data-bidrag-grupper hidden>
        <h3 class="bidrag-grupp-rubrik" data-grupp-rubrik-passar></h3>
        <ul class="bidrag-list" data-grupp-lista-passar></ul>
        <h3 class="bidrag-grupp-rubrik" data-grupp-rubrik-kangalla></h3>
        <ul class="bidrag-list" data-grupp-lista-kangalla></ul>
      </div>
      <ul class="bidrag-list" data-bidrag-list-flat>
        {sortedBidrag.map((bidrag) => (
          <BidragRegisterRad bidrag={bidrag} kommunSlug={kommun.kommun_slug} />
        ))}
      </ul>
    </section>
  )}

  {faqEntries.length > 0 && (
    <section>
      <h2>{faqRubrik}</h2>
      {/* R5.1(d) (OMFORDELA_TEXTMASSAN.md runda 5): "fråga som synlig
         rad, svar fällt" — samma disclosure som stationerna. dl/dt/dd
         bytt mot details/summary per fråga (JSON-LD nedan läser
         fortfarande samma faqEntries-array, oberoende av vilken
         markup som visar dem — svar-strängen är orörd, ren text). */}
      <div class="faq-list">
        {faqEntries.map(({ fraga, svar, arDeadlineFraga }) => (
          <details class="faq-item">
            <summary class="progression__slutsats faq-item__fraga">
              <span class="progression__slutsats-text">{fraga}</span>
              <svg class="progression__slutsats-chevron" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            </summary>
            <div class="progression__fallbart faq-item__svar fg-lasbredd">
              {svar}
              {arDeadlineFraga && deadlinesammanfattningHarOlast && (
                <p class="faq-list__olast">
                  <span class="fg-void-mark fg-void-mark--inline" aria-hidden="true"></span>
                  {OLAST_MARK.rad}
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>
  )}
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
</Base>

<script>
  import { hamtaBevakningsantal, BEVAKNING_GOLV } from '../lib/bevakningKlient';
  import { VANTELISTA, IGENKANNING } from '../lib/content';
  import { initFelrapportWidgets } from '../lib/felrapportKlient';
  import { getForeningsprofil, saveForeningsprofil } from '../lib/foreningsprofil';
  import { sorteraForTratt } from '../lib/matching';
  import { VERKSAMHET_FORENING_LABELS, type Kommun } from '../lib/kommunTyper';

  // E1 (ARBETSORDER 2026-08-11): VarmSkarm ersätter ekern när Foreningsprofil.
  // foreningsnamn är känt — annars gäller B (ekern) helt oförändrat, båda
  // SSR-renderade, bara synligheten byts här. Namnet fylls i samma steg.
  {
    const varmSkarm = document.querySelector<HTMLElement>('[data-varm-skarm]');
    const ekernKall = document.querySelector<HTMLElement>('[data-ekern-kall]');
    const foreningsnamn = getForeningsprofil()?.foreningsnamn;
    if (varmSkarm && foreningsnamn) {
      const namnEl = varmSkarm.querySelector<HTMLElement>('[data-varm-namn]');
      if (namnEl) namnEl.textContent = foreningsnamn;
      varmSkarm.removeAttribute('hidden');
      ekernKall?.setAttribute('hidden', '');
    }
  }

  const el = document.querySelector<HTMLElement>('[data-bevakning-antal]');
  const slug = el?.dataset.kommunSlug;
  const namn = el?.dataset.kommunNamn ?? '';
  if (el && slug) {
    hamtaBevakningsantal(slug).then((antal) => {
      if (antal !== null && antal >= BEVAKNING_GOLV) {
        el.textContent = VANTELISTA.socialProof.replace('{antal}', String(antal)).replace(/{kommun}/g, namn);
        el.hidden = false;
      }
    });
  }

  initFelrapportWidgets();

  // R5.8 (OMFORDELA_TEXTMASSAN.md, Jacob 2026-08-06): bidragskorten är
  // kollapsade <details id="bidrag-X">. Länkar hit (station 2/4:s
  // #bidrag-X-ankare) ska landa på ett ÖPPET kort, inte ett stängt —
  // öppnar fragmentmålet om det är en <details>, både vid första
  // sidladdning och vid ett senare klick (hashchange, samma-sidans-
  // navigering byter aldrig sida så bara load räcker inte). Innehållet
  // finns oförändrat i DOM:en utan detta — det här öppnar bara åt
  // besökaren i stället för att kräva ett extra klick efter hoppet.
  function oppnaFragmentmal() {
    if (!location.hash) return;
    const mal = document.querySelector(location.hash);
    if (mal instanceof HTMLDetailsElement) mal.open = true;
  }
  oppnaFragmentmal();
  window.addEventListener('hashchange', oppnaFragmentmal);

  // R7.2/R7.3/R7.4 (EN_PROFIL_ALLA_YTOR.md, runda 7) — igenkänningsraden
  // + listans gruppering. Läser ENDAST tratten (/matcha/) sparade profil.
  // R7.0 blockerar att station 1 skriver hit (vokabulären matchar inte
  // profil.verksamhet) — det ändrar inte det här, bara läser vad som
  // redan finns. Default (ingen profil, eller profil utan verksamhet):
  // F5-raden och den ogrupperade listan står redan synliga i markupen,
  // den här funktionen gör ingenting alls — "aldrig en tom vy".
  async function initIgenkanning() {
    const wrap = document.querySelector<HTMLElement>('[data-igenkanning]');
    const dennaKommunSlug = wrap?.dataset.igenkanningKommunSlug;
    if (!wrap || !dennaKommunSlug) return;

    const profil = getForeningsprofil();
    if (!profil || profil.verksamhet.length === 0) return;

    const matchRad = wrap.querySelector<HTMLElement>('[data-igenkanning-match]');
    const matchText = wrap.querySelector<HTMLElement>('[data-igenkanning-match-text]');
    const visaAllaKnapp = wrap.querySelector<HTMLButtonElement>('[data-igenkanning-visa-alla]');
    const felKommunRad = wrap.querySelector<HTMLElement>('[data-igenkanning-felkommun]');
    const felKommunText = wrap.querySelector<HTMLElement>('[data-igenkanning-felkommun-text]');
    const ordnaKnapp = wrap.querySelector<HTMLButtonElement>('[data-igenkanning-ordna]');
    const tillbakaLank = wrap.querySelector<HTMLAnchorElement>('[data-igenkanning-tillbaka]');
    const ingenRad = wrap.querySelector<HTMLElement>('[data-igenkanning-ingen]');

    const grupper = document.querySelector<HTMLElement>('[data-bidrag-grupper]');
    const listaFlat = document.querySelector<HTMLUListElement>('[data-bidrag-list-flat]');
    const listaPassar = document.querySelector<HTMLUListElement>('[data-grupp-lista-passar]');
    const listaKangalla = document.querySelector<HTMLUListElement>('[data-grupp-lista-kangalla]');
    const rubrikPassar = document.querySelector<HTMLElement>('[data-grupp-rubrik-passar]');
    const rubrikKangalla = document.querySelector<HTMLElement>('[data-grupp-rubrik-kangalla]');

    // Bara EXAKT en verksamhet med ett riktigt sammansatt ord får "en
    // {typ}"-formuleringen — annars den generiska raden (se IGENKANNING
    // i content.ts för varför: Design gav bara exemplet "idrottsförening").
    function mallMedTyp(mallTyp: string, mallGenerisk: string): string {
      if (profil!.verksamhet.length === 1) {
        const typ = VERKSAMHET_FORENING_LABELS[profil!.verksamhet[0]];
        if (typ) return mallTyp.replace('{typ}', typ);
      }
      return mallGenerisk;
    }

    function grupperaListan(kommunData: Kommun) {
      if (!listaFlat || !grupper || !listaPassar || !listaKangalla) return;
      const { passar, kanGalla } = sorteraForTratt(profil!, kommunData);
      const perId = new Map<string, HTMLLIElement>();
      listaFlat.querySelectorAll<HTMLLIElement>('[data-bidrag-id]').forEach((li) => {
        if (li.dataset.bidragId) perId.set(li.dataset.bidragId, li);
      });

      passar.forEach((b) => { const li = perId.get(b.id); if (li) listaPassar.appendChild(li); });
      kanGalla.forEach((b) => { const li = perId.get(b.id); if (li) listaKangalla.appendChild(li); });

      if (rubrikPassar) rubrikPassar.textContent = `Passar er verksamhet · ${passar.length}`;
      if (rubrikKangalla) rubrikKangalla.textContent = `Kan gälla er ändå · ${kanGalla.length}`;

      grupper.hidden = false;
      listaFlat.hidden = true;
    }

    function visaFlatIgen() {
      if (!listaFlat || !grupper || !listaPassar || !listaKangalla) return;
      [...listaPassar.querySelectorAll('[data-bidrag-id]'), ...listaKangalla.querySelectorAll('[data-bidrag-id]')]
        .forEach((li) => listaFlat.appendChild(li));
      grupper.hidden = true;
      listaFlat.hidden = false;
    }

    async function hamtaKommun(slug: string): Promise<Kommun | null> {
      try {
        const res = await fetch(`/kommun-data/${slug}.json`);
        if (!res.ok) return null;
        return (await res.json()) as Kommun;
      } catch {
        return null;
      }
    }

    const dennaKommun = await hamtaKommun(dennaKommunSlug);
    if (!dennaKommun) return; // ingen kommundata — F5-defaultet står kvar

    // R7.3: verksamheten är kommunoberoende, så grupperingen gäller
    // oavsett om profilens kommun matchar den här sidan eller inte.
    grupperaListan(dennaKommun);

    if (profil.kommunSlug === dennaKommunSlug) {
      if (ingenRad) ingenRad.hidden = true;
      if (matchRad) matchRad.hidden = false;
      if (matchText) matchText.textContent = mallMedTyp(IGENKANNING.matchMallTyp, IGENKANNING.matchMallGenerisk);
      visaAllaKnapp?.addEventListener('click', visaFlatIgen);
    } else if (profil.kommunSlug) {
      const profilKommun = await hamtaKommun(profil.kommunSlug);
      if (!profilKommun) return;

      if (ingenRad) ingenRad.hidden = true;
      if (felKommunRad) felKommunRad.hidden = false;
      if (felKommunText) {
        felKommunText.textContent = mallMedTyp(IGENKANNING.felKommunMallTyp, IGENKANNING.felKommunMallGenerisk)
          .replace('{profilKommun}', profilKommun.kommun)
          .replace('{dennaKommun}', dennaKommun.kommun);
      }
      if (ordnaKnapp) {
        ordnaKnapp.textContent = IGENKANNING.felKommunOrdna.replace('{kommun}', dennaKommun.kommun);
        ordnaKnapp.addEventListener('click', () => {
          // sokt är kommunspecifikt (R7.3) — nollställs vid kommunbyte,
          // frågas inte om i raden. Enklaste korrekta väg till konsekvent
          // tillstånd: ladda om, samma mönster som en vanlig navigering.
          saveForeningsprofil({ kommunSlug: dennaKommunSlug, sokt: null });
          location.reload();
        });
      }
      if (tillbakaLank) {
        tillbakaLank.textContent = IGENKANNING.felKommunTillbaka.replace('{kommun}', profilKommun.kommun);
        tillbakaLank.href = `/kommun/${profil.kommunSlug}/`;
      }
    }
  }

  initIgenkanning();
</script>

