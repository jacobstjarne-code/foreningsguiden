---
// Kommunsidans FULLA rendering (§5 punkt 2 UPPDRAG_POC.md) — utbruten ur
// pages/kommun/[slug]/index.astro (H4, SPEC_ATERSTAENDE_HAL.md Kluster 4)
// så routen kan grena tidigt mellan denna (kommun med datafil) och
// KommunLandningsSida.astro (giltig men ännu otäckt kommun) utan att
// blanda ihop två olika Kommun-typer (Kommun vs Kommun | null) i samma
// frontmatter. Logiken här är OFÖRÄNDRAD mot före utbrytningen — bara
// flyttad, `kommun`-propen är nu required i stället för hämtad via
// getStaticPaths.
import Base from '../layouts/Base.astro';
import BidragCard from './BidragCard.astro';
import StaleWarning from './StaleWarning.astro';
import OmverifieringsVarning from './OmverifieringsVarning.astro';
import TackningsVarning from './TackningsVarning.astro';
import BreadcrumbList from './BreadcrumbList.astro';
import VerificationRow from './VerificationRow.astro';
import KommunProgression from './KommunProgression.astro';
import GiltighetsKontroll from './GiltighetsKontroll.astro';
import {
  isStale, formatDate, formatRecurringDate, svenskLista,
  earliestDeadlineISO, todayISO, beloppTackning,
  KATEGORI_LABELS, KATEGORIER,
} from '../lib/kommuner';
import type { Kommun, Kategori } from '../lib/kommuner';
import { KOMMUN, KOMMUNSIFFRA } from '../lib/content';

export interface Props {
  kommun: Kommun;
}

const { kommun } = Astro.props;
const today = todayISO();

const kategorierMedBidrag = KATEGORIER.filter((k: Kategori) =>
  kommun.bidrag.some((b) => b.kategori.includes(k))
);

// H24 — kommunen har inte publicerat belopp för NÅGOT av sina bidrag.
const tackning = beloppTackning(kommun);
const visaTackningsvarning = tackning.medBelopp === 0 && tackning.utanBelopp > 0;

// Samma sortering (tidigast deadline först, löpande sist) som
// KommunProgression station 4, så ankarlänkarna dit landar i rätt ordning.
const sortedBidrag = [...kommun.bidrag].sort((a, b) => {
  const da = earliestDeadlineISO(a, today);
  const db = earliestDeadlineISO(b, today);
  if (da && db) return da.localeCompare(db);
  if (da) return -1;
  if (db) return 1;
  return 0;
});

const metaTitle = KOMMUN.metaTitleTemplate.replace(/{kommun}/g, kommun.kommun);
const metaDescription = KOMMUN.metaDescriptionTemplate.replace(/{kommun}/g, kommun.kommun);
const h1 = KOMMUN.h1Template.replace(/{kommun}/g, kommun.kommun);
const intro = KOMMUN.introTemplate.replace(/{kommun}/g, kommun.kommun);
const ansokningstext = KOMMUN.ansokningssystemTemplate
  .replace(/{kommun}/g, kommun.kommun)
  .replace(/{system}/g, kommun.ansokningssystem.namn);

// --- Svar-först-block (SOKBARHETSSPEC §3.1) — variant beroende på datat ---
const fastaDeadlines = kommun.bidrag.flatMap((b) => (b.deadlines.typ === 'fasta' ? b.deadlines.datum : []));
const kategorierText = svenskLista(kategorierMedBidrag.map((k) => KATEGORI_LABELS[k].toLowerCase()));

let svarForst = '';
if (kommun.bidrag.length === 1) {
  svarForst = KOMMUN.svarForstEtt
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{bidragsnamn}/g, kommun.bidrag[0].namn)
    .replace(/{system}/g, kommun.ansokningssystem.namn);
} else if (kommun.bidrag.length > 1 && fastaDeadlines.length === 0) {
  svarForst = KOMMUN.svarForstLopande
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{antal}/g, String(kommun.bidrag.length))
    .replace(/{kategorier}/g, kategorierText)
    .replace(/{system}/g, kommun.ansokningssystem.namn);
} else if (kommun.bidrag.length > 1) {
  const sorted = [...fastaDeadlines].sort();
  svarForst = KOMMUN.svarForstMedDeadlines
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{antal}/g, String(kommun.bidrag.length))
    .replace(/{kategorier}/g, kategorierText)
    .replace(/{tidigaste}/g, formatRecurringDate(sorted[0]))
    .replace(/{senaste}/g, formatRecurringDate(sorted[sorted.length - 1]))
    .replace(/{system}/g, kommun.ansokningssystem.namn);
}

// --- FAQ (SOKBARHETSSPEC §3.3) — synlig sektion MÅSTE spegla schemat exakt ---
// 'okand'-bidrag utelämnas ur datumsvaret helt (samma uteslutning som
// deadlinekalendern, getDeadlineEntries) — ett okänt datum är inget vi kan
// svara på, och att formatera b.deadlines.datum (tom array) hade gett en
// trasig mening ("söks senast .").
const deadlinesammanfattning = kommun.bidrag
  .filter((b) => b.deadlines.typ !== 'okand')
  .map((b) => (b.deadlines.typ === 'lopande'
    ? `${b.namn} söks löpande.`
    : `${b.namn} söks senast ${b.deadlines.datum.map(formatRecurringDate).join(', ')}.`))
  .join(' ');

const faqRubrik = KOMMUN.faqRubrik.replace(/{kommun}/g, kommun.kommun);
const faqEntries = kommun.bidrag.length === 0 ? [] : KOMMUN.faq.map(({ fraga, svar }) => ({
  fraga: fraga.replace(/{kommun}/g, kommun.kommun),
  svar: svar
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{antal}/g, String(kommun.bidrag.length))
    .replace(/{system}/g, kommun.ansokningssystem.namn)
    .replace(/{forvaltning}/g, kommun.forvaltning)
    .replace(/{bidragslista}/g, svenskLista(kommun.bidrag.map((b) => b.namn)))
    .replace(/{deadlinesammanfattning}/g, deadlinesammanfattning),
}));

const faqJsonLd = faqEntries.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(({ fraga, svar }) => ({
    '@type': 'Question',
    name: fraga,
    acceptedAnswer: { '@type': 'Answer', text: svar },
  })),
} : null;

// --- Kommunsiffran (SPRINT_COPY.ts §KOMMUNSIFFRA) — bara där datat finns ---
const kommunsiffraText = kommun.kommunsiffra
  ? KOMMUNSIFFRA.template
      .replace(/{antalForeningar}/g, String(kommun.kommunsiffra.antal_foreningar))
      .replace(/{kommun}/g, kommun.kommun)
      .replace(/{summa}/g, kommun.kommunsiffra.summa_kr)
      .replace(/{bidragstyp}/g, kommun.kommunsiffra.bidragstyp)
  : null;
const kommunsiffraKalla = kommun.kommunsiffra
  ? KOMMUNSIFFRA.kalla.replace(/{utlamnadDatum}/g, kommun.kommunsiffra.utlamnad_datum)
  : null;

// dateModified ur verifierad (SOKBARHETSSPEC §4.5) — färskhetssignal.
const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: h1,
  dateModified: kommun.verifierad,
};
---
<Base title={metaTitle} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
  <BreadcrumbList items={[
    { name: 'Startsida', url: '/' },
    { name: kommun.kommun, url: `/kommun/${kommun.kommun_slug}/` },
  ]} />

  <div class="kommun-header">
    <h1>{h1}</h1>
    <p class="kommun-header__meta">
      {kommun.lan} · {kommun.forvaltning} · Senast verifierad {formatDate(kommun.verifierad)}
    </p>
  </div>

  <p class="bevakning-antal" data-bevakning-antal data-kommun-slug={kommun.kommun_slug} data-kommun-namn={kommun.kommun} hidden></p>

  {isStale(kommun.verifierad) && <StaleWarning verifierad={kommun.verifierad} />}
  <OmverifieringsVarning kommunSlug={kommun.kommun_slug} kommunNamn={kommun.kommun} />

  <VerificationRow kommun={kommun.kommun} verifierad={kommun.verifierad} kallaUrl={kommun.kalla_url} />

  {kommunsiffraText && (
    <p class="kommunsiffra">
      {kommunsiffraText} <span class="kommunsiffra__kalla">{kommunsiffraKalla}</span>
    </p>
  )}

  {svarForst && <p class="svar-forst">{svarForst}</p>}

  <p>{intro}</p>

  {kommun.bidrag.length === 0 ? (
    <p>{KOMMUN.ingaBidrag}</p>
  ) : (
    <>
      <KommunProgression kommun={kommun} today={today} />
      <GiltighetsKontroll kommun={kommun} today={today} />
    </>
  )}

  <section>
    <h2>{KOMMUN.ansokningssystemRubrik}</h2>
    <p>
      {ansokningstext}{' '}
      <a href={kommun.ansokningssystem.url}>{kommun.ansokningssystem.url}</a>
    </p>
  </section>

  {kommun.bidrag.length > 0 && (
    <section>
      <h2>Alla bidrag i {kommun.kommun}, i detalj</h2>
      {visaTackningsvarning && <TackningsVarning kommun={kommun.kommun} />}
      <ul class="bidrag-list">
        {sortedBidrag.map((bidrag) => (
          <BidragCard bidrag={bidrag} verifierad={kommun.verifierad} ansokningsUrl={kommun.ansokningssystem.url} kommunSlug={kommun.kommun_slug} />
        ))}
      </ul>
    </section>
  )}

  {faqEntries.length > 0 && (
    <section>
      <h2>{faqRubrik}</h2>
      <dl class="faq-list">
        {faqEntries.map(({ fraga, svar }) => (
          <>
            <dt>{fraga}</dt>
            <dd>{svar}</dd>
          </>
        ))}
      </dl>
    </section>
  )}
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
</Base>

<script>
  import { hamtaBevakningsantal, BEVAKNING_GOLV } from '../lib/bevakningKlient';
  import { VANTELISTA } from '../lib/content';
  import { initFelrapportWidgets } from '../lib/felrapportKlient';

  const el = document.querySelector<HTMLElement>('[data-bevakning-antal]');
  const slug = el?.dataset.kommunSlug;
  const namn = el?.dataset.kommunNamn ?? '';
  if (el && slug) {
    hamtaBevakningsantal(slug).then((antal) => {
      if (antal !== null && antal >= BEVAKNING_GOLV) {
        el.textContent = VANTELISTA.socialProof.replace('{antal}', String(antal)).replace(/{kommun}/g, namn);
        el.hidden = false;
      }
    });
  }

  initFelrapportWidgets();
</script>
