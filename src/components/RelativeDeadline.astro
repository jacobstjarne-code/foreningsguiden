---
// RelativeDeadline — DATATILLSTAND_och_koprutan.md §2c (Design 2026-08-03).
// Prioriterad ("Ledarutbildningsbidraget i Gislaved står just nu med två
// olika besked på samma sida — kortet säger 60 dagar, steg 4-listan säger
// inget publicerat datum"): ERSÄTTER båda med EN komponent, ett besked.
//
// Renderas när bidrag.deadlines.typ === 'relativ' (se DEADLINE_TYPER,
// kommunTyper.ts). Ingen urgensfärg tillåts förrän besökaren fyllt i sin
// egen referenspunkt (regel 2, tokens.css) — NEUTRAL pill före, en
// beräknad absolut dag efter. Samma mekanik som GiltighetsKontroll.astro
// (1f): datum in, besked ut, allt klientsidan.
//
// Medvetet UTELÄMNAT denna omgång: en "Påminn oss i {månad}"-knapp (syns
// i mocken) skulle kräva en NY bevakningsbackend — dagens bevaka-system
// (bevakaKlient.ts) är kommun-scopat mot kommunens EGNA deadlines, inte
// mot en besökares egen uträknade referens, och giltighetsbevakningens
// backend är specifikt formulerad för giltighetsstatus, inte en
// godtycklig bidragsdeadline. Att koppla in endera hade gett en knapp
// som INTE påminner vid rätt tidpunkt — värre än att utelämna den. Se
// rapporten till Jacob.
import type { Bidrag } from '../lib/kommuner';
import { relativFrist } from '../lib/kommuner';

export interface Props {
  bidrag: Bidrag;
}

const { bidrag } = Astro.props;
const frist = relativFrist(bidrag) ?? '';
const dagarMatch = frist.match(/(\d+)\s*dag/);
const dagar = dagarMatch ? Number(dagarMatch[1]) : null;
const inputId = `relativ-frist-datum-${bidrag.id}`;
---
<div class="relativ-frist" data-relativ-frist data-dagar={dagar ?? ''}>
  <p class="fg-chip fg-chip--neutral relativ-frist__pill">Löpande</p>
  <p class="relativ-frist__forklaring">Ingen gemensam sista dag — fristen räknas från er egen kurs.</p>

  {dagar !== null ? (
    <>
      <p class="relativ-frist__sektionslabel">Så räknas er frist</p>
      <div class="fg-formula relativ-frist__formel">
        <span>KURSSLUT</span><span>+</span><span>{dagar} DAGAR</span>
      </div>

      <form data-relativ-frist-form>
        <label for={inputId}>När slutade er kurs?</label>
        <input type="date" id={inputId} name="kursslut" max={new Date().toISOString().slice(0, 10)} required />
        <button type="submit" class="fg-btn--ghost">Räkna ut sista dag</button>
      </form>

      <div class="relativ-frist__resultat" data-relativ-frist-resultat hidden>
        <p class="relativ-frist__resultat-label">Er sista dag</p>
        <p class="relativ-frist__resultat-datum" data-relativ-frist-datum></p>
        <p class="relativ-frist__resultat-sub" data-relativ-frist-sub></p>
      </div>
    </>
  ) : (
    <p class="relativ-frist__beskrivning">{frist}</p>
  )}
</div>

<script>
  const MANADSNAMN = [
    'januari', 'februari', 'mars', 'april', 'maj', 'juni',
    'juli', 'augusti', 'september', 'oktober', 'november', 'december',
  ];
  const VECKODAGAR = ['söndag', 'måndag', 'tisdag', 'onsdag', 'torsdag', 'fredag', 'lördag'];

  function toUTC(iso: string): number {
    const [y, m, d] = iso.split('-').map(Number);
    return Date.UTC(y, m - 1, d);
  }
  function formatDate(iso: string): string {
    const [y, m, d] = iso.split('-').map(Number);
    return `${d} ${MANADSNAMN[m - 1]} ${y}`;
  }
  function formatWeekday(iso: string): string {
    return VECKODAGAR[new Date(toUTC(iso)).getUTCDay()];
  }
  function addDays(iso: string, days: number): string {
    const dt = new Date(toUTC(iso) + days * 24 * 60 * 60 * 1000);
    return `${dt.getUTCFullYear()}-${String(dt.getUTCMonth() + 1).padStart(2, '0')}-${String(dt.getUTCDate()).padStart(2, '0')}`;
  }

  document.querySelectorAll<HTMLElement>('[data-relativ-frist]').forEach((widget) => {
    const dagar = Number(widget.dataset.dagar || '');
    if (!dagar) return;

    const form = widget.querySelector<HTMLFormElement>('[data-relativ-frist-form]');
    const resultat = widget.querySelector<HTMLElement>('[data-relativ-frist-resultat]');
    const resultatDatum = widget.querySelector<HTMLElement>('[data-relativ-frist-datum]');
    const resultatSub = widget.querySelector<HTMLElement>('[data-relativ-frist-sub]');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="kursslut"]');
      if (!input?.value) return;
      const kursslut = input.value;
      const sistaDag = addDays(kursslut, dagar);
      const dagarKvar = Math.round((toUTC(sistaDag) - toUTC(kursslut)) / (1000 * 60 * 60 * 24));
      const veckorText = Math.round(dagarKvar / 7) === 1 ? 'om 1 vecka' : `om ${Math.round(dagarKvar / 7)} veckor`;

      if (resultatDatum) {
        resultatDatum.textContent = `${formatWeekday(sistaDag).replace(/^./, (c) => c.toUpperCase())} ${formatDate(sistaDag)}`;
      }
      if (resultatSub) {
        resultatSub.textContent = `Kursslut ${formatDate(kursslut)} · ${veckorText}`;
      }
      form.hidden = true;
      resultat?.removeAttribute('hidden');
    });
  });
</script>

<style>
  .relativ-frist__pill {
    margin: 0 0 var(--fg-space-3);
  }

  .relativ-frist__forklaring {
    color: var(--fg-ink-muted);
    margin: 0 0 var(--fg-space-4);
  }

  .relativ-frist__sektionslabel {
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-label);
    font-weight: var(--fg-weight-bold);
    letter-spacing: var(--fg-tracking-label);
    text-transform: uppercase;
    color: var(--fg-ink-muted);
    margin: 0 0 8px;
  }

  .relativ-frist__formel {
    margin-bottom: var(--fg-space-4);
  }

  .relativ-frist__beskrivning {
    margin: 0;
  }

  [data-relativ-frist-form] {
    display: flex;
    flex-wrap: wrap;
    gap: var(--fg-space-3);
    align-items: flex-end;
    margin-bottom: var(--fg-space-4);
  }

  [data-relativ-frist-form] label {
    display: block;
    font-weight: var(--fg-weight-bold);
    font-size: var(--fg-text-label);
    margin-bottom: 4px;
    flex-basis: 100%;
  }

  [data-relativ-frist-form] input[type='date'] {
    padding: var(--fg-space-3);
    border: var(--fg-border-inner) solid var(--fg-border);
    border-radius: var(--fg-radius-control);
    font-family: var(--fg-font-sans);
    font-size: var(--fg-text-body-lg);
  }

  .relativ-frist__resultat {
    background: var(--fg-accent-soft);
    border: var(--fg-border-inner) solid var(--fg-accent);
    border-radius: var(--fg-radius-control);
    padding: var(--fg-space-4);
  }

  .relativ-frist__resultat-label {
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-label);
    font-weight: var(--fg-weight-bold);
    letter-spacing: var(--fg-tracking-label);
    text-transform: uppercase;
    color: var(--fg-accent);
    margin: 0 0 4px;
  }

  .relativ-frist__resultat-datum {
    font-size: 1.25rem;
    font-weight: var(--fg-weight-bold);
    margin: 0 0 4px;
  }

  .relativ-frist__resultat-sub {
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-label);
    color: var(--fg-ink-muted);
    margin: 0;
  }
</style>
