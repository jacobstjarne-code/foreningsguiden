---
// OlastMark — "olast" (ÅTGÄRDSSPEC T3, 2026-08-03 kväll, fyra-
// lägesrevisionen). VÄRDET VISAS — det finns, extraherat ur källan —
// men med samma reservation överallt det förekommer: streckad markör,
// en rad om att vi inte oberoende omkontrollerat det, och en källänk ut.
//
// Detta är den komponent som löser "Arvika-problemet": innan fanns bara
// en binär — visa med full säkerhet (angivet) eller dölj helt
// (overifierat). Ekern visade ett datum som fakta, kortet hedgade samma
// datum — båda hade "rätt" givet den gamla tvådelningen. Nu bär VARJE
// yta som visar ett olast-värde samma reservation, så det aldrig kan
// se mer eller mindre säkert ut beroende på VAR på sidan man tittar.
//
// Tre syskon, tre olika besked, ALDRIG blandade i en komponent med en
// flagga (se VoidMark/VoidState filhuvuden för samma regel):
//   VoidMark   "vi vet inte" — inget värde alls.
//   VoidState  "vi har kollat, det finns inget att veta" — bekräftad frånvaro.
//   OlastMark  "här är värdet, vi har inte dubbelkollat det" — DENNA.
import { OLAST_MARK } from '../lib/content';

export interface Props {
  kallaUrl: string;
}

const { kallaUrl } = Astro.props;
const host = new URL(kallaUrl).hostname.replace(/^www\./, '');
---
<div class="fg-olast">
  <div class="fg-olast__varde"><slot /></div>
  <p class="fg-olast__rad">
    <span class="fg-void-mark" aria-hidden="true"></span>
    {OLAST_MARK.rad}
    <a href={kallaUrl} target="_blank" rel="noopener">{OLAST_MARK.kallaKnappMall.replace('{host}', host)}</a>
  </p>
</div>

<style>
  .fg-olast__varde {
    margin: 0 0 6px;
  }

  .fg-olast__rad {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fg-text-label);
    color: var(--fg-ink-muted);
    margin: 0;
  }

  .fg-olast__rad a {
    color: var(--fg-ink-muted);
    text-decoration: underline;
  }
</style>
