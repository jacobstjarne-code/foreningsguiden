---
// VantelistaFlode — VÄNTELISTAN på station 5 (SPRINT §Spår B,
// SPRINT_COPY.ts §VÄNTELISTA). Återinkopplad 2026-08-03 kväll
// (ÅTGÄRDSSPEC punkt 1): köprutan (KommunProgression.astro) kräver nu
// D1 (krav_status: verifierad + minst tre krav) — tills verifieringen
// hunnit ikapp visas denna i stället, en instans per filter utan
// D1-kandidat. Loggar kommun+bidrag per anmälan (vantelista.ts) — det
// blir prioriteringskön för vilka bidrag som ska verifieras näst.
//
// Ingen dubbel opt-in här (till skillnad från subscribers.ts/BEVAKNING):
// kvittot lovar inget bekräftelsemejl, bara "vi hör av oss när tjänsten
// öppnar" — se vantelista.ts.
import type { Kommun, Bidrag } from '../lib/kommuner';
import { VAGLEDNING, VANTELISTA } from '../lib/content';
import { earliestDeadlineISO, formatDate, daysUntil, getUrgency, todayISO } from '../lib/kommuner';
import UrgencyChip from './UrgencyChip.astro';

export interface Props {
  kommun: Kommun;
  bidrag: Bidrag;
}

const { kommun, bidrag } = Astro.props;

// Kostnadsramen (pengarna) — bara där kommunen faktiskt lämnat ut en egen
// sammanställning (kommuner.ts Kommunsiffra). Gissa aldrig fram en summa.
const kostnadsram = kommun.kommunsiffra
  ? VANTELISTA.kostnadsram.replace(/{kommun}/g, kommun.kommun).replace('{summa}', kommun.kommunsiffra.summa_kr)
  : null;

// Sann nedräkning — bara för fasta deadlines, mot det faktiska datumet
// (samma daysUntil/getUrgency som UrgencyChip använder överallt annars).
const today = todayISO();
const deadlineISO = earliestDeadlineISO(bidrag, today);
const dagarKvar = deadlineISO ? daysUntil(deadlineISO, today) : null;
---
<div class="vantelista" data-vantelista data-kommun-slug={kommun.kommun_slug} data-kommun-namn={kommun.kommun} data-bidrag-id={bidrag.id} data-bidrag-namn={bidrag.namn}>
  {/* R5.3 (OMFORDELA_TEXTMASSAN.md runda 5, 2026-08-05): station 3:s
     attention-drag är sidans enda färgade knapp — den här (station 5:s
     alltid synliga trigger) är tystad till fg-btn--ghost. Formulärets
     egen submit-knapp längre ner (efter att panelen redan öppnats, ett
     interaktionssteg bort) lämnad orörd. */}
  <button type="button" class="fg-btn--ghost progression__goal-cta" data-vantelista-knapp data-utkastgenerator-byggd="false">
    {VAGLEDNING.station5.knapp} för {bidrag.namn}
  </button>

  <div class="vantelista__panel" data-vantelista-panel hidden>
    {kostnadsram && <p class="vantelista__kostnadsram">{kostnadsram}</p>}
    <p class="vantelista__social-proof" data-vantelista-social-proof hidden></p>

    {deadlineISO && dagarKvar !== null && (
      <p class="vantelista__deadline">
        <UrgencyChip urgency={getUrgency(dagarKvar)} />
        {' '}{dagarKvar} {dagarKvar === 1 ? 'dag' : 'dagar'} kvar · sista ansökningsdag {formatDate(deadlineISO)}
      </p>
    )}

    <p class="vantelista__pris">{VANTELISTA.prisRad}</p>

    {/* P1.2 (Jacob 2026-08-04): rubrik ("Vi skriver allt utom det bara ni
       vet") och besked ("...bemöter varje krav kommunen ställer")
       borttagna — båda överclaimar. prisRad ovan är den gällande
       formuleringen, oförändrad. */}

    {/* A2 (SPEC: Kvarvarande luckor, 2026-07-29): namnger luckorna FÖRE
       köpet — bara när besökaren redan har en sparad profil FÖR DENNA
       kommun (matchningstratten, foreningsprofil.ts). Ingen profil =
       inget att räkna på = döljs helt, gissar aldrig. Fylls av
       skriptet nedan via fyllKrav() (utkastGenerator.ts) mot
       bidragets egna Bidrag.krav[], citerat ordagrant — aldrig en
       generisk uppfunnen lista.
       P1.6 (Jacob 2026-08-05): punktlista, inte en semikolonfogad
       mening — bröt vid fler än två krav. Egen <ul> för luckorna,
       <p> kvar bara för luckorInga-fallet (noll luckor, en riktig
       mening). */}
    <div data-vantelista-luckor hidden>
      <h4 data-vantelista-luckor-rubrik hidden></h4>
      <ul class="vantelista__luckor-lista" data-vantelista-luckor-lista hidden></ul>
      <p data-vantelista-luckor-text></p>
    </div>

    <p>{VANTELISTA.cta}</p>

    <form data-vantelista-form>
      <label for={`vantelista-epost-${bidrag.id}`}>{VANTELISTA.epostLabel}</label>
      <input type="email" id={`vantelista-epost-${bidrag.id}`} name="email" required autocomplete="email" />
      <button type="submit" class="btn-primary">{VANTELISTA.knappVantelista}</button>
    </form>

    <p data-vantelista-kvitto hidden>{VANTELISTA.kvitto}</p>
    <p data-vantelista-fel hidden>Något gick fel. Försök igen.</p>
  </div>
</div>

<script>
  import { hamtaBevakningsantal, BEVAKNING_GOLV } from '../lib/bevakningKlient';
  import { VANTELISTA } from '../lib/content';
  import { fyllKrav } from '../lib/utkastGenerator';
  import { getForeningsprofil } from '../lib/foreningsprofil';
  import type { Kommun } from '../lib/kommunTyper';

  // A2: en fetch per KOMMUN, delad mellan alla väntelista-widgets på
  // samma sida (en kommunsida kan ha flera bidrag utan generator).
  const kommunDataCache = new Map<string, Promise<Kommun | null>>();
  function hamtaKommunData(slug: string): Promise<Kommun | null> {
    if (!kommunDataCache.has(slug)) {
      kommunDataCache.set(
        slug,
        fetch(`/kommun-data/${slug}.json`)
          .then((res) => (res.ok ? (res.json() as Promise<Kommun>) : null))
          .catch(() => null)
      );
    }
    return kommunDataCache.get(slug)!;
  }

  document.querySelectorAll<HTMLElement>('[data-vantelista]').forEach((widget) => {
    const kommunSlug = widget.dataset.kommunSlug ?? '';
    const kommunNamn = widget.dataset.kommunNamn ?? '';
    const bidragId = widget.dataset.bidragId ?? '';
    const bidragNamn = widget.dataset.bidragNamn ?? '';
    const knapp = widget.querySelector<HTMLButtonElement>('[data-vantelista-knapp]');
    const panel = widget.querySelector<HTMLElement>('[data-vantelista-panel]');
    const form = widget.querySelector<HTMLFormElement>('[data-vantelista-form]');
    const kvitto = widget.querySelector<HTMLElement>('[data-vantelista-kvitto]');
    const felText = widget.querySelector<HTMLElement>('[data-vantelista-fel]');
    const socialProofEl = widget.querySelector<HTMLElement>('[data-vantelista-social-proof]');
    const luckorEl = widget.querySelector<HTMLElement>('[data-vantelista-luckor]');
    const luckorRubrikEl = widget.querySelector<HTMLElement>('[data-vantelista-luckor-rubrik]');
    const luckorListaEl = widget.querySelector<HTMLUListElement>('[data-vantelista-luckor-lista]');
    const luckorTextEl = widget.querySelector<HTMLElement>('[data-vantelista-luckor-text]');

    let klickLoggat = false;
    let socialProofHamtad = false;
    let luckorHamtade = false;

    async function visaSocialProof() {
      if (socialProofHamtad || !socialProofEl || !kommunSlug) return;
      socialProofHamtad = true;
      const antal = await hamtaBevakningsantal(kommunSlug);
      if (antal !== null && antal >= BEVAKNING_GOLV) {
        socialProofEl.textContent = VANTELISTA.socialProof.replace('{antal}', String(antal)).replace(/{kommun}/g, kommunNamn);
        socialProofEl.hidden = false;
      }
    }

    // A2 (SPEC: Kvarvarande luckor, 2026-07-29): namngivna luckor,
    // bara när profilen redan gäller DENNA kommun — annars vet vi
    // ingenting om föreningen och gissar hellre inte alls.
    async function visaLuckor() {
      if (luckorHamtade || !luckorEl || !luckorTextEl) return;
      const profil = getForeningsprofil();
      if (!profil || !profil.kommunSlug || profil.kommunSlug !== kommunSlug) return;
      luckorHamtade = true;

      const kommunData = await hamtaKommunData(kommunSlug);
      const bidrag = kommunData?.bidrag.find((b) => b.id === bidragId);
      if (!kommunData || !bidrag) return;

      const luckor = bidrag.krav.filter((kravText) => fyllKrav(kravText, profil, bidrag, kommunData).status === 'lucka');

      if (luckor.length > 0 && luckorRubrikEl && luckorListaEl) {
        luckorRubrikEl.textContent = VANTELISTA.luckorRubrik.replace('{bidragsnamn}', bidragNamn);
        luckorRubrikEl.hidden = false;
        luckorListaEl.replaceChildren(
          ...luckor.map((kravText) => {
            const li = document.createElement('li');
            li.textContent = kravText;
            return li;
          })
        );
        luckorListaEl.hidden = false;
      } else {
        luckorTextEl.textContent = VANTELISTA.luckorInga.replace('{bidragsnamn}', bidragNamn);
      }
      luckorEl.hidden = false;
    }

    knapp?.addEventListener('click', () => {
      panel?.removeAttribute('hidden');
      knapp.hidden = true;
      visaSocialProof();
      visaLuckor();

      // Klicket är intentmätningen — loggas oavsett om formuläret sen fylls
      // i. keepalive: true så requesten inte tappas om något navigerar bort.
      if (!klickLoggat) {
        klickLoggat = true;
        const data = new FormData();
        data.set('kommun', kommunSlug);
        data.set('bidrag', bidragId);
        fetch('/api/vantelista-klick', { method: 'POST', body: data, keepalive: true }).catch(() => {});
      }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      felText?.setAttribute('hidden', '');
      const data = new FormData(form);
      data.set('kommun', kommunSlug);
      data.set('bidrag', bidragId);

      try {
        const res = await fetch('/api/vantelista', { method: 'POST', body: data });
        const json = await res.json();
        if (!res.ok || !json.ok) throw new Error('svar ej ok');

        form.hidden = true;
        kvitto?.removeAttribute('hidden');
      } catch {
        felText?.removeAttribute('hidden');
      }
    });
  });
</script>
