---
// GiltighetsKontroll — GILTIGHETSKOLLEN-widgeten (SPRINT §Spår B,
// SPRINT_COPY.ts §GILTIGHETSKOLL). Ett årsmötesdatum in, ett besked ut.
//
// C3.1 (Jacob 2026-08-11, Helsingborg-fyndet): widgeten byggde tidigare på
// Forutsattning.giltighet (fritext) + en gissad ~365-dagarscykel
// (RISK_TROSKEL_DAGAR/GRANS_DAGAR) — fel bas för kommuner vars regel inte
// faktiskt var "ett år efter årsmötet" (Helsingborg: "ett år från
// beslutsdagen", widgeten sa "mars 2027, om 7 månader"). Widgeten räknar
// nu UTESLUTANDE mot kommun.giltighet_regel + berakForfallodatum()
// (kommunTyper.ts) — samma funktion som ska driva cronets NIVÅ 1/2.
//
// Tre nivåer, ett svar per sida (widgeten är ENDA platsen ett beräknat
// förfallodatum visas — ingen separat rad någon annanstans på sidan):
//   NIVÅ 1: giltighetRegelGerDatum(kommun.giltighet_regel) sann + besökaren
//     anger årsmötesdatum → ett riktigt beräknat förfallodatum.
//   NIVÅ 2: regeln saknas eller ger inget datum + årsmötesdatum angivet →
//     ingen gissning, bara löftet om januari-genomgången + länk till
//     kommunens sida.
//   NIVÅ 3: inget årsmötesdatum än → bara frågan, inget påstående.
import type { Kommun } from '../lib/kommuner';
import { giltighetRegelGerDatum } from '../lib/kommunTyper';
import { GILTIGHETSKOLL, BEVAKNING } from '../lib/content';

export interface Props {
  kommun: Kommun;
  today: string;
}

const { kommun, today } = Astro.props;
const regel = kommun.giltighet_regel;
const gerDatum = giltighetRegelGerDatum(regel);
const intro = (gerDatum ? GILTIGHETSKOLL.intro : GILTIGHETSKOLL.introOkand).replace(/{kommun}/g, kommun.kommun);
---
<div
  class="giltighetskoll fg-card"
  data-giltighetskoll
  data-kommun-slug={kommun.kommun_slug}
  data-ger-datum={gerDatum ? '1' : ''}
  data-regel-typ={regel?.typ ?? ''}
  data-regel-antal={regel?.antal ?? ''}
  data-today={today}
>
  <h3>{GILTIGHETSKOLL.rubrik}</h3>
  <p>{intro}</p>

  <form data-giltighetskoll-form>
    <label for="giltighetskoll-datum">{GILTIGHETSKOLL.datumLabel}</label>
    <input type="date" id="giltighetskoll-datum" name="arsmotesdatum" max={today} required />
    <button type="submit" class="fg-btn--ghost">{GILTIGHETSKOLL.knapp}</button>
  </form>

  <div data-giltighetskoll-svar hidden>
    {gerDatum ? (
      <p data-giltighetskoll-svar-niva-ett hidden>{GILTIGHETSKOLL.nivaEttSvar}</p>
    ) : (
      <p data-giltighetskoll-svar-niva-tva hidden>
        {GILTIGHETSKOLL.nivaTvaForeLank.replace(/{kommun}/g, kommun.kommun)}<a href={kommun.kalla_url} target="_blank" rel="noopener">{GILTIGHETSKOLL.nivaTvaLank}</a>{GILTIGHETSKOLL.nivaTvaEfterLank}
      </p>
    )}

    <form data-giltighetskoll-epostform hidden>
      <label for="giltighetskoll-epost">{BEVAKNING.epostLabel}</label>
      <input type="email" id="giltighetskoll-epost" name="email" placeholder={BEVAKNING.epostPlaceholder} required autocomplete="email" />
      {/* C1 (ARBETSORDER 2026-08-11): HÄR, inte bara i det allmänna
          /deadlines/-formuläret — det är i giltighetskontrollen mejl och
          årsmötesdatum faktiskt fångas ihop, vilket C3 kräver tillsammans
          med föreningsnamnet. Frivilligt, samma som EmailSignup.astro. */}
      <label for="giltighetskoll-foreningsnamn">{BEVAKNING.foreningsnamnLabel}</label>
      <input type="text" id="giltighetskoll-foreningsnamn" name="foreningsnamn" autocomplete="organization" />
      <label class="email-signup__consent">
        <input type="checkbox" name="samtycke" required />
        {BEVAKNING.samtycke}
      </label>
      {/* A5.2 (2026-08-11): sekundär — ett drag per sida totalt. */}
      <button type="submit" class="fg-btn--ghost" data-giltighetskoll-epostform-knapp>{GILTIGHETSKOLL.paminnKnapp}</button>
    </form>

    <div data-giltighetskoll-kvitto-bekraftelse hidden>
      <h4>{BEVAKNING.kvittoRubrik}</h4>
      <p>{BEVAKNING.kvittoText}</p>
    </div>
    <div data-giltighetskoll-kvitto-sparat hidden>
      <h4>Sparat</h4>
    </div>
    <p data-giltighetskoll-fel hidden>Något gick fel. Försök igen.</p>
  </div>
</div>

<script>
  import { GILTIGHETSKOLL } from '../lib/content';
  import { berakForfallodatum, addMonths } from '../lib/kommunTyper';
  import type { GiltighetRegel, GiltighetRegelTyp } from '../lib/kommunTyper';
  import { trackEvent } from '../lib/umami';
  import { saveForeningsprofil } from '../lib/foreningsprofil';

  const MANADSNAMN = [
    'januari', 'februari', 'mars', 'april', 'maj', 'juni',
    'juli', 'augusti', 'september', 'oktober', 'november', 'december',
  ];
  // NIVÅ 2 har ingen egen förfallomånad att räkna en påminnelse mot — Jacobs
  // spec (C3 REVIDERAD) säger januari rakt av: kommunernas deadlines
  // klustrar februari–april, så januari är rätt tid oavsett vilken kommun.
  const NIVA_TVA_PAMINN_MANAD = 'januari';

  document.querySelectorAll<HTMLElement>('[data-giltighetskoll]').forEach((widget) => {
    const today = widget.dataset.today ?? '';
    const gerDatum = widget.dataset.gerDatum === '1';
    const regelTyp = widget.dataset.regelTyp as GiltighetRegelTyp | undefined;
    const regelAntalRaw = widget.dataset.regelAntal ?? '';
    // datum: null — samma J3-flaggade lucka som VarmSkarm.astro: fast_datum-
    // stöd inte trådat till den här widgeten än, ofarligt idag (0 kommuner
    // har giltighet_regel), men widgeten visar inte NIVÅ 1 för fast_datum
    // ens efter G1 förrän data-regel-datum finns.
    const regel: GiltighetRegel | null = regelTyp
      ? { typ: regelTyp, antal: regelAntalRaw === '' ? null : Number(regelAntalRaw), datum: null, kalla_url: '' }
      : null;

    const form = widget.querySelector<HTMLFormElement>('[data-giltighetskoll-form]');
    const svarBlock = widget.querySelector<HTMLElement>('[data-giltighetskoll-svar]');
    const svarNivaEtt = widget.querySelector<HTMLElement>('[data-giltighetskoll-svar-niva-ett]');
    const svarNivaTva = widget.querySelector<HTMLElement>('[data-giltighetskoll-svar-niva-tva]');
    const epostForm = widget.querySelector<HTMLFormElement>('[data-giltighetskoll-epostform]');
    const epostFormKnapp = widget.querySelector<HTMLButtonElement>('[data-giltighetskoll-epostform-knapp]');
    const kvittoBekraftelse = widget.querySelector<HTMLElement>('[data-giltighetskoll-kvitto-bekraftelse]');
    const kvittoSparat = widget.querySelector<HTMLElement>('[data-giltighetskoll-kvitto-sparat]');
    const felText = widget.querySelector<HTMLElement>('[data-giltighetskoll-fel]');

    let arsmotesdatum = '';

    const kommunSlug = widget.dataset.kommunSlug ?? '';

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="arsmotesdatum"]');
      if (!input?.value) return;
      arsmotesdatum = input.value;

      form.hidden = true;
      svarBlock?.removeAttribute('hidden');

      let paminnManadNamn = NIVA_TVA_PAMINN_MANAD;

      const forfallodatum = gerDatum && regel ? berakForfallodatum(regel, arsmotesdatum, today) : null;
      // M4 (MÄTNING, Jacob 2026-08-11): svarar "hur ofta vi svarar 'vi vet
      // inte', alltså hur mycket G1 är värd" — NIVÅ 1/2, samma gren som
      // faktiskt avgör vilken text besökaren ser.
      trackEvent('giltighet_kontrollerad', { kommun: kommunSlug, niva: forfallodatum ? 1 : 2 });
      if (forfallodatum) {
        const [fy, fm] = forfallodatum.split('-').map(Number);
        const paminnISO = addMonths(forfallodatum, -2);
        const [, pm] = paminnISO.split('-').map(Number);
        paminnManadNamn = MANADSNAMN[pm - 1];

        if (svarNivaEtt) {
          svarNivaEtt.textContent = (svarNivaEtt.textContent ?? '')
            .replace('{manad}', MANADSNAMN[fm - 1])
            .replace('{ar}', String(fy))
            .replace('{paminnManad}', paminnManadNamn);
          svarNivaEtt.removeAttribute('hidden');
        }
      } else {
        // NIVÅ 2 — regeln saknas/ger inget datum. Ingen beräkning, ingen
        // gissning (samma väg om gerDatum var sann men berakForfallodatum
        // ändå gav null — kan i praktiken inte hända, men gissar aldrig).
        svarNivaTva?.removeAttribute('hidden');
      }

      if (epostFormKnapp) epostFormKnapp.textContent = GILTIGHETSKOLL.paminnKnappMall.replace('{manad}', paminnManadNamn);
      epostForm?.removeAttribute('hidden');
      // M3: samma "var lämnar hon mejladressen"-fråga som EmailSignup.astro/
      // bevakaKlient.ts, bara ett tredje ställe formuläret kan dyka upp.
      trackEvent('bevakning_visad', { kommun: kommunSlug });
    });

    epostForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      felText?.setAttribute('hidden', '');
      const data = new FormData(epostForm);
      data.set('kommun', kommunSlug);
      data.set('arsmotesdatum', arsmotesdatum);

      // E1/E4-uppföljning (Jacob 2026-08-11): speglar föreningsnamn +
      // årsmötesdatum till Foreningsprofil (localStorage), samma "tomt
      // skriver aldrig över"-regel som EmailSignup.astro. Sparas OAVSETT
      // om själva fetch:en lyckas — hon skrev det, sant oberoende av
      // nätverksutfallet. giltighet bär sin egen kommunSlug (se
      // foreningsprofil.ts) — rör aldrig profilens delade kommunSlug.
      const foreningsnamn = (data.get('foreningsnamn') ?? '').toString().trim();
      if (foreningsnamn) saveForeningsprofil({ foreningsnamn });
      if (arsmotesdatum) saveForeningsprofil({ giltighet: { kommunSlug, arsmotesdatum } });

      try {
        const res = await fetch('/api/giltighetsbevakning', { method: 'POST', body: data });
        const json = await res.json();
        if (!res.ok || !json.ok) throw new Error('svar ej ok');

        epostForm.hidden = true;
        trackEvent('bevakning_skickad', { kommun: kommunSlug });
        if (json.alreadyConfirmed) {
          kvittoSparat?.removeAttribute('hidden');
        } else {
          kvittoBekraftelse?.removeAttribute('hidden');
        }
      } catch {
        felText?.removeAttribute('hidden');
      }
    });
  });
</script>
