---
// KommunProgression — "vägen", fem stationer (HANDOVER_progressionen.md,
// FORUTSATTNINGAR.md §4). Ersätter den platta kategorikatalogen. Station 1
// filtrerar 2/4/5 klientsidan (samma data-attribut-mönster som deadlines/).
//
// Föreningstyp = kommunens KATEGORIER (idrott/kultur/social/pensionar/
// funktionsratt/ovrig). Mockens exempel-pills (Idrott/Kultur/Ungdom/
// Studieförbund/Övrig) var illustrativa — vi filtrerar mot den taxonomi
// som faktiskt finns i datat, inte mot påhittade nya kategorier.
import type { Kommun, Kategori, Urgency } from '../lib/kommuner';
import {
  KATEGORIER, KATEGORI_LABELS, formatRecurringDate, formatDate,
  earliestDeadlineISO, daysUntil, getUrgency, delaUppKravPunkter, relativFrist, harEtjanstsystem, possessiv,
  loadKommuner, beraknaArbetsbevis, beloppArEttEnkeltTal, individuelltBelopp,
} from '../lib/kommuner';
import { VAGLEDNING, KOPRUTA, KONVERTERINGSSTAPEL, FORSTASIDAN_SVARAR } from '../lib/content';
import { PRIS_BIDRAGSUTKAST_ORE } from '../lib/priser';
import { genereraRegistreringsUtkast } from '../lib/utkastGenerator';
import { harvestBilagor } from '../lib/kopDokument';
import { arKommunKlar9av9, arBidragSaljbart } from '../lib/kommunKlar';
import UrgencyChip from './UrgencyChip.astro';
import VantelistaFlode from './VantelistaFlode.astro';

// FIX 2026-07-31 (Jacob, egen granskning): station 5 visade väntelistan
// (VantelistaFlode — "Reservera plats nu. Ni betalar först när utkastet
// ligger klart") trots att utkastvyn är LIVE sedan 2026-07-30/31
// (UTKASTVY_LIVE, Stripe kopplat) — kommentaren nedan bad uttryckligen om
// just detta ("Den riktiga utkastvyns länk byggs in HÄR ... samma dag
// utkastvyn faktiskt finns"), men bytet gjordes aldrig när utkastvyn blev
// klar. VantelistaFlode borttagen, ersatt av köprutan (KOPRUTA, samma
// content.ts-konstant som /registrera/ och /utkast/[bidragId]/) som länkar
// direkt till den riktiga utkastvyn. Själva köpflödet (profilmatchning,
// Stripe, luckor) dupliceras INTE här — det finns redan, testat, på
// /kommun/[slug]/utkast/[bidragId]/.
//
// Station 5:s knapp är sajtens enda betalpunkt-ingång (AFFARSMODELL.md §3,
// DESIGN_UPPDRAG_2_KOMMERSIELL.md §2.1).

// /exempel/-sidorna är avstängda i produktion (EXEMPELSIDOR_LIVE = false i
// src/pages/exempel/[kommun]/[kategori]/index.astro). Länken till dem togs
// bort ur station 5 i samma fix som väntelistan (2026-07-31) — den var
// redan bakom en alltid-false-flagga (renderade aldrig) och blev dubbelt
// obsolet när stationen gick från "en kopia per filter" till "en kopia,
// bytt via JS". Om exempelsidorna någon gång slås på: lägg tillbaka
// exempelHref i station5PerFilter nedan (samma mönster som beskrivning/href).

export interface Props {
  kommun: Kommun;
  today: string;
}

const { kommun, today } = Astro.props;

// Q1 (Jacob 2026-08-17): "Ordet alla får bara stå när kommunen klarar
// 9/9 i verify-kommun-klar." Samma nio regler som CLI-grinden.
const klar9av9 = arKommunKlar9av9(kommun);

const kategorierMedBidrag = KATEGORIER.filter((k: Kategori) => kommun.bidrag.some((b) => b.kategori.includes(k)));

const bidragMedDeadline = kommun.bidrag.map((b) => ({
  bidrag: b,
  dateISO: earliestDeadlineISO(b, today),
}));

const sortedBidrag = [...bidragMedDeadline].sort((a, b) => {
  if (a.dateISO && b.dateISO) return a.dateISO.localeCompare(b.dateISO);
  if (a.dateISO) return -1;
  if (b.dateISO) return 1;
  return 0;
});

// Filtervärden: 'alla' + varje kategori som finns representerad.
const filterValues: string[] = ['alla', ...kategorierMedBidrag];

function bidragForFilter(filter: string) {
  return filter === 'alla' ? sortedBidrag : sortedBidrag.filter((e) => e.bidrag.kategori.includes(filter as Kategori));
}

const forutsattningar = kommun.forutsattningar;
const forsta = forutsattningar[0];
const extra = forutsattningar.slice(1);

// 1d (SPEC_HUVUDPROCESSEN §1d, Jacob 2026-08-02): bocka av-punkter i
// stället för ett textblock, när beskrivningen faktiskt går att dela
// mekaniskt (≥2 meningar). En enda mening → prosa som i dag, oförändrat
// (se delaUppKravPunkter i kommunTyper.ts för varför kommatecken aldrig
// används som gräns). Bilagorna härleds ur SAMMA motor som det köpta
// utkastet (harvestBilagor/genereraRegistreringsUtkast) — bara det
// kommunen faktiskt nämner i sin egen text, ingen påhittad standardlista.
const forstaPunkter = forsta ? delaUppKravPunkter(forsta.beskrivning) : [];
const forstaKanDelas = forstaPunkter.length >= 2;
const bilagor = forutsattningar.length > 0 ? harvestBilagor(genereraRegistreringsUtkast(kommun)) : [];

// FIX 2026-07-31 (Jacob, egen granskning): station 2 och station 5
// renderade tidigare EN FULL KOPIA per filterValue (ett bidrag-oberoende
// "alla"-läge + en kopia per kategori), maskerade med hidden/CSS så bara
// en syns åt gången. Sårbart (upplevd dubblering flaggad i granskningen)
// och växer proportionellt mot antal kategorier. Ersatt: varje station
// renderas EN gång (för filter='alla'), och en liten per-filter datamängd
// nedan används av skriptet längst ner för att byta text/href/urgency när
// ett kategori-piller klickas — ingen förnyad DOM-uppbyggnad, bara text.
type Station2Entry = { urgency: Urgency; namn: string; datumText: string; href: string } | null;
const station2PerFilter: Record<string, Station2Entry> = Object.fromEntries(
  filterValues.map((filter) => {
    const kandidater = bidragForFilter(filter).filter((e) => e.dateISO);
    const forstaKandidat = kandidater[0];
    if (!forstaKandidat || !forstaKandidat.dateISO) return [filter, null];
    return [filter, {
      urgency: getUrgency(daysUntil(forstaKandidat.dateISO, today)),
      namn: forstaKandidat.bidrag.namn,
      datumText: `${formatDate(forstaKandidat.dateISO)} · om ${daysUntil(forstaKandidat.dateISO, today)} dagar`,
      href: `#bidrag-${forstaKandidat.bidrag.id}`,
    }];
  })
);
const station2Alla = station2PerFilter.alla;

const prisKr = PRIS_BIDRAGSUTKAST_ORE / 100;
const fyllKopruta = (text: string, bidragNamn: string) =>
  text.replace('{kommun}', kommun.kommun).replace('{kommunPossessiv}', possessiv(kommun.kommun)).replace('{bidrag}', bidragNamn).replace('{pris}', String(prisKr)).replace('{system}', kommun.ansokningssystem.namn);
const kopRutaPrisOchKvitto = KOPRUTA.prisOchKvitto.replace('{pris}', String(prisKr));
// C5 (ÅTGÄRDSSPEC, 2026-08-03 kväll): en gång per kommun, inte per bidrag.
const kopRutaBeskrivningMall = harEtjanstsystem(kommun) ? KOPRUTA.beskrivningEtjanst : KOPRUTA.beskrivning;

// R2 (Jacob 2026-08-18): blockets villkor — inte längre ifyllnad/luckor.
// R1-mätningen visade att den gamla arSaljbar-gaten (genereraUtkast +
// en konservativ profil) öppnade för 93 bidrag i hela basen, alla av
// EXAKT samma skäl (en kravrad råkade vara en bar sätesmening) —
// okorrelerat med kommunens datakvalitet, och utan att säga något om
// föreningen. arBidragSaljbart (kommunKlar.ts) ersätter den med samma
// tre rader som KLAR 1-3: krav_status kontrollast, minst tre krav,
// krav_fullstandiga true. Ren datakvalitet på BIDRAGET, ingen profil,
// ingen genereraUtkast-körning här längre — samma spärr delas nu med
// checkout/bidragsutkast.ts och utkastsidans kopram/bevaka-val.
// F8 (2026-08-12, Jacob): F②:s ankringsrad fanns bara på utkastvyn — EFTER
// köpbeslutet, inte före. Köprutan HÄR (station 5) är den faktiska
// beslutspunkten (samma KOPRUTA-konstant, samma länk till utkastvyn).
// Kräver kontrollast OCH att beloppet är ett rent tal, inte en formel/
// pool (F8-fyndet på just den här kandidaten: "Bestäms utifrån kommunens
// totalbelopp och antal deltagaraktiviteter" — samma regel som
// förstasidans svarsyta, beloppArEttEnkeltTal, kommunTyper.ts).
const vardeankring = (bidrag: Kommun['bidrag'][number]) =>
  bidrag.belopp_status === 'kontrollast' && beloppArEttEnkeltTal(bidrag) !== null
    ? fyllKopruta(KONVERTERINGSSTAPEL.vardeankring, bidrag.namn).replace('{belopp}', individuelltBelopp(bidrag) ?? '')
    : null;

const arSaljbar = arBidragSaljbart;

type Station5Entry = { beskrivning: string; href: string; vardeankring: string | null } | null;
const station5PerFilter: Record<string, Station5Entry> = Object.fromEntries(
  filterValues.map((filter) => {
    const kandidat = bidragForFilter(filter).find((k) => arSaljbar(k.bidrag));
    if (!kandidat) return [filter, null];
    return [filter, {
      beskrivning: fyllKopruta(kopRutaBeskrivningMall, kandidat.bidrag.namn),
      href: `/kommun/${kommun.kommun_slug}/utkast/${kandidat.bidrag.id}/`,
      vardeankring: vardeankring(kandidat.bidrag),
    }];
  })
);
const station5Alla = station5PerFilter.alla;

// F8: F①:s fallback — kommun-scopat (inte bidrag-scopat, samma köpruta
// oavsett vilken D1-kandidat filtret råkar visa), server-sant genast,
// samma arbetsbevis-tal som utkastvyn och förstasidan (EN räkning).
const socialtBevisFallback = FORSTASIDAN_SVARAR.bevisMall
  .replace('{bidrag}', beraknaArbetsbevis(loadKommuner()).totalBidrag.toLocaleString('sv-SE'))
  .replace('{kontrollasta}', beraknaArbetsbevis(loadKommuner()).kontrollastAntal.toLocaleString('sv-SE'));

// ÅTGÄRDSSPEC punkt 1 (Jacob, 2026-08-03 kväll): D1 gör köprutan tom
// överallt just nu (noll bidrag är krav_status: verifierad ännu) —
// "bevakningsrutan" (VantelistaFlode, samma mekanik som fanns innan
// utkastvyn gick live 2026-07-31, se filhuvudets historik ovan) fyller
// tomrummet i stället för att stationen bara visar en tom yta. Kandidat
// = FÖRSTA bidraget i filtret, oavsett D1 — bevakningen ställer inget
// krav på verifierad kravdata, den bara loggar intresse (kommun+bidrag
// → extraktionskön, se vantelista.ts). Visas BARA där köprutan INTE
// redan visas (D1-kandidat saknas för filtret).
const station5BevakaPerFilter: Record<string, ReturnType<typeof bidragForFilter>[number] | null> = Object.fromEntries(
  filterValues.map((filter) => {
    if (station5PerFilter[filter]) return [filter, null]; // köprutan täcker redan detta filter
    return [filter, bidragForFilter(filter)[0] ?? null];
  })
);
---
<div class="progression" data-kommun-slug={kommun.kommun_slug} data-kommun-namn={kommun.kommun}>
  {/* D6 (ARBETSORDER 2026-08-11, mock 9f): A:s enda strandade drag,
     "Börja med godkännandet" — den numrerade tidslinjens fem cirkelmarkörer
     (1-5) är borta, det här ledande blocket ersätter dem som stationens
     framtoning. Text ordagrant ur mocken. */}
  <div class="progression__lead">
    <span class="progression__lead-titel">Börja med godkännandet</span>
    <span class="progression__lead-text">tar tid — det stoppar de flesta</span>
  </div>

  <!-- STATION 1 — stor: gaffeln -->
  <div class="progression__station progression__station--1">
    <div class="progression__eyebrow progression__eyebrow--accent">börjar er ansökan</div>
    <h2>{VAGLEDNING.station1.rubrik}</h2>
    <p class="progression__lede">{VAGLEDNING.station1.intro}</p>
    <div class="progression__pills" role="group" aria-label={VAGLEDNING.station1.rubrik}>
      <button type="button" class="progression__pill is-active" data-filter-pill="alla">Alla</button>
      {kategorierMedBidrag.map((k) => (
        <a href={`/kommun/${kommun.kommun_slug}/${k}/`} class="progression__pill" data-filter-pill={k}>{KATEGORI_LABELS[k]}</a>
      ))}
    </div>
    {kategorierMedBidrag.map((k) => (
      <div class="progression__saved" data-filter-value={k} hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
        {VAGLEDNING.station1.sparatText.replace('{typ}', KATEGORI_LABELS[k].toLowerCase())}
      </div>
    ))}
  </div>

  <!-- STATION 2 — liten, skarp: brådska -->
  <div class="progression__station">
    <h3>{VAGLEDNING.station2.rubrik}</h3>
    <div class="progression__urgent-row" data-progression-urgent-row hidden={!station2Alla}>
      <span data-chip-urgency="urgent" hidden={station2Alla?.urgency !== 'urgent'}><UrgencyChip urgency="urgent" /></span>
      <span data-chip-urgency="attention" hidden={station2Alla?.urgency !== 'attention'}><UrgencyChip urgency="attention" /></span>
      <span data-chip-urgency="positive" hidden={station2Alla?.urgency !== 'positive'}><UrgencyChip urgency="positive" /></span>
      <div class="progression__urgent-row__text">
        <div class="progression__urgent-row__namn" data-progression-urgent-namn>{station2Alla?.namn}</div>
        <div class="progression__urgent-row__datum" data-progression-urgent-datum>{station2Alla?.datumText}</div>
      </div>
      <a href={station2Alla?.href ?? '#'} data-progression-urgent-lank>Öppna →</a>
    </div>
    <p class="progression__lede" data-progression-urgent-empty hidden={!!station2Alla}>{VAGLEDNING.station2.introUtanDeadline}</p>
    {/* R5.1 (OMFORDELA_TEXTMASSAN.md runda 5): "hela listan" fällbar —
       samma underlag som station 4 (sortedBidrag), bara datumsatta
       bidrag, ett kompakt namn+datum per rad. Icke filterreaktiv med
       avsikt (station 4 äger det filtrerade, kanoniska läget) — det här
       är en snabb överblick utan att lämna station 2. */}
    {sortedBidrag.filter((e) => e.dateISO).length > 1 && (
      <details class="progression__disclosure">
        <summary class="progression__slutsats">
          <span class="progression__slutsats-text">Visa alla datumsatta bidrag</span>
          <svg class="progression__slutsats-chevron" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        </summary>
        <ul class="progression__fallbart progression__bradska-lista">
          {sortedBidrag.filter((e) => e.dateISO).map(({ bidrag, dateISO }) => (
            <li>
              <a href={`#bidrag-${bidrag.id}`}>{bidrag.namn}</a>
              <span class="progression__bradska-lista__datum">{formatDate(dateISO!)}</span>
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>

  <!-- STATION 3 — attention-ton: förutsättningar -->
  <div class="progression__station">
    <div class="progression__eyebrow progression__eyebrow--attention">gör detta först</div>
    <h3>{VAGLEDNING.station3.rubrik}</h3>
    {forutsattningar.length === 0 ? (
      <p class="progression__lede">{VAGLEDNING.station3.inget.replace('{kommun}', kommun.kommun)}</p>
    ) : (
      <>
        {/* R5.1+R5.5 (OMFORDELA_TEXTMASSAN.md runda 5): synlig slutsatsrad
           (förkravets namn — samma text som redan var
           .progression__forutsattning-titel) + fällbar prosa. Draget
           (attention-fältet nedan) ligger UTANFÖR fällningen — det är
           stationens enda framträdande knapp och ska alltid synas. */}
        <details class="progression__disclosure">
          <summary class="progression__slutsats">
            <span class="progression__slutsats-text">{forsta.vad}</span>
            <svg class="progression__slutsats-chevron" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
          </summary>
        <p class="progression__lede progression__fallbart">{VAGLEDNING.station3.intro.replace('{kommun}', kommun.kommun)}</p>
        <div class="progression__forutsattningar">
          <div class="progression__forutsattning">
            <span class="progression__forutsattning-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg></span>
            <div>
              <div class="progression__forutsattning-label">Förkrav</div>
              <div class="progression__forutsattning-titel">{forsta.vad}</div>
              {forstaKanDelas ? (
                <>
                  <div class="progression__checklista-label">
                    {VAGLEDNING.station3.checklistaLabel}
                    <span data-checklista-count>0 / {forstaPunkter.length}</span>
                  </div>
                  <ul class="progression__checklista" data-checklista>
                    {forstaPunkter.map((punkt) => (
                      <li>
                        <label class="progression__checklista-item">
                          <input type="checkbox" data-checklista-box />
                          <span>{punkt}</span>
                        </label>
                      </li>
                    ))}
                  </ul>
                  <div class="progression__forutsattning-text">
                    {forsta.ledtid !== null
                      ? VAGLEDNING.station3.ledtidKand.replace('{ledtid}', String(forsta.ledtid))
                      : VAGLEDNING.station3.ledtidOkand.replace(/{kommun}/g, kommun.kommun)}
                  </div>
                </>
              ) : (
                <div class="progression__forutsattning-text">
                  {forsta.beskrivning}{' '}
                  {forsta.ledtid !== null
                    ? VAGLEDNING.station3.ledtidKand.replace('{ledtid}', String(forsta.ledtid))
                    : VAGLEDNING.station3.ledtidOkand.replace(/{kommun}/g, kommun.kommun)}
                </div>
              )}
            </div>
          </div>
          {forsta.giltighet && (
            <div class="progression__forutsattning">
              <span class="progression__forutsattning-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4" /><path d="M12 17h.01" /><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /></svg></span>
              <div>
                <div class="progression__forutsattning-label">Giltighetsfälla</div>
                <div class="progression__forutsattning-text">{VAGLEDNING.station3.giltighetVarning.replace('{giltighet}', forsta.giltighet)}</div>
              </div>
            </div>
          )}
          {extra.map((f) => (
            <>
              <div class="progression__forutsattning">
                <span class="progression__forutsattning-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg></span>
                <div>
                  <div class="progression__forutsattning-label">Ytterligare steg</div>
                  <div class="progression__forutsattning-titel">{f.vad}</div>
                  <div class="progression__forutsattning-text">{VAGLEDNING.station3.extraSteg.replace('{beskrivning}', f.beskrivning)}</div>
                </div>
              </div>
              {/* Bugg hittad 2026-08-02 (1f Yta 2-verifiering): en förutsättnings
                  giltighet renderades bara om den satt på forutsattningar[0] —
                  Helsingborgs regel sitter på [1] och försvann tyst. Samma
                  giltighetsfälla-block som ovan, nu även för extra-stegen. */}
              {f.giltighet && (
                <div class="progression__forutsattning">
                  <span class="progression__forutsattning-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4" /><path d="M12 17h.01" /><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /></svg></span>
                  <div>
                    <div class="progression__forutsattning-label">Giltighetsfälla</div>
                    <div class="progression__forutsattning-text">{VAGLEDNING.station3.giltighetVarning.replace('{giltighet}', f.giltighet)}</div>
                  </div>
                </div>
              )}
            </>
          ))}
        </div>
        {bilagor.length > 0 && (
          <details class="progression__bilagor">
            <summary>{VAGLEDNING.station3.bilagorLabel}</summary>
            <ul>
              {bilagor.map((b) => <li>{b.etikett}</li>)}
            </ul>
          </details>
        )}
        </details>
        {/* R5.5 (OMFORDELA_TEXTMASSAN.md runda 5, avvikelse mot Designs
           tabell): "köp 249 kr" ersatt av vägledning tills beslut A
           (registreringschecklistan som produkt) är fattat — sidans
           enda framträdande knapp får inte peka mot något som inte går
           att köpa. Länkar till kommunens EGEN källa, inte /registrera/.
           R5.3: detta är sidans ENDA färgade drag — station 5:s knappar
           är därför nedtonade (se längre ner). */}
        <div class="progression__attention-cta">
          <a href={kommun.kalla_url} class="btn-primary progression__attention-cta__knapp" target="_blank" rel="noopener">
            {VAGLEDNING.station3.attentionKnappMall.replace('{kommun}', kommun.kommun)}
          </a>
        </div>
      </>
    )}
  </div>

  <!-- STATION 4 — pekare till registret -->
  {/* D2.2 (2026-08-12, Jacob): "bidragen visas på fyra ställen ...
     station 4, registret. Efter: två." Den fullständiga kronologiska
     listan (två öppna rader + "visa alla resten") TAGEN BORT härifrån
     — samma sortedBidrag som registret redan visar, grupperat annorlunda
     men samma 14 bidrag, samma namn. Station 2 (ovan) täcker redan "det
     mest brådskande" som en riktig förhandsvisning (namn+datum+länk) —
     station 4 behöver inte UPPREPA hela listan för att peka mot den,
     bara länka dit. #sista-ansokningsdatum-ankaret (EKERN.band3Lank2)
     oförändrat, landar nu på pekaren i stället för listan. */}
  <div class="progression__station" id="sista-ansokningsdatum">
    <h3>{VAGLEDNING.station4.rubrik}</h3>
    {/* Q1 — "alla" bara när kommunen klarar 9/9, se filhuvudet. */}
    <a href="#alla-bidrag" class="progression__station4-lank">{klar9av9 ? `Visa alla ${sortedBidrag.length} ↓` : `Visa ${sortedBidrag.length} ↓`}</a>
  </div>

  <!-- STATION 5 — mål -->
  <div class="progression__station progression__station--5">
    <div class="progression__goal">
      <div class="progression__eyebrow" style="color: rgba(255,255,255,.85);">vägens slut</div>
      <h3>{VAGLEDNING.station5.rubrik}</h3>
      {/* R5.4 (avvikelse mot Designs tabell): "Vi skriver utkastet åt
         er" är borttaget ur produktion sedan P1.2/P1.5 (2026-08-04/05),
         "utkast" bytt mot "underlag" på hela ytan. Synlig rad återanvänder
         VAGLEDNING.station5.ansvar ordagrant — samma text som redan låg
         som en tyst rad längst ner, nu stationens ledande besked i
         stället för intro-frågan. */}
      <p class="progression__lede" style="color: rgba(255,255,255,.92);">{VAGLEDNING.station5.ansvar}</p>
      {/* R5.3: station 3 äger sidans enda färgade drag — kopruta-knappen
         och VantelistaFlodes knapp är därför tysta (fg-btn--ghost), inte
         btn-primary. */}
      <div class="progression__kopruta" data-progression-kopruta hidden={!station5Alla}>
        <h4 class="progression__kopruta-rubrik">{KOPRUTA.rubrik}</h4>
        <p data-progression-kopruta-beskrivning>{station5Alla?.beskrivning}</p>
        <p>{KOPRUTA.leverans}</p>
        <p>{kopRutaPrisOchKvitto}</p>
        {/* F② (F8) — bara när D1-kandidaten har ett kontrollast belopp. */}
        <p class="progression__kopruta-vardeankring" data-progression-kopruta-vardeankring hidden={!station5Alla?.vardeankring}>{station5Alla?.vardeankring}</p>
        <p class="progression__kopruta-aterbetalning">{KOPRUTA.aterbetalning}</p>
        {/* M3 (Jacob 2026-08-17): F① flyttad hit, intill köpet — låg
           tidigare mellan rubriken och leveransbeskrivningen och lästes
           som en punkt i "vad ni får" i stället för socialt bevis för
           själva köpet. F① (F8, 2026-08-12) — server-sant genast,
           klientskriptet uppgraderar till kommunens köpantal om det når
           SOCIALT_BEVIS_GOLV. */}
        <p class="progression__kopruta-socialt-bevis" data-progression-kopruta-socialt-bevis>{socialtBevisFallback}</p>
        <a href={station5Alla?.href ?? '#'} class="fg-btn--ghost progression__goal-cta" data-progression-kopruta-cta>
          Lås upp hela checklistan — {prisKr} kr
        </a>
      </div>
      {filterValues.map((filter) => {
        const kandidat = station5BevakaPerFilter[filter];
        if (!kandidat) return null;
        return (
          <div data-progression-bevaka-filter={filter} hidden={filter !== 'alla'}>
            <VantelistaFlode kommun={kommun} bidrag={kandidat.bidrag} />
          </div>
        );
      })}
    </div>
  </div>

<script type="application/json" data-progression-per-filter set:html={JSON.stringify({ station2: station2PerFilter, station5: station5PerFilter })} />
</div>

<script>
  import { hamtaKopantal, arOverSocialtBevisGolv } from '../lib/kopKlient';
  import { KONVERTERINGSSTAPEL } from '../lib/content';

  // Kategori-pillren är riktiga <a href="/kommun/slug/kategori/">-länkar
  // (crawlbarhet, SOKBARHETSSPEC §2.2 — inga föräldralösa sidor). Vanligt
  // klick filtrerar på plats istället för att navigera; ctrl/cmd/mittklick
  // fungerar som vanligt (öppnar kategorisidan i ny flik).
  const pills = document.querySelectorAll<HTMLAnchorElement | HTMLButtonElement>('[data-filter-pill]');
  const listRows = document.querySelectorAll<HTMLLIElement>('.progression__list [data-kategori]');
  // savedRows (station 1) är sedan 2026-07-31 den ENDA kvarvarande
  // "en kopia per filter"-strukturen — station 2/5 gick över till
  // en-kopia-bytt-via-JS (se station2PerFilter/station5PerFilter,
  // FIX-kommentaren i frontmatter). Ett tidigare `filterTargets`
  // (`[data-filter-value]` utan `.progression__saved`-prefix) blev
  // dött/redundant av samma ändring — dess loop skrevs alltid över av
  // savedRows-loopen nedan (samma element, körd sist) — borttaget.
  const savedRows = document.querySelectorAll<HTMLElement>('.progression__saved[data-filter-value]');
  const hiddenNote = document.querySelector<HTMLElement>('[data-hidden-note]');

  // Station 2/5 — per-filter-data (FIX 2026-07-31, se KommunProgression.astro
  // frontmatter). En JSON-blob istället för N renderade DOM-kopior.
  const perFilterEl = document.querySelector<HTMLScriptElement>('[data-progression-per-filter]');
  const perFilterData: { station2: Record<string, any>; station5: Record<string, any> } = perFilterEl
    ? JSON.parse(perFilterEl.textContent ?? '{}')
    : { station2: {}, station5: {} };

  const urgentRow = document.querySelector<HTMLElement>('[data-progression-urgent-row]');
  const urgentEmpty = document.querySelector<HTMLElement>('[data-progression-urgent-empty]');
  const urgentNamn = document.querySelector<HTMLElement>('[data-progression-urgent-namn]');
  const urgentDatum = document.querySelector<HTMLElement>('[data-progression-urgent-datum]');
  const urgentLank = document.querySelector<HTMLAnchorElement>('[data-progression-urgent-lank]');
  const chipSpans = document.querySelectorAll<HTMLElement>('[data-chip-urgency]');

  function updateStation2(value: string) {
    const entry = perFilterData.station2?.[value];
    if (!urgentRow || !urgentEmpty) return;
    urgentRow.hidden = !entry;
    urgentEmpty.hidden = !!entry;
    if (!entry) return;
    chipSpans.forEach((span) => {
      span.hidden = span.dataset.chipUrgency !== entry.urgency;
    });
    if (urgentNamn) urgentNamn.textContent = entry.namn;
    if (urgentDatum) urgentDatum.textContent = entry.datumText;
    if (urgentLank) urgentLank.href = entry.href;
  }

  const kopruta = document.querySelector<HTMLElement>('[data-progression-kopruta]');
  const kopRutaBeskrivning = document.querySelector<HTMLElement>('[data-progression-kopruta-beskrivning]');
  const kopRutaCta = document.querySelector<HTMLAnchorElement>('[data-progression-kopruta-cta]');
  const kopRutaVardeankring = document.querySelector<HTMLElement>('[data-progression-kopruta-vardeankring]');
  // ÅTGÄRDSSPEC punkt 1: bevakningsrutorna är statiskt SSR-renderade, en
  // per filter som saknar D1-kandidat (se station5BevakaPerFilter) —
  // ingen text att uppdatera via JS, bara vilken som visas.
  const bevakaRutor = document.querySelectorAll<HTMLElement>('[data-progression-bevaka-filter]');

  function updateStation5(value: string) {
    const entry = perFilterData.station5?.[value];
    if (kopruta) kopruta.hidden = !entry;
    if (kopRutaBeskrivning && entry) kopRutaBeskrivning.textContent = entry.beskrivning;
    if (kopRutaCta && entry) kopRutaCta.href = entry.href;
    if (kopRutaVardeankring) {
      kopRutaVardeankring.hidden = !entry?.vardeankring;
      if (entry?.vardeankring) kopRutaVardeankring.textContent = entry.vardeankring;
    }
    bevakaRutor.forEach((el) => {
      el.hidden = el.dataset.progressionBevakaFilter !== value;
    });
  }

  function applyFilter(value: string) {
    pills.forEach((p) => p.classList.toggle('is-active', p.dataset.filterPill === value));

    savedRows.forEach((el) => {
      el.hidden = value === 'alla' || el.dataset.filterValue !== value;
    });
    updateStation2(value);
    updateStation5(value);

    let hiddenCount = 0;
    listRows.forEach((row) => {
      const matches = value === 'alla' || (row.dataset.kategori ?? '').split(' ').includes(value);
      row.hidden = !matches;
      if (!matches) hiddenCount++;
    });

    if (hiddenNote) {
      hiddenNote.hidden = hiddenCount === 0;
      if (hiddenCount > 0) {
        hiddenNote.textContent = `${hiddenCount} bidrag gäller andra sorters föreningar och är dolda. `;
        const visaAnda = document.createElement('button');
        visaAnda.type = 'button';
        visaAnda.className = 'progression__link-button';
        visaAnda.textContent = 'Visa ändå';
        visaAnda.addEventListener('click', () => applyFilter('alla'));
        hiddenNote.appendChild(visaAnda);
      }
    }
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', (event) => {
      const isModifiedClick = event instanceof MouseEvent && (event.metaKey || event.ctrlKey || event.button === 1);
      if (pill.tagName === 'A' && !isModifiedClick) event.preventDefault();
      applyFilter(pill.dataset.filterPill ?? 'alla');
    });
  });

  applyFilter('alla');

  // F① (F8, 2026-08-12) — köprutans egen socialt bevis-rad, oberoende av
  // vilket filter/D1-kandidat som visas (kommun-scopat, inte bidrag-
  // scopat). Fallbacken (arbetsbeviset) står redan där, server-sant —
  // samma tysta uppgradering som utkastvyn, aldrig en tom rad medan
  // fetchen pågår.
  const progressionRoot = document.querySelector<HTMLElement>('.progression[data-kommun-slug]');
  const socialtBevisEl = progressionRoot?.querySelector<HTMLElement>('[data-progression-kopruta-socialt-bevis]');
  if (progressionRoot && socialtBevisEl) {
    const kommunSlug = progressionRoot.dataset.kommunSlug ?? '';
    const kommunNamn = progressionRoot.dataset.kommunNamn ?? kommunSlug;
    hamtaKopantal(kommunSlug).then((antal) => {
      if (antal === null || !arOverSocialtBevisGolv(antal)) return;
      socialtBevisEl.textContent = KONVERTERINGSSTAPEL.socialtBevis.replace('{antal}', String(antal)).replace('{kommun}', kommunNamn);
    });
  }

  // 1d — checklistans räknare. Rent klientläge, ingen persistens (bocken
  // markerar "jag har gjort det här nu", inte en profil att komma ihåg
  // mellan besök — annat register än bevaka-knappens localStorage-minne).
  document.querySelectorAll<HTMLElement>('[data-checklista]').forEach((lista) => {
    const countEl = lista.previousElementSibling?.querySelector<HTMLElement>('[data-checklista-count]');
    const boxes = lista.querySelectorAll<HTMLInputElement>('[data-checklista-box]');
    const total = boxes.length;

    function updateCount() {
      if (!countEl) return;
      const bockade = Array.from(boxes).filter((b) => b.checked).length;
      countEl.textContent = `${bockade} / ${total}`;
    }

    boxes.forEach((box) => box.addEventListener('change', updateCount));
  });
</script>
