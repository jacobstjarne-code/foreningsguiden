---
// Om/metod — §5 punkt 5 UPPDRAG_POC.md. Förtroendesidan: vilka vi är, hur
// datat verifieras, källpolicy. Motsvarar Bandy Brains metodredovisning.
// OM.stycken (content.ts) är skriven som löpande stycken under H1, inte
// under egna h2-rubriker — Code följer den strukturen Fable faktiskt levererade.
import Base from '../../layouts/Base.astro';
import BreadcrumbList from '../../components/BreadcrumbList.astro';
import { OM, BETA } from '../../lib/content';
import { loadKommuner, formatDate } from '../../lib/kommuner';

const kommuner = loadKommuner();
const antalKommuner = kommuner.length;
// C2 (ÅTGÄRDSSPEC, 2026-08-03 kväll): värsta-fallet flyttat hit från
// förstasidan — samma beräkning som innan (det ÄLDSTA verifierad-datumet
// över alla kommuner, inte det nyaste — cherry-plockar annars den bäst
// avlästa kommunen).
const senastAvlast = kommuner.reduce((min, k) => (k.verifierad < min ? k.verifierad : min), kommuner[0]?.verifierad ?? '');
---
<Base title={OM.metaTitle} description={OM.metaDescription}>
  <BreadcrumbList items={[
    { name: 'Startsida', url: '/' },
    { name: 'Om', url: '/om/' },
  ]} />

  <h1>{OM.h1}</h1>

  {OM.stycken.map((stycke) => <p>{stycke}</p>)}
  {senastAvlast && <p>{OM.senastAvlastRad.replace('{datum}', formatDate(senastAvlast))}</p>}

  <section>
    <h2>{OM.ansvarRubrik}</h2>
    {OM.ansvarStycken.map((stycke) => <p>{stycke}</p>)}
  </section>

  {/*
    H1-sektionen (avsändare/org.nr) döljs för besökare tills juridisk
    part är vald (Jacob, 2026-07-27: inte bra att den ligger öppen).
    Denna kommentarform strippas helt vid bygge, syns inte ens i
    sidans källkod. content.ts-texten (OM.avsandarRubrik och
    OM.avsandarStycken, {foretag}/{orgnr} ur SALJARE) ligger kvar orörd,
    redo att visas igen när partsvalet är klart — idag är SALJARE
    fortfarande sandbox-testvärdet "Humle och Dumle AB", inte den
    riktiga juridiska parten (SPEC: Betalintegration §6 steg 3).

    <section>
      <h2>{OM.avsandarRubrik}</h2>
      {OM.avsandarStycken.map((stycke) => (
        <p>{stycke.replace('{foretag}', SALJARE.foretag).replace('{orgnr}', SALJARE.orgnr)}</p>
      ))}
    </section>
  */}

  <section>
    <h2>{BETA.omRubrik}</h2>
    {BETA.omStycken.map((stycke) => <p>{stycke.replace('{antalKommuner}', String(antalKommuner))}</p>)}
  </section>
</Base>
