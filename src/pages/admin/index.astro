---
// Adminvy — Grind 2 (GRANSKNING_foreningsguiden.md): "Skyddad sida som
// listar Redis: registrerade, köp... Minimal men läsbar, så du slipper
// Upstash-dashboarden." Egen auth (adminSession.ts, delat lösenord) —
// skild från användarnas magic-link (session.ts). Abonnemangsstatus
// (SPEC_ABONNEMANG.md) tillagd 2026-07-27. noindex — internt verktyg,
// inte en sida sajten ska indexeras för.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { ADMIN_SESSION_COOKIE_NAMN, arAdminInloggad } from '../../lib/adminSession';
import { getAllSubscribers } from '../../lib/subscribers';
import { hamtaAllaKop } from '../../lib/kop';
import { hamtaAllaAbonnemang } from '../../lib/abonnemang';
import { hamtaAllaKommunEfterfragningar } from '../../lib/kommunefterfragan';
import { formatDate } from '../../lib/kommuner';
import { hamtaAllaSignaturer, hamtaPrioriteradKo } from '../../lib/omverifiering';
import { OMVERIFIERING_MAX_KONSEKUTIVA_FEL } from '../../lib/omverifieringLogik';

const sessionToken = Astro.cookies.get(ADMIN_SESSION_COOKIE_NAMN)?.value;
const inloggad = await arAdminInloggad(sessionToken);
const felaktigtLosenord = Astro.url.searchParams.get('fel') === '1';

const subscribers = inloggad ? await getAllSubscribers() : [];
const kop = inloggad ? await hamtaAllaKop() : [];
const abonnemang = inloggad ? await hamtaAllaAbonnemang() : [];
const kommunefterfragningar = inloggad ? await hamtaAllaKommunEfterfragningar() : [];
const omverifieringSignaturer = inloggad ? await hamtaAllaSignaturer() : [];
const omverifieringKo = inloggad ? await hamtaPrioriteradKo() : [];
const omverifieringOtillgangliga = omverifieringSignaturer.filter((s) => s.senasteUtfall === 'otillganglig');
const omverifieringManuellOversyn = omverifieringOtillgangliga.filter((s) => s.konsekutivaFel >= OMVERIFIERING_MAX_KONSEKUTIVA_FEL);
const summaKr = kop.reduce((sum, k) => sum + k.beloppOre, 0) / 100;
const aktivaAbonnemang = abonnemang.filter((a) => a.status === 'active').length;

// H19 — utfallsaggregatet ("41 av 52 beviljade"). Räknat direkt ur
// kop:s utfall[]-fält, ingen egen lagring — adminvyn ÄR läsytan tills
// ett publikt social proof-läge byggs (inte beställt i detta pass).
const utfall = kop.flatMap((k) => k.utfall ?? []);
const utfallBeviljat = utfall.filter((u) => u.svar === 'beviljat').length;
const utfallAvslag = utfall.filter((u) => u.svar === 'avslag').length;
const utfallVetInte = utfall.filter((u) => u.svar === 'vet_inte').length;
---
<Base title="Admin — Föreningsguiden" description="Internt adminverktyg." noindex={true}>
  <h1>Admin</h1>

  {!inloggad ? (
    <>
      {felaktigtLosenord && <p class="fg-fel">Fel lösenord.</p>}
      <form class="email-signup fg-card" method="POST" action="/api/admin-logga-in">
        <label for="admin-losenord">Lösenord</label>
        <input type="password" id="admin-losenord" name="losenord" required />
        <button type="submit" class="btn-primary">Logga in</button>
      </form>
    </>
  ) : (
    <div class="mina-sidor">
      <section>
        <h2>Sammanfattning</h2>
        <ul class="mina-sidor__profil">
          <li>{subscribers.length} prenumeranter</li>
          <li>{kop.length} köp — {summaKr.toFixed(0)} kr totalt</li>
          <li>{aktivaAbonnemang} aktiva abonnemang ({abonnemang.length} totalt)</li>
          <li>Utfall: {utfallBeviljat} beviljat, {utfallAvslag} avslag, {utfallVetInte} vet inte än ({utfall.length} svar totalt)</li>
        </ul>
      </section>

      <section>
        <h2>Abonnemang</h2>
        {abonnemang.length === 0 ? (
          <p>Inga abonnemang än.</p>
        ) : (
          <ul class="mina-sidor__kop">
            {abonnemang.map((a) => (
              <li>
                <strong>{a.email}</strong> — {a.status} — gäller till {formatDate(a.giltigTill)}
              </li>
            ))}
          </ul>
        )}
      </section>

      <section>
        <h2>Prenumeranter</h2>
        {subscribers.length === 0 ? (
          <p>Inga prenumeranter än.</p>
        ) : (
          <ul class="mina-sidor__kop">
            {subscribers.map((s) => (
              <li>
                <strong>{s.email}</strong> — {s.kommuner.join(', ') || 'inga kommuner'} — {s.confirmed ? 'bekräftad' : 'obekräftad'}
                {s.foreningsprofil && <> — {s.foreningsprofil.verksamhet.join('/')}</>}
              </li>
            ))}
          </ul>
        )}
      </section>

      <section>
        <h2>Köp</h2>
        {kop.length === 0 ? (
          <p>Inga köp än.</p>
        ) : (
          <ul class="mina-sidor__kop">
            {kop.map((k) => (
              <li>
                <strong>{(k.beloppOre / 100).toFixed(0)} kr</strong> — {formatDate(k.betaldDatum.slice(0, 10))} — {k.email} — {k.kommunSlug}
                {' '}— <em>{k.produkt === 'bidragsutkast' ? `bidragsutkast (${k.bidragId})` : 'registrering'}</em>
                {k.hostedInvoiceUrl && <> — <a href={k.hostedInvoiceUrl}>Faktura</a></>}
                {k.utfall && k.utfall.length > 0 && (
                  <> — utfall: {k.utfall.map((u) => `${u.bidragNamn}: ${u.svar}`).join(', ')}</>
                )}
              </li>
            ))}
          </ul>
        )}
      </section>

      <section>
        <h2>Kommunefterfrågningar</h2>
        <p>H4 — prioriteringsdata för nästa extraktionsbatch, sorterat per kommun.</p>
        {kommunefterfragningar.length === 0 ? (
          <p>Inga efterfrågningar än.</p>
        ) : (
          <ul class="mina-sidor__kop">
            {kommunefterfragningar.map((k) => (
              <li>
                <strong>{k.kommunSlug}</strong> — {k.email} — {formatDate(k.registrerad.slice(0, 10))}
              </li>
            ))}
          </ul>
        )}
      </section>

      <section>
        <h2>Omverifiering</h2>
        <p>
          {omverifieringSignaturer.length} källor spårade —
          {omverifieringKo.length} flaggade (ändrade eller otillgängliga),
          {omverifieringOtillgangliga.length} otillgängliga just nu
          ({omverifieringManuellOversyn.length} i {OMVERIFIERING_MAX_KONSEKUTIVA_FEL}+ försök i rad — manuell översyn).
        </p>
        {omverifieringKo.length === 0 ? (
          <p>Inget flaggat än.</p>
        ) : (
          <ul class="mina-sidor__kop">
            {omverifieringKo.map((k) => (
              <li>
                <strong>{k.senasteUtfall === 'andrad' ? 'Ändrad' : 'Otillgänglig'}</strong>
                {' — '}
                {k.bidrag.length > 0
                  ? k.bidrag.map((b) => `${b.kommun}: ${b.bidragNamn}`).join(', ')
                  : k.url}
                {' — '}
                {k.senastLyckad
                  ? `senast lyckad kontroll ${formatDate(k.senastLyckad.slice(0, 10))}`
                  : 'aldrig lyckad kontroll'}
                {k.konsekutivaFel > 0 && <> — {k.konsekutivaFel} misslyckade försök i rad</>}
                {' — '}<a href={k.url}>{k.url}</a>
                <form method="POST" action="/api/admin-omverifiering-avfarda">
                  <input type="hidden" name="url" value={k.url} />
                  <button type="submit" class="fg-btn--ghost">Avfärda (falsklarm)</button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </section>

      <form method="POST" action="/api/admin-logga-ut">
        <button type="submit" class="btn-primary">Logga ut</button>
      </form>
    </div>
  )}
</Base>
