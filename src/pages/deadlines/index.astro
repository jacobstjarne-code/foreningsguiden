---
// Deadlinekalender — §5 punkt 4 UPPDRAG_POC.md: sajtens unika yta, samtliga
// deadlines kronologiskt, filtrerbar på kommun/kategori. E-postregistreringen
// sitter här. Enda sidan som behöver klient-JS (§7: "inga klientberoenden
// utöver vad kalenderfiltret kräver").
// prerender=false — sidan behöver läsa ?bevakning=klar vid request-tid för
// att växla EmailSignup till kvitto-läge (en statiskt byggd sida kan aldrig
// se en query-sträng som bara finns i den faktiska förfrågan).
//
// Månadsgruppering + Läge-kolumnen bort + primär kategori + belopp
// (SPEC_DEADLINEKALENDER.md, Design N2/N3:3 27 juli): hundratals rader i en
// platt tabell var oläsbart, och "God tid" upprepad rad efter rad bar noll
// information. Disclosure via NATIVA <details>/<summary> — samma mönster
// som KommunValjare.astro:s länslista på förstasidan — barnen ligger kvar
// i DOM oavsett öppet/stängt (kollapsat = CSS-dolt, aldrig borttaget), så
// crawlers och webbläsarens sidsökning hittar raderna ändå. En <details>
// per månad, EN <table> per <details> (ett <table> kan inte innehålla en
// <details> runt sina rader — ogiltig HTML — därav tabell-per-månad i
// stället för en enda tabell med dolda tbody-grupper).
export const prerender = false;

import Base from '../../layouts/Base.astro';
import BreadcrumbList from '../../components/BreadcrumbList.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import UrgencyChip from '../../components/UrgencyChip.astro';
import {
  loadKommuner, getDeadlineEntries, formatDate, daysUntil, getUrgency, todayISO,
  manadNyckel, nastaManadNyckel, formatManadRubrik, parseBeloppTak,
  KATEGORI_LABELS, KATEGORIER,
} from '../../lib/kommuner';
import type { DeadlineEntry } from '../../lib/kommuner';
import { getNationellaDeadlineEntries } from '../../lib/nationellaStod';
import type { NationellDeadlineEntry } from '../../lib/nationellaStod';
import { KALENDER, BEVAKNING, OLAST_MARK } from '../../lib/content';
import { TRATT } from '../../../GUIDE_TRATT_COPY';

const bevakningStatus = Astro.url.searchParams.get('bevakning');
const submitted = bevakningStatus === 'klar';
const bekraftad = bevakningStatus === 'bekraftad';
const ogiltigtToken = bevakningStatus === 'ogiltig';
const uppdaterad = bevakningStatus === 'uppdaterad';
const kommuner = loadKommuner();
const today = todayISO();
type KalenderEntry = DeadlineEntry | NationellDeadlineEntry;
const arNationell = (e: KalenderEntry): e is NationellDeadlineEntry => e.niva === 'nationell';
const kommunEntries = getDeadlineEntries(today);
const entries: KalenderEntry[] = [...kommunEntries, ...getNationellaDeadlineEntries(today)].sort((a, b) => (a.dateISO ?? '').localeCompare(b.dateISO ?? ''));
const lopande = kommunEntries.filter((e) => e.isLopande);
const kommande = entries.filter((e) => !e.isLopande);

// P3.1a (Jacob 2026-08-05): raden i kalendern länkar hit med ?kommun=slug
// (se .bevaka-rad-knapp nedan) — SSR läser den server-sidan, samma
// mönster som ?bevakning= ovan, så EmailSignup.astro:s ruta för just den
// kommunen redan är förkryssad vid FÖRSTA render (ingen klient-JS-timing
// att lita på). Validerad mot kommuner.ts — en ogiltig/manipulerad
// slug ger bara "ingen förkryssning", aldrig ett fel.
const kommunFranRad = Astro.url.searchParams.get('kommun');
const preselectedKommunSlug = kommuner.some((k) => k.kommun_slug === kommunFranRad) ? (kommunFranRad ?? undefined) : undefined;

// AB1.1 (Jacobs order, revisionsfynd): "Ett kommunfilter visar 12 rader
// men hela rikets DOM ligger kvar" — ?kommun= satte tidigare bara
// EmailSignups förkryssning, aldrig vilka rader som RENDERADES. Samma
// param gör nu dubbel nytta: samma länk från alla "Bevaka"-knappar
// sajtsbrett (BevakaKommunen.astro, utkastvyn, denna sidas egna rader)
// scopar nu tabellerna server-sidan också. Nationella stöd är alltid
// kvar oavsett filter — de gäller varje kommun (samma regel klient-
// filtret redan hade, se applyFilter() i <script> nedan).
const kommunFilterSlug = preselectedKommunSlug ?? null;
const kommandeScoped = kommunFilterSlug
  ? kommande.filter((e) => arNationell(e) || e.kommunSlug === kommunFilterSlug)
  : kommande;
const lopandeScoped = kommunFilterSlug ? lopande.filter((e) => e.kommunSlug === kommunFilterSlug) : lopande;

const visaAlla = Astro.url.searchParams.get('visa') === 'alla';
const visarAllt = Boolean(kommunFilterSlug) || visaAlla;

// AB1.1: budget <1000 DOM-noder / <100KB rå HTML VID FÖRSTA LADDNING
// (mätt: 3,24 MB / ~13 700 taggar före denna fix — löpande-tabellen
// ensam stod för 1,22 MB/5 224 taggar, HELT ovillkorad). Ett FAST
// RADTAK, inte ett datumfönster — svenska bidragsdeadlines klustrar
// hårt kring vanliga läsårsdatum (LOK-stödets 25/2 och 25/8 träffar
// ~194 kommuner SAMMA DAG), så ett datumfönster kan fortfarande ge
// hundratals rader en dålig dag. Ett radtak håller budgeten oavsett
// kalenderklustring. Gäller bara det OSCOPADE, icke-"visa alla"-läget
// — en vald kommun eller en explicit "visa alla"-begäran är redan
// litet respektive ett medvetet undantag från budgeten.
const DEFAULT_TEASER_MAX = 20;
const kommandeForRender = visarAllt ? kommandeScoped : kommandeScoped.slice(0, DEFAULT_TEASER_MAX);
// Löpande saknar en naturlig "närmast"-ordning (inget datum att sortera
// på) — i bare-default-läget (ingen kommun, inte "visa alla") visas
// därför noll löpande-rader, bara en räkning + länk. Kommun-scopat
// eller "visa alla": alla löpande-rader för det scopet, redan litet.
const lopandeForRender = visarAllt ? lopandeScoped : [];

// TILLSTANDET_OLAST.md 4c yta 3: markören bär hela anspråket i kalenderrader
// (ingen plats för egen reservationstext) — "aldrig markör utan legend på
// samma sida" gäller alltså raka vägen hela kalendern, inte bara en flagga
// när just den öppna månaden råkar innehålla ett olast-datum. Kollar det
// FAKTISKT RENDERADE urvalet, inte hela landets — annars kan legenden visas
// (eller saknas) för en markering som besökaren aldrig ser.
const harOlastIKalendern = kommandeForRender.some((e) => e.deadlineStatus === 'olast');

// A1 (SPRINT: Produkten, Opus/Fable 2026-07-31): kalendern hade ingen
// verifieringsstämpel alls — enda ytan som inte sa när den lästes. Samma
// TRATT.start.senastAvlastRad-mening som förstasidan (en sanning, en
// källa, inte en ny formulering) — men beräknad över bara de kommuner
// som FAKTISKT förekommer i den här tabellen, inte alla 194 (en kommun
// utan aktiva bidrag bidrar aldrig en rad här och ska inte kunna dra ner
// datumet). Äldsta, inte senaste — samma resonemang som förstasidans fix.
const kommunSlugsMedDeadlines = new Set(kommunEntries.map((e) => e.kommunSlug));
const kommunerMedDeadlines = kommuner.filter((k) => kommunSlugsMedDeadlines.has(k.kommun_slug));
const senastAvlast = kommunerMedDeadlines.reduce(
  (min, k) => (k.verifierad < min ? k.verifierad : min),
  kommunerMedDeadlines[0]?.verifierad ?? today
);

// entries är redan globalt sorterade (getDeadlineEntries) — att gruppera
// via en Map bevarar kronologisk ordning automatiskt, ingen extra sort.
// Grupperar det FAKTISKT RENDERADE urvalet (kommandeForRender) — litet
// oavsett läge (teaser: ≤20, kommun-scopat: en handfull, "visa alla":
// medvetet obudgeterat) sedan AB1.1, till skillnad från den tidigare
// grupperingen av HELA landets kommande-lista.
const manadGrupper = new Map<string, KalenderEntry[]>();
for (const e of kommandeForRender) {
  const key = manadNyckel(e.dateISO!);
  const lista = manadGrupper.get(key) ?? [];
  lista.push(e);
  manadGrupper.set(key, lista);
}
const innevarandeManad = manadNyckel(today);
const nastaManad = nastaManadNyckel(innevarandeManad);

// P3.2 (Jacob 2026-08-05, reviderad AB1.1 2026-08-26): tidigare "de tre
// NÄRMASTE månadsgrupperna" — 691 rader/7 526 taggar i sig, före
// löpande-tabellen ens räknats in. manadGrupper bär nu redan bara det
// budgeterade urvalet (kommandeForRender), så ALLA dess månadsnycklar
// visas — ingen ytterligare .slice här, den riktiga begränsningen
// sitter i DEFAULT_TEASER_MAX ovan.
const synligaManadNycklar = [...manadGrupper.keys()];
const synligaManadGrupper = synligaManadNycklar.map((key) => [key, manadGrupper.get(key)!] as const);
const antalSynligaKommande = synligaManadGrupper.reduce((sum, [, rader]) => sum + rader.length, 0);
const antalTotaltKommande = kommandeScoped.length;
const antalTotaltLopande = lopandeScoped.length;

// Bevarar övriga query-parametrar (t.ex. ?kommun= från en radlänk) när
// vy-läget växlas — bara "visa" ska ändras av de här länkarna. Relativ
// path+search (inte hela URL:en) — fungerar oförändrat oavsett domän
// (produktion/preview).
const visaAllaParams = new URLSearchParams(Astro.url.searchParams);
visaAllaParams.set('visa', 'alla');
const visaAllaHref = `?${visaAllaParams.toString()}`;
const visaTreParams = new URLSearchParams(Astro.url.searchParams);
visaTreParams.delete('visa');
const visaTreHref = visaTreParams.toString() ? `?${visaTreParams.toString()}` : '?';
// AB1.1: nollställer kommun-filtret (går tillbaka till "alla kommuner"),
// bevarar "visa"-läget om det redan var satt.
const allaKommunerParams = new URLSearchParams(Astro.url.searchParams);
allaKommunerParams.delete('kommun');
const allaKommunerHref = allaKommunerParams.toString() ? `?${allaKommunerParams.toString()}` : '?';

function kategoriCell(e: KalenderEntry) {
  const forsta = KATEGORI_LABELS[e.kategori[0]];
  const fler = e.kategori.length - 1;
  return fler > 0 ? `${forsta} +${fler}` : forsta;
}

// 1f (SPEC_HUVUDPROCESSEN §1f): explicit fallback i stället för en tom
// cell — "belopp inte publicerat" är sakuppgiften (kommunen har inte
// lämnat ut ett tak), inte en tom ruta som kan läsas som ett fel.
function beloppCell(e: KalenderEntry): string {
  if (arNationell(e)) return 'Beloppstrappa';
  const tak = parseBeloppTak(e.belopp);
  return tak !== null ? `Upp till ${tak.toLocaleString('sv-SE')} kr` : 'belopp inte publicerat';
}
---
<Base title={KALENDER.metaTitle} description={KALENDER.metaDescription}>
  <BreadcrumbList items={[
    { name: 'Startsida', url: '/' },
    { name: 'Deadlinekalender', url: '/deadlines/' },
  ]} />

  <h1>{KALENDER.h1}</h1>
  <p>{KALENDER.intro}</p>
  <p class="deadline-senast-avlast">{TRATT.start.senastAvlastRad.replace('{datum}', formatDate(senastAvlast))}</p>
  {/* P3.2 (Jacob 2026-08-05), reviderad AB1.1: "Antalet i vyn ska framgå
     av rubriken" — riktig SSR-navigering, ingen klient-JS. Tre lägen nu
     i stället för två: en vald kommun, "visa alla", eller den snäva
     standard-teasern. */}
  <p class="deadline-vy-antal">
    {kommunFilterSlug ? (
      <>Visar alla {antalTotaltKommande} deadlines för {kommuner.find((k) => k.kommun_slug === kommunFilterSlug)?.kommun ?? kommunFilterSlug} (plus nationella stöd). <a href={allaKommunerHref}>Visa alla kommuner</a></>
    ) : visaAlla ? (
      <>Visar alla {antalTotaltKommande} deadlines. <a href={visaTreHref}>Visa de {DEFAULT_TEASER_MAX} närmaste</a></>
    ) : (
      <>Visar de {antalSynligaKommande} närmaste av {antalTotaltKommande} deadlines. <a href={visaAllaHref}>Visa alla →</a> — eller välj en kommun nedan.</>
    )}
  </p>

  <div class="deadline-filters">
    <label for="filter-kommun">
      Kommun
      {/* AB1.1: en riktig SSR-navigering (?kommun=), inte längre bara
         klient-JS-döljning — data-deadline-kommun-select markerar den
         för <script> nedan, som navigerar i stället för att filtrera
         DOM:en på plats. */}
      <select id="filter-kommun" data-deadline-kommun-select>
        <option value="alla" selected={!kommunFilterSlug}>Alla kommuner</option>
        {kommuner.map((k) => <option value={k.kommun_slug} selected={k.kommun_slug === kommunFilterSlug}>{k.kommun}</option>)}
      </select>
    </label>
    <label for="filter-kategori">
      Kategori
      <select id="filter-kategori">
        <option value="alla">Alla kategorier</option>
        {KATEGORIER.map((k) => <option value={k}>{KATEGORI_LABELS[k]}</option>)}
      </select>
    </label>
  </div>

  <div id="deadline-table-container">
    {synligaManadGrupper.map(([manad, radLista]) => (
      <details class="deadline-manad" data-deadline-manad data-manad-nyckel={manad} open={manad === innevarandeManad || manad === nastaManad}>
        <summary class="deadline-manad__summary">
          <svg class="deadline-manad__chevron" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
          <span class="deadline-manad__namn">{formatManadRubrik(manad)}</span>
          <span class="deadline-manad__antal">{radLista.length} {radLista.length === 1 ? 'deadline' : 'deadlines'}</span>
        </summary>
        <div class="deadline-table-scroll">
        <table class="deadline-table">
          <thead>
            <tr><th>Datum</th><th>Bidrag</th><th>Kommun</th><th>Kategori</th><th>Belopp</th><th></th></tr>
          </thead>
          <tbody>
            {radLista.map((e) => {
              const urgency = getUrgency(daysUntil(e.dateISO!, today));
              return (
                <tr data-niva={e.niva} data-kommun={arNationell(e) ? '' : e.kommunSlug} data-kategori={e.kategori.join(' ')}>
                  <td class="deadline-table__datum">
                    <span class={e.deadlineStatus === 'olast' ? 'fg-void-mark fg-void-mark--inline' : 'fg-read-mark fg-read-mark--inline'} aria-hidden="true"></span>
                    {urgency !== 'positive' && <UrgencyChip urgency={urgency} />}
                    {formatDate(e.dateISO!)}
                  </td>
                  <td><a href={arNationell(e) ? `/nationella-stod/${e.stodId}/` : `/kommun/${e.kommunSlug}/`} class="deadline-table__namn-lank">{arNationell(e) ? e.stodNamn : e.bidragNamn}</a></td>
                  <td>{arNationell(e) ? 'Hela Sverige' : e.kommun}</td>
                  <td>{kategoriCell(e)}</td>
                  <td>{beloppCell(e)}</td>
                  {arNationell(e) ? (
                    <td class="deadline-table__bevaka" data-bevaka-cell data-nationellt-stod-id={e.stodId} data-stod-namn={e.stodNamn}>
                      <a href={`/nationella-stod/${e.stodId}/#bevaka`} class="fg-btn--ghost bevaka-rad-knapp">{BEVAKNING.knapp}</a>
                    </td>
                  ) : (
                    <td class="deadline-table__bevaka" data-bevaka-cell data-kommun-slug={e.kommunSlug} data-kommun-namn={e.kommun} data-bidrag-id={e.bidragId}>
                      <a href={`?kommun=${e.kommunSlug}#email-signup`} class="fg-btn--ghost bevaka-rad-knapp">{BEVAKNING.knapp}</a>
                    </td>
                  )}
                </tr>
              );
            })}
          </tbody>
        </table>
        </div>
      </details>
    ))}
  </div>

  {antalTotaltLopande > 0 && (
    <>
      <h2>{KALENDER.lopandeRubrik}</h2>
      <p>{KALENDER.lopandeText}</p>
      {lopandeForRender.length > 0 ? (
        <div class="deadline-table-scroll">
        <table class="deadline-table" id="deadline-table-lopande">
          <thead>
            <tr><th>Bidrag</th><th>Kommun</th><th>Kategori</th><th>Belopp</th><th></th></tr>
          </thead>
          <tbody>
            {lopandeForRender.map((e) => (
              <tr data-kommun={e.kommunSlug} data-kategori={e.kategori.join(' ')}>
                <td><a href={`/kommun/${e.kommunSlug}/`} class="deadline-table__namn-lank">{e.bidragNamn}</a></td>
                <td>{e.kommun}</td>
                <td>{kategoriCell(e)}</td>
                <td>{beloppCell(e)}</td>
                <td class="deadline-table__bevaka" data-bevaka-cell data-kommun-slug={e.kommunSlug} data-kommun-namn={e.kommun} data-bidrag-id={e.bidragId}>
                  <a href={`?kommun=${e.kommunSlug}#email-signup`} class="fg-btn--ghost bevaka-rad-knapp">{BEVAKNING.knapp}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      ) : (
        // AB1.1: löpande saknar ett datum att teasra på (se frontmatterns
        // kommentar om lopandeForRender) — bare-default visar därför bara
        // räkningen + en väg dit, aldrig 0 rader utan förklaring.
        <p class="deadline-vy-antal">{antalTotaltLopande} löpande {antalTotaltLopande === 1 ? 'ansökan' : 'ansökningar'} utan fast datum. <a href={visaAllaHref}>Visa alla →</a> — eller välj en kommun ovan.</p>
      )}
    </>
  )}

  <p class="deadline-table__empty" id="deadline-empty" hidden>Inga deadlines matchar filtret.</p>

  {harOlastIKalendern && (
    <p class="deadline-legend">
      <span class="fg-void-mark fg-void-mark--inline" aria-hidden="true"></span>
      {OLAST_MARK.legend}
    </p>
  )}

  {bekraftad ? (
    <div class="email-signup fg-card">
      <h2>Bekräftad</h2>
    </div>
  ) : ogiltigtToken ? (
    <div class="email-signup fg-card">
      <h2>Länken fungerar inte</h2>
      <p>Den kan ha gått ut eller redan använts. Fyll i formuläret igen nedan.</p>
      <EmailSignup submitted={false} preselectedKommunSlug={preselectedKommunSlug} />
    </div>
  ) : uppdaterad ? (
    <div class="email-signup fg-card">
      <h2>Uppdaterat</h2>
    </div>
  ) : (
    <EmailSignup submitted={submitted} preselectedKommunSlug={preselectedKommunSlug} />
  )}
</Base>

<script>
  import { initBevakaWidgets } from '../../lib/bevakaKlient';

  const kommunSelect = document.getElementById('filter-kommun');
  const kategoriSelect = document.getElementById('filter-kategori');
  const emptyMsg = document.getElementById('deadline-empty');
  const rows = document.querySelectorAll<HTMLElement>('#deadline-table-container tbody tr, #deadline-table-lopande tbody tr');
  const manadSektioner = document.querySelectorAll<HTMLDetailsElement>('[data-deadline-manad]');

  // AB1.1: kommun scopas nu server-sidan (?kommun=, se index.astro:s
  // frontmatter) — klientfiltret behöver bara kategori kvar. Ett kvarvarande
  // matchKommun-villkor hade varit ett no-op (den renderade radmängden är
  // redan rätt kommun eller nationell) men riskerat att se ut som att
  // kommun fortfarande filtrerades här, vilket den inte gör.
  function applyFilter() {
    if (!(kategoriSelect instanceof HTMLSelectElement)) return;
    const kategori = kategoriSelect.value;
    let visibleCount = 0;

    rows.forEach((row) => {
      const visible = kategori === 'alla' || (row.dataset.kategori ?? '').split(' ').includes(kategori);
      row.hidden = !visible;
      if (visible) visibleCount++;
    });

    // Fäller ut en månad som fått en träff, så filtrerade rader inte
    // gömmer sig bakom en stängd disclosure. Fäller ALDRIG ihop
    // programmatiskt — samma regel som KommunValjare.astro:s länslista.
    if (kategori !== 'alla') {
      manadSektioner.forEach((sektion) => {
        const harTraff = [...sektion.querySelectorAll<HTMLElement>('tbody tr')].some((row) => !row.hidden);
        if (harTraff) sektion.open = true;
      });
    }

    if (emptyMsg instanceof HTMLElement) emptyMsg.hidden = visibleCount > 0;
  }

  // AB1.1 (Jacobs order): kommunvalet var tidigare bara klient-JS-döljning
  // — "ett kommunfilter visar 12 rader men hela rikets DOM ligger kvar".
  // Navigerar nu till en riktig SSR-scopad sida i stället, samma
  // ?kommun=-mönster som redan gäller för alla "Bevaka"-länkar sajtsbrett.
  kommunSelect?.addEventListener('change', () => {
    if (!(kommunSelect instanceof HTMLSelectElement)) return;
    const params = new URLSearchParams(window.location.search);
    if (kommunSelect.value === 'alla') params.delete('kommun');
    else params.set('kommun', kommunSelect.value);
    const qs = params.toString();
    window.location.href = qs ? `?${qs}` : window.location.pathname;
  });
  kategoriSelect?.addEventListener('change', applyFilter);

  // "Bevaka den här" — utbruten till bevakaKlient.ts (H20, SPEC: Kluster
  // 1) eftersom widgeten nu renderas från två sidor. Fungerar oförändrat
  // i en månad som just öppnats — <details> tar aldrig bort sina barn ur
  // DOM, så querySelectorAll i den delade modulen hittar ALLA celler vid
  // sidladdning oavsett kollapsat/öppet läge.
  initBevakaWidgets();
</script>

<style>
  .deadline-senast-avlast {
    font-size: var(--fg-text-label);
    color: var(--fg-ink-muted);
    margin: 0 0 var(--fg-space-5);
  }

  .deadline-vy-antal {
    font-size: var(--fg-text-label);
    color: var(--fg-ink-muted);
    margin: 0 0 var(--fg-space-5);
  }

  .deadline-manad {
    margin-bottom: var(--fg-space-3);
    border: var(--fg-border-inner) solid var(--fg-border);
    border-radius: var(--fg-radius-control);
    overflow: hidden;
  }

  .deadline-manad__summary {
    display: flex;
    align-items: center;
    gap: var(--fg-space-3);
    padding: var(--fg-space-3) var(--fg-space-4);
    cursor: pointer;
    list-style: none;
    background: var(--fg-surface);
    font-weight: var(--fg-weight-bold);
  }

  .deadline-manad__summary::-webkit-details-marker {
    display: none;
  }

  .deadline-manad__chevron {
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .deadline-manad[open] .deadline-manad__chevron {
    transform: rotate(90deg);
  }

  .deadline-manad__namn {
    flex: 1;
  }

