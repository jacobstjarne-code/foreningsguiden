---
// Matchningstratten (turn-11, ombyggd 2026-07-27 till stegflöde per turn-12a)
// — "Vad kan er förening söka?" En fråga i fokus åt gången, sticky
// stegbar (räknare + kvittens + progress), besked visas först i steg 6.
// Route kommun-agnostisk (fråga 1 VÄLJER kommun, kan därför inte ligga
// under /kommun/[slug]/) — mitt förslag, inte instruerat.
//
// Källa: incoming/foreningsguiden-tratt-tryck-v3-livedata.html #turn-12
// (12a). All copy ur GUIDE_TRATT_COPY.ts, ingen text uppfunnen här.
// Matchningslogiken är riktig (src/lib/matching.ts) — ingen fejk-räknare,
// och den rörs INTE av denna ombyggnad (se plan:
// twinkling-wondering-emerson.md — "omgörning av ytan, inte av logiken").
//
// "Ändra svar"-knappen (TRATT.start.knappBorjaOm) går till steg 1 UTAN
// att nollställa sparade svar — mockens restart() nollställer allt, men
// sajten lovar "era svar sparas" (TRATT.besked.minne). Jacob 2026-07-27:
// etiketten "Börja om" ljög om vad knappen gör; "Ändra svar" beskriver
// exakt handlingen OCH löser Designs H6 (synlig väg att rätta ett svar).
// En återvändande session med sparad kommun hoppar direkt till steg 6
// (beskedet), samma som innan ombyggnaden; "Tillbaka" eller "Ändra svar"
// tar en till valfri fråga för att justera.
import Base from '../../layouts/Base.astro';
import KommunValjare from '../../components/KommunValjare.astro';
import { loadKommuner } from '../../lib/kommuner';
import { TRATT } from '../../../GUIDE_TRATT_COPY';

const kommuner = loadKommuner();
---
<Base title={TRATT.start.rubrik} description={TRATT.start.ingress}>
  <section class="tratt" data-tratt>
    <header class="tratt__header">
      <h1>{TRATT.start.rubrik}</h1>
      <p class="tratt__ingress">{TRATT.start.ingress}</p>
    </header>

    {/* SPEC B3, D-A (Design, runda 6, 2026-08-06): förlopp och räknare
       är två skilda komponenter, inte längre samma svarta monospace-
       fält. Förloppet är CHROME (tre segment, tyst grå label,
       kommunnamn i mono) och försvinner på beskedet — frågorna är
       slut, det har inget jobb kvar. Räknaren är ett BESKED, egen rad
       i sunken papperston, och tas ALDRIG bort (B3, "Vad Code behöver
       veta" §4) — bara tom innan kommun är vald. */}
    <p class="tratt__raknare-rad" data-tratt-raknare aria-live="polite">
      <span class="tratt__raknare-tal" data-tratt-raknare-tal hidden></span>
      <span data-tratt-raknare-text>{TRATT.raknare.tom}</span>
    </p>

    <div class="tratt__forlopp" data-tratt-forlopp>
      <span class="tratt__forlopp-segment" data-tratt-segment></span>
      <span class="tratt__forlopp-segment" data-tratt-segment></span>
      <span class="tratt__forlopp-segment" data-tratt-segment></span>
      <span class="tratt__forlopp-label" data-tratt-steg-label></span>
      <span class="tratt__forlopp-kommun" data-tratt-forlopp-kommun></span>
    </div>

    <div class="tratt__layout">
      <div class="tratt__frageflode">

        <div class="tratt__fraga" data-tratt-steg="1">
          <h2>{TRATT.fraga_kommun.fraga}</h2>
          <p class="tratt__hjalp">{TRATT.fraga_kommun.hjalp}</p>
          <div data-tratt-kommunvaljare>
            <KommunValjare kommuner={kommuner} selectMode={true} />
          </div>
          <div class="tratt__kommun-vald" data-tratt-kommun-vald hidden>
            <span>Vald: <strong data-tratt-kommun-vald-namn></strong></span>
            <button type="button" class="tratt__kommun-byt" data-tratt-kommun-byt>Byt</button>
          </div>
        </div>

        <div class="tratt__fraga" data-tratt-steg="2" data-tratt-fraga-container="verksamhet" hidden>
          <h2>{TRATT.fraga_verksamhet.fraga}</h2>
          <p class="tratt__hjalp">{TRATT.fraga_verksamhet.hjalp}</p>
          <div class="tratt__pillgrupp" data-tratt-fraga="verksamhet" role="group" aria-label={TRATT.fraga_verksamhet.fraga}>
            {TRATT.fraga_verksamhet.alternativ.map((a) => (
              <button type="button" class="tratt__pill" data-tratt-svar={a.id}>{a.etikett}</button>
            ))}
          </div>
          <button type="button" class="tratt__vidare" data-tratt-vidare>Vidare →</button>
        </div>

        {/* B3.6 (SPEC B3, Jacob 2026-08-06): storleksfrågan borttagen ur
           tratten helt — "Fyra frågor varav en utan verkan är sämre än
           tre som alla gör något" (B3.4). Återinförs när kravdatan bär
           medlemsgränser strukturerat brett. profil.storlek finns kvar i
           Foreningsprofil (foreningsprofil.ts) och matchBidrag
           (matching.ts, används av utkastGenerator/checkout/registrera —
           OFÖRÄNDRAT där) — bara frågan här är borttagen, samma mönster
           G7 redan satte för alder/verksamhetstid. sorteraForTratt
           (matching.ts) — trattens EGNA, enklare sortering för
           beskedskärmen — läser aldrig profil.storlek alls.
           Flödet är nu tre frågor: kommun, verksamhet, sökt förut
           (gaten, sist). */}
        <div class="tratt__fraga" data-tratt-steg="3" hidden>
          <h2>{TRATT.fraga_sokt.fraga}</h2>
          <p class="tratt__hjalp">{TRATT.fraga_sokt.hjalp}</p>
          <div class="tratt__pillgrupp" data-tratt-fraga="sokt" role="group" aria-label={TRATT.fraga_sokt.fraga}>
            {TRATT.fraga_sokt.alternativ.map((a) => (
              <button type="button" class="tratt__pill" data-tratt-svar={a.id}>{a.etikett}</button>
            ))}
          </div>
          {/* 1c — SPEC_HUVUDPROCESSEN (Opus/Fable 2026-08-01),
             MOCKAR_huvudprocessen.md §1c: "gaten som fjärde fråga".
             Konsekvensen visas i SAMMA ögonblick som svaret (nej/vet
             inte), inte först på beskedet — se skriptets sokt-hantering.
             "Ja" fortsätter att auto-avancera som tidigare frågor; bara
             nej/osäker stannar kvar och kräver ett medvetet "Visa
             beskedet"-klick. */}
          <div class="tratt__gate-besked" data-tratt-gate-besked hidden>
            {TRATT.fraga_sokt.gateBesked}
          </div>
          <div class="tratt__nav tratt__nav--gate" data-tratt-visa-besked-rad hidden>
            <button type="button" class="btn-primary" data-tratt-visa-besked>{TRATT.fraga_sokt.visaBeskedetKnapp} →</button>
          </div>
        </div>

        <div class="tratt__nav" data-tratt-nav>
          <button type="button" class="tratt__nav-tillbaka" data-tratt-tillbaka>← Tillbaka</button>
          <button type="button" class="tratt__nav-omstart" data-tratt-omstart>{TRATT.start.knappBorjaOm}</button>
        </div>

      </div>

      <div class="tratt__besked" data-tratt-besked hidden>
        {/* H5 (SPEC: Det som återstår, 2026-07-28): återuppta en
           avbruten tratt. Hidden som default, visas av skriptet bara
           om profilen inte är komplett — se render()-anropande koden
           längst ner. */}
        <div class="tratt__atervand" data-tratt-atervand hidden>
          <p data-tratt-atervand-text></p>
          <div class="tratt__atervand-knappar">
            <button type="button" class="btn-primary" data-tratt-atervand-fortsatt>{TRATT.besked.atervand.knappFortsatt}</button>
            <button type="button" class="fg-btn--ghost" data-tratt-atervand-mejla>{TRATT.besked.atervand.knappMejla}</button>
          </div>
          <form class="tratt__atervand-form" data-tratt-atervand-form hidden>
            <input type="email" name="email" placeholder={TRATT.besked.atervand.epostPlaceholder} required autocomplete="email" />
            <button type="submit" class="btn-primary">{TRATT.besked.atervand.knappSkicka}</button>
            <p class="tratt__atervand-fel" data-tratt-atervand-fel hidden>Något gick fel. Försök igen.</p>
          </form>
          <p class="tratt__atervand-kvitto" data-tratt-atervand-kvitto hidden>{TRATT.besked.atervand.kvitto}</p>
        </div>

        {/* SPEC B3, D-B (Design, runda 6, 2026-08-06): räknaren (alltid
           synlig, ovanför) BLIR sidans rubrik här — h2.rubrik ("Det här
           hittade vi för er förening") borttagen, ersatt av räknarens
           beskedvariant (TRATT.raknare.beskedTillagg, skriptet). */}

        {/* Blocket ovanför listan — det ENDA som skiljer mellan de tre
           sökt-lägena (B3, "Vad Code behöver veta" §5). Grupperna
           nedanför är identiska i alla tre. sokt=ja: hela blocket
           hidden, ingenting ovanför. */}
        <div class="tratt__registrering" data-tratt-registrering hidden>
          <div class="tratt__registrering-block" data-tratt-registrering-block>
            <span class="tratt__registrering-siffra" aria-hidden="true">1</span>
            <div>
              <p class="tratt__registrering-etikett">{TRATT.besked.registrering.etikett}</p>
              {/* sokt=nej: besked. sokt=vet inte (osäker): kontrollfråga
                 + kommunens egen länk. Text/href sätts av skriptet. */}
              <p data-tratt-registrering-text></p>
              <a href="#" class="btn-primary tratt__registrering-knapp" data-tratt-registrering-knapp target="_blank" rel="noopener"></a>
            </div>
          </div>
          {/* Bara sokt=nej — "gruppinledning" till listorna, inte ett
             tredje beskedsläge (B3 §5). */}
          <div class="tratt__registrering-vantar" data-tratt-registrering-vantar hidden>
            <h3>{TRATT.besked.registrering.vantarRubrik}</h3>
            <p>{TRATT.besked.registrering.vantarText}</p>
          </div>
        </div>

        {/* Tre grupper (B3.1/B3, "Vad Code behöver veta" §2, M2.3-
           precisionsordern) — samma i alla tre sökt-lägena. Sorteringen
           (sorteraForTratt, matching.ts) FILTRERAR ALDRIG — varje aktivt
           bidrag hamnar i endera av de tre. En grupp döljs bara om den
           är tom (aldrig ett enskilt bidrag). Vanlig ram, ingen
           attention/oxblod (B3 D-B "Nyckeln") — .tratt__bidrag är redan
           neutral, orörd. Skälet ("varför ligger bidraget här") skrivs
           per RAD av render() nedan, inte som en delad grupptext — nivå
           ett interpolerar bidragets EGNA matchandeForeningstyp, så
           samma rubrik kan bära olika skäl-text beroende på bidrag. */}
        <section class="tratt__grupp" data-tratt-grupp-troligen hidden>
          <h3>{TRATT.besked.grupper.troligenRelevant}</h3>
          <ul class="tratt__bidraglista" data-tratt-troligen-lista></ul>
        </section>

        <section class="tratt__grupp" data-tratt-grupp-kanske hidden>
          <h3>{TRATT.besked.grupper.kanVaraRelevant}</h3>
          <ul class="tratt__bidraglista" data-tratt-kanske-lista></ul>
        </section>

        <section class="tratt__grupp" data-tratt-grupp-obekant hidden>
          <h3>{TRATT.besked.grupper.garInteAttBedoma}</h3>
          <ul class="tratt__bidraglista" data-tratt-obekant-lista></ul>
        </section>

        <p class="tratt__minne">{TRATT.besked.minne}</p>
        <p class="tratt__ansvar">{TRATT.ansvar}</p>

        {/* H7 (SPEC: Kluster 3, 2026-07-28): delbart besked — köpbeslutet
           fattas av styrelsen, inte kassören ensam. Mejlversionen
           innehåller de matchade bidragen direkt (api/dela-besked.ts),
           ingen länk som kräver att svaren fylls i på nytt. */}
        <div class="tratt__dela" data-tratt-dela>
          <h3>{TRATT.besked.dela.rubrik}</h3>
          <p>{TRATT.besked.dela.brodtext}</p>
          <div class="tratt__dela-knappar">
            <button type="button" class="fg-btn--ghost" data-tratt-dela-mejla>{TRATT.besked.dela.knappMejla}</button>
            <button type="button" class="fg-btn--ghost" data-tratt-dela-skriv-ut>{TRATT.besked.dela.knappSkrivUt}</button>
          </div>
          <form class="tratt__dela-form" data-tratt-dela-form hidden>
            <input type="email" name="email" placeholder={TRATT.besked.dela.epostPlaceholder} required autocomplete="email" />
            <button type="submit" class="btn-primary">{TRATT.besked.dela.knappSkicka}</button>
            <p class="tratt__dela-fel" data-tratt-dela-fel hidden>Något gick fel. Försök igen.</p>
          </form>
          <p class="tratt__dela-kvitto" data-tratt-dela-kvitto hidden>{TRATT.besked.dela.kvitto}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { sorteraForTratt, type TrattRad } from '../../lib/matching';
  import { getForeningsprofil, saveForeningsprofil, type Foreningsprofil, type SoktSvar } from '../../lib/foreningsprofil';
  import { formatDate, earliestDeadlineISO, todayISO, daysUntil, getUrgency, individuelltBelopp, svenskLista, type Bidrag, type Kommun, type Verksamhet } from '../../lib/kommunTyper';
  import { TRATT } from '../../../GUIDE_TRATT_COPY';
  import { VOID_MARK } from '../../lib/content';
  import { trackEvent } from '../../lib/umami';
  import { formateraBevakarText } from '../../lib/bevakningKlient';

  const root = document.querySelector<HTMLElement>('[data-tratt]');
  // FIX (uppföljning MÄTNING, Jacobs fynd 2026-08-11): tratt_fraga_
  // besvarad avfyrades två gånger med IDENTISK payload för ett enda
  // svar — "Vidare"-knappens click-lyssnare dubbelbunden. Grundorsaken
  // kunde inte fastställas med säkerhet i källan (bara EN registrering
  // av vidareKnapp.addEventListener hittas här) — misstänkt Vite/Astro
  // dev-server-omkörning av modulscriptet, inte reproducerad utan
  // webbläsarverktyg. Spärren nedan är riktad mot SYMTOMET oavsett
  // orsak: om det här scriptet av någon anledning körs mer än en gång
  // mot SAMMA DOM-nod, fästs lyssnarna bara första gången.
  if (root && !root.dataset.trattInitierad) {
    root.dataset.trattInitierad = '1';
    // M1 (MÄTNING, Jacob 2026-08-11): tratten faktiskt öppnad — fyller
    // frågan D5.2/M2 inte kan svara på ensam (entry-sidan mot om hon
    // FULLFÖLJER tratten).
    trackEvent('tratt_start');
    const raknareTalEl = root.querySelector<HTMLElement>('[data-tratt-raknare-tal]');
    const raknareTextEl = root.querySelector<HTMLElement>('[data-tratt-raknare-text]');
    const forloppEl = root.querySelector<HTMLElement>('[data-tratt-forlopp]');
    const segmentEls = root.querySelectorAll<HTMLElement>('[data-tratt-segment]');
    const forloppKommunEl = root.querySelector<HTMLElement>('[data-tratt-forlopp-kommun]');
    const stegLabelEl = root.querySelector<HTMLElement>('[data-tratt-steg-label]');
    const stegElement = root.querySelectorAll<HTMLElement>('[data-tratt-steg]');
    const tillbakaKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-tillbaka]');
    const omstartKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-omstart]');
    const vidareKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-vidare]');
    const gateBeskedEl = root.querySelector<HTMLElement>('[data-tratt-gate-besked]');
    const visaBeskedRadEl = root.querySelector<HTMLElement>('[data-tratt-visa-besked-rad]');
    const visaBeskedKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-visa-besked]');
    const beskedEl = root.querySelector<HTMLElement>('[data-tratt-besked]');
    const registreringEl = root.querySelector<HTMLElement>('[data-tratt-registrering]');
    const registreringBlockEl = root.querySelector<HTMLElement>('[data-tratt-registrering-block]');
    const registreringTextEl = root.querySelector<HTMLElement>('[data-tratt-registrering-text]');
    const registreringKnappEl = root.querySelector<HTMLAnchorElement>('[data-tratt-registrering-knapp]');
    const registreringVantarEl = root.querySelector<HTMLElement>('[data-tratt-registrering-vantar]');
    const troligenGruppEl = root.querySelector<HTMLElement>('[data-tratt-grupp-troligen]');
    const troligenListaEl = root.querySelector<HTMLElement>('[data-tratt-troligen-lista]');
    const kanskeGruppEl = root.querySelector<HTMLElement>('[data-tratt-grupp-kanske]');
    const kanskeListaEl = root.querySelector<HTMLElement>('[data-tratt-kanske-lista]');
    const obekantGruppEl = root.querySelector<HTMLElement>('[data-tratt-grupp-obekant]');
    const obekantListaEl = root.querySelector<HTMLElement>('[data-tratt-obekant-lista]');
    const kommunvaljareWrapperEl = root.querySelector<HTMLElement>('[data-tratt-kommunvaljare]');
    const kommunValdEl = root.querySelector<HTMLElement>('[data-tratt-kommun-vald]');
    const kommunValdNamnEl = root.querySelector<HTMLElement>('[data-tratt-kommun-vald-namn]');
    const kommunBytKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-kommun-byt]');
    const delaMejlaKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-dela-mejla]');
    const delaSkrivUtKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-dela-skriv-ut]');
    const delaForm = root.querySelector<HTMLFormElement>('[data-tratt-dela-form]');
    const delaFelEl = root.querySelector<HTMLElement>('[data-tratt-dela-fel]');
    const delaKvittoEl = root.querySelector<HTMLElement>('[data-tratt-dela-kvitto]');
    const atervandEl = root.querySelector<HTMLElement>('[data-tratt-atervand]');
    const atervandTextEl = root.querySelector<HTMLElement>('[data-tratt-atervand-text]');
    const atervandFortsattKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-atervand-fortsatt]');
    const atervandMejlaKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-atervand-mejla]');
    const atervandForm = root.querySelector<HTMLFormElement>('[data-tratt-atervand-form]');
    const atervandFelEl = root.querySelector<HTMLElement>('[data-tratt-atervand-fel]');
    const atervandKvittoEl = root.querySelector<HTMLElement>('[data-tratt-atervand-kvitto]');

    const today = todayISO();
    let kommunData: Kommun | null = null;

    // Steget som är i fokus (1–3 = fråga N, 4 = klart/besked). SPEC B3
    // (2026-08-06): storleksfrågan borttagen, tratten är nu TRE frågor
    // (kommun, verksamhet, sökt) + besked = fyra steg, inte fem. En
    // riktig återvändande session (sparad kommun) hoppar direkt till 4.
    let step = 1;
    let advancing = false;

    // H5 — "Mejla mig en länk": profilen kan komma in via ?fortsatt=
    // (en JSON-kodad Foreningsprofil, se api/mejla-tratt-lank.ts som
    // byggde länken ur SERVERVALIDERADE fält). Sparas i localStorage
    // direkt vid ankomst, så den vanliga sparad-läsningen nedan hittar
    // den — samma "en sanning" som allt annat i profilen.
    const fortsattParam = new URLSearchParams(window.location.search).get('fortsatt');
    if (fortsattParam) {
      try {
        const fortsattProfil = JSON.parse(fortsattParam) as Partial<Foreningsprofil>;
        if (fortsattProfil && typeof fortsattProfil === 'object') {
          saveForeningsprofil(fortsattProfil);
        }
      } catch {
        // Trasig/manipulerad länk — hoppa bara över, ingen krasch.
      }
    }

    const sparad = getForeningsprofil();
    const profil: Foreningsprofil = sparad ?? {
      kommunSlug: null,
      verksamhet: [],
      storlek: null,
      alder: null,
      sokt: null,
      uppdaterad: '',
      foreningsnamn: null,
      giltighet: null,
      bevakadeBidrag: [],
    };

    // Reverserat 2026-08-03 (arbetsorder 2d) — samma reversering som
    // UrgencyChip.astro: distinkt ord per nivå igen, se den filens kommentar.
    const URGENCY_LABEL: Record<'urgent' | 'attention' | 'positive', string> = { urgent: 'Bråttom', attention: 'Snart', positive: 'God tid' };

    // M2.5 (Jacob 2026-08-17, säkerhetsordern): byggd med DOM-API:er/
    // textContent i stället för en HTML-sträng — bidrag.belopp är
    // extraherad kommuntext (researchpasset), inte kod vi litar på.
    // Tidigare interpolerades den orenat i li.innerHTML (renderBidragLista
    // nedan); en kommunsida med "<script>" i beloppfältet hade kunnat
    // exekvera i besökarens webbläsare.
    function bidragMetaEl(bidrag: Bidrag): HTMLElement {
      const el = document.createElement('div');
      el.className = 'tratt__bidrag-meta';
      const belopp = individuelltBelopp(bidrag) ?? 'Individuellt belopp inte fastställt';
      // dateISO är null för BÅDE löpande och okänd deadlines.typ
      // (earliestDeadlineISO), samma mönster som BidragCard/
      // KommunProgressions formatDeadlines — skilj dem explicit på
      // deadlines.typ, rör aldrig deadlines.datum direkt.
      const dateISO = earliestDeadlineISO(bidrag, today);
      if (!dateISO) {
        const text = bidrag.deadlines.typ === 'okand' ? 'inget publicerat ansökningsdatum' : 'löpande ansökan';
        el.textContent = `${belopp} · ${text}`;
        return el;
      }
      const dagar = daysUntil(dateISO, today);
      const urgency = getUrgency(dagar);
      const dagarText = dagar === 1 ? '1 dag kvar' : `${dagar} dagar kvar`;
      const chip = document.createElement('span');
      chip.className = `fg-chip fg-chip--${urgency}`;
      chip.textContent = URGENCY_LABEL[urgency];
      el.append(`${belopp} · `, chip, ` sista dag ${formatDate(dateISO)} · ${dagarText}`);
      return el;
    }

    function bidragLank(bidrag: Bidrag): string {
      return kommunData ? `/kommun/${kommunData.kommun_slug}/#bidrag-${bidrag.id}` : '#';
    }

    // M2.3 — skälet per rad. Bara "troligen relevant" interpolerar
    // (bidragets EGNA matchandeForeningstyp), de andra två är fasta.
    function skalText(rad: TrattRad): string {
      if (rad.niva === 'troligen_relevant') {
        return TRATT.besked.grupper.troligenRelevantSkal.replace('{foreningstyp}', svenskLista(rad.matchandeForeningstyp));
      }
      if (rad.niva === 'kan_vara_relevant') return TRATT.besked.grupper.kanVaraRelevantSkal;
      return TRATT.besked.grupper.garInteAttBedomaSkal;
    }

    // M2.5 — samma skäl som bidragMetaEl ovan: bidrag.namn och skalText
    // (troligen_relevant-grenen interpolerar matchandeForeningstyp, men
    // resten av kedjan är extraherad kommuntext) sätts via textContent,
    // aldrig via en HTML-sträng.
    function renderBidragLista(el: HTMLElement | null, rader: TrattRad[]) {
      if (!el) return;
      el.replaceChildren();
      rader.forEach((rad) => {
        const li = document.createElement('li');
        li.className = 'tratt__bidrag';
        const a = document.createElement('a');
        a.href = bidragLank(rad.bidrag);
        a.textContent = rad.bidrag.namn;
        const skal = document.createElement('p');
        skal.className = 'tratt__bidrag-skal';
        skal.textContent = skalText(rad);
        li.append(a, bidragMetaEl(rad.bidrag), skal);
        el.appendChild(li);
      });
    }

    /** Räknaren (B3, D-A) — kommunens totalsumma AKTIVA bidrag. Beräknas
     * en gång per kommunval, inte per svar (satt i render(), men render()
     * själv anropas efter varje svar — värdet är ändå stabilt eftersom
     * det bara beror på kommunData, aldrig på profil). */
    function totalAktivaBidrag(kommun: Kommun): number {
      return kommun.bidrag.filter((b) => b.status === 'aktiv').length;
    }

    /** 1c — gaten (MOCKAR_huvudprocessen.md §1c), oförändrad av B3. Styrs
     * helt av profil.sokt, inte av klickhändelsen, så tillståndet stämmer
     * även vid återupptagen/återställd profil (H5). */
    function updateGateUI() {
      const gate = profil.sokt === 'nej' || profil.sokt === 'osaker';
      if (gateBeskedEl) gateBeskedEl.hidden = !gate;
      if (visaBeskedRadEl) visaBeskedRadEl.hidden = profil.sokt === null;
    }

    /** SPEC B3, D-A: tre segment (fylld accent för klarade, tyst för
     * kvar) i stället för en kontinuerlig fyllning. Förloppet döljs helt
     * på beskedet (steg 4) — frågorna är slut, inget jobb kvar. */
    function updateForlopp() {
      if (forloppEl) forloppEl.hidden = step >= 4;
      segmentEls.forEach((seg, i) => {
        seg.classList.toggle('is-klar', i < Math.min(step - 1, 3));
      });
      if (stegLabelEl) stegLabelEl.textContent = `Fråga ${Math.min(step, 3)} av 3`;
      if (forloppKommunEl) forloppKommunEl.textContent = kommunData?.kommun ?? '';
    }

    /** Visar exakt ETT tratt__fraga-steg och besked-panelen bara i steg 4
     * — döljs via `hidden` (aldrig tas bort ur DOM, samma regel som
     * KommunValjares sökfilter använder). */
    function updateStegUI() {
      stegElement.forEach((el) => {
        el.hidden = Number(el.dataset.trattSteg) !== step;
      });
      if (beskedEl) beskedEl.hidden = step !== 4 || !kommunData;
      if (tillbakaKnapp) tillbakaKnapp.hidden = step <= 1;
      updateForlopp();
      updateGateUI();
    }

    function goStep(n: number) {
      const mal = Math.max(1, Math.min(4, n));
      // M1: bara framåtrörelse räknas som "en fråga besvarad" — Tillbaka/
      // Börja om ska inte blåsa upp siffran, hon svarade inte på nåt nytt.
      if (mal > step) {
        trackEvent('tratt_fraga_besvarad', { steg: step, kommun: kommunData?.kommun ?? null });
      }
      step = mal;
      updateStegUI();
      if (step === 4) {
        trackEvent('tratt_besked', { kommun: kommunData?.kommun ?? null, sokt: profil.sokt });
      }
    }

    /** SPEC B3, D-B: blocket ovanför de två grupperna. Enda som skiljer
     * mellan sokt-lägena — grupperna nedanför är identiska i alla tre. */
    function updateRegistrering() {
      if (!registreringEl || !kommunData) return;
      const kommunNamn = kommunData.kommun;

      if (profil.sokt === 'nej') {
        registreringEl.hidden = false;
        if (registreringTextEl) registreringTextEl.textContent = TRATT.besked.registrering.budskapNej.replace(/{kommun}/g, kommunNamn);
        if (registreringKnappEl) {
          registreringKnappEl.textContent = TRATT.besked.registrering.knapp;
          registreringKnappEl.href = kommunData.kalla_url;
        }
        if (registreringVantarEl) registreringVantarEl.hidden = false;
      } else if (profil.sokt === 'osaker') {
        registreringEl.hidden = false;
        if (registreringTextEl) registreringTextEl.textContent = TRATT.besked.registrering.kontrollfraga.replace(/{kommun}/g, kommunNamn);
        if (registreringKnappEl) {
          const host = new URL(kommunData.kalla_url).hostname.replace(/^www\./, '');
          registreringKnappEl.textContent = VOID_MARK.kallaKnappMall.replace('{host}', host);
          registreringKnappEl.href = kommunData.kalla_url;
        }
        if (registreringVantarEl) registreringVantarEl.hidden = true;
      } else {
        // sokt === 'ja' eller null (obesvarad — samma tysta läge som
        // gaten ovan redan ger null, ingen gissning på "vet inte").
        registreringEl.hidden = true;
      }
    }

    function render() {
      if (!kommunData) {
        if (raknareTalEl) raknareTalEl.hidden = true;
        if (raknareTextEl) raknareTextEl.textContent = TRATT.raknare.tom;
        updateStegUI();
        return;
      }

      const antal = totalAktivaBidrag(kommunData);
      if (raknareTalEl) {
        raknareTalEl.textContent = String(antal);
        raknareTalEl.hidden = false;
      }
      if (raknareTextEl) {
        const mall = antal === 1 ? TRATT.raknare.mallEtt : TRATT.raknare.mall;
        const bas = mall.replace('{antal}', String(antal)).replace(/{kommun}/g, kommunData.kommun);
        raknareTextEl.textContent = step >= 4 ? bas + TRATT.raknare.beskedTillagg : bas;
      }

      // B3: "Sortera, aldrig filtrera" — sorteraForTratt (matching.ts)
      // grupperar ALLA aktiva bidrag i tre nivåer, utesluter aldrig ett
      // baserat på profilen. En grupp döljs bara om den råkar vara tom.
      const { troligenRelevant, kanVaraRelevant, garInteAttBedoma } = sorteraForTratt(profil, kommunData);

      if (troligenGruppEl) troligenGruppEl.hidden = troligenRelevant.length === 0;
      renderBidragLista(troligenListaEl, troligenRelevant);

      if (kanskeGruppEl) kanskeGruppEl.hidden = kanVaraRelevant.length === 0;
      renderBidragLista(kanskeListaEl, kanVaraRelevant);

      if (obekantGruppEl) obekantGruppEl.hidden = garInteAttBedoma.length === 0;
      renderBidragLista(obekantListaEl, garInteAttBedoma);

      updateRegistrering();
      updateStegUI();
    }

    function markeraAktivaPillar() {
      root!.querySelectorAll<HTMLElement>('[data-tratt-fraga]').forEach((grupp) => {
        const fraga = grupp.dataset.trattFraga;
        grupp.querySelectorAll<HTMLButtonElement>('[data-tratt-svar]').forEach((pill) => {
          const varde = pill.dataset.trattSvar ?? '';
          let aktiv = false;
          if (fraga === 'verksamhet') aktiv = profil.verksamhet.includes(varde as Verksamhet);
          else if (fraga === 'sokt') aktiv = profil.sokt === varde;
          pill.classList.toggle('is-active', aktiv);
          pill.setAttribute('aria-pressed', String(aktiv));
        });
      });
    }

    // Fråga 1 kollapsar till en kort "Vald: {namn}"-rad efter val — annars
    // ligger hela sök+länslistan kvar orörd och ser ut som att klicket inte
    // gjorde något (Jacob-fyndet: väljaren måste synligt reagera).
    function visaValdKommun(namn: string) {
      if (kommunvaljareWrapperEl) kommunvaljareWrapperEl.hidden = true;
      if (kommunValdEl) kommunValdEl.hidden = false;
      if (kommunValdNamnEl) kommunValdNamnEl.textContent = namn;
    }

    function visaKommunvaljare() {
      if (kommunvaljareWrapperEl) kommunvaljareWrapperEl.hidden = false;
      if (kommunValdEl) kommunValdEl.hidden = true;
    }

    async function hamtaKommunData(slug: string, opts: { advance?: boolean } = {}) {
      try {
        const res = await fetch(`/kommun-data/${slug}.json`);
        if (!res.ok) throw new Error('kommun-data 404');
        kommunData = (await res.json()) as Kommun;
      } catch {
        kommunData = null;
      }
      if (kommunData) {
        visaValdKommun(kommunData.kommun);
      }
      render();
      if (opts.advance) {
        setTimeout(() => goStep(2), 450);
      }
    }

    root.addEventListener('kommunvaljare:valj', (event) => {
      const detail = (event as CustomEvent<{ slug: string; namn: string }>).detail;
      if (!detail?.slug) return;
      profil.kommunSlug = detail.slug;
      saveForeningsprofil({ kommunSlug: profil.kommunSlug });
      hamtaKommunData(detail.slug, { advance: true });
    });

    kommunBytKnapp?.addEventListener('click', () => {
      visaKommunvaljare();
    });

    tillbakaKnapp?.addEventListener('click', () => goStep(step - 1));
    omstartKnapp?.addEventListener('click', () => goStep(1));
    vidareKnapp?.addEventListener('click', () => goStep(3));
    visaBeskedKnapp?.addEventListener('click', () => goStep(4));

    // H7 — delbart besked. Mejlversionen skickar bara ID-REFERENSER
    // (kommunSlug + bidrag-id:n) till servern, som slår upp namn/belopp/
    // deadline själv (kommun.ts) — aldrig fritext från klienten rakt in
    // i ett utgående mejl. B3 (2026-08-06): skickar nu "Passar er
    // verksamhet"-gruppen (sorteraForTratt) — närmaste motsvarighet till
    // den gamla matchKommun().matchar, som mejlfunktionen byggdes mot.
    delaMejlaKnapp?.addEventListener('click', () => {
      delaForm?.removeAttribute('hidden');
      delaMejlaKnapp.setAttribute('hidden', '');
    });

    delaSkrivUtKnapp?.addEventListener('click', () => window.print());

    delaForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      delaFelEl?.setAttribute('hidden', '');
      if (!kommunData) return;

      // M2.3: "Passar er verksamhet" är borta — närmaste motsvarighet
      // till gamla matchKommun().matchar är nu de två nivåer som faktiskt
      // hade ett kategori/foreningstyp-överlapp, INTE "Går inte att
      // bedöma" (det är den gamla "Kan gälla er ändå", aldrig skickad här).
      const { troligenRelevant, kanVaraRelevant } = sorteraForTratt(profil, kommunData);
      const data = new FormData(delaForm);
      data.set('kommun', kommunData.kommun_slug);
      [...troligenRelevant, ...kanVaraRelevant].forEach((rad) => data.append('bidragId', rad.bidrag.id));

      try {
        const res = await fetch('/api/dela-besked', { method: 'POST', body: data });
        const json = await res.json();
        if (!res.ok || !json.ok) throw new Error('svar ej ok');
        delaForm.hidden = true;
        delaKvittoEl?.removeAttribute('hidden');
      } catch {
        delaFelEl?.removeAttribute('hidden');
      }
    });

    root.querySelectorAll<HTMLElement>('[data-tratt-fraga]').forEach((grupp) => {
      const fraga = grupp.dataset.trattFraga;
      const fragaWrapper = grupp.closest<HTMLElement>('[data-tratt-steg]');
      const eigenStep = fragaWrapper ? Number(fragaWrapper.dataset.trattSteg) : null;

      grupp.querySelectorAll<HTMLButtonElement>('[data-tratt-svar]').forEach((pill) => {
        pill.addEventListener('click', () => {
          if (advancing) return;
          const varde = pill.dataset.trattSvar ?? '';

          if (fraga === 'verksamhet') {
            const v = varde as Verksamhet;
            profil.verksamhet = profil.verksamhet.includes(v) ? profil.verksamhet.filter((x) => x !== v) : [...profil.verksamhet, v];
            saveForeningsprofil({ verksamhet: profil.verksamhet });
          } else if (fraga === 'sokt') {
            profil.sokt = (profil.sokt === varde ? null : varde) as SoktSvar | null;
            saveForeningsprofil({ sokt: profil.sokt });
          }

          markeraAktivaPillar();
          render();

          // Verksamhet är flerval — ingen auto-advance, "Vidare"-knappen
          // (steg 2) styr det istället, samma skillnad som mocken gör.
          // 1c — gaten: nej/osäker stannar kvar på steget så attention-
          // rutan (redan visad av render→updateGateUI ovan) syns innan
          // hon går vidare. "Ja" fortsätter auto-avancera som tidigare.
          const gateStannar = fraga === 'sokt' && (varde === 'nej' || varde === 'osaker');
          if (fraga !== 'verksamhet' && !gateStannar && eigenStep !== null) {
            advancing = true;
            setTimeout(() => {
              advancing = false;
              goStep(eigenStep + 1);
            }, 450);
          }
        });
      });
    });

    // H5 — antal besvarade frågor och vilken som är FÖRSTA obesvarade,
    // för återupptagningsbanderollen. Ren räkning, ingen ny datamodell.
    // B3.6 (2026-08-06): tre frågor, inte fyra — storlek borttagen ur
    // tratten (samma mönster som G7 redan satte för alder).
    function antalBesvarade(p: Foreningsprofil): number {
      let n = 0;
      if (p.kommunSlug) n++;
      if (p.verksamhet.length > 0) n++;
      if (p.sokt !== null) n++;
      return n;
    }

    function forstaObesvaradeSteg(p: Foreningsprofil): number {
      if (p.verksamhet.length === 0) return 2;
      if (p.sokt === null) return 3;
      return 4;
    }

    function visaAtervandOmBehovs() {
      if (!atervandEl || !atervandTextEl) return;
      const antal = antalBesvarade(profil);
      if (antal >= 3) {
        atervandEl.hidden = true;
        return;
      }
      // P1.C — formateraBevakarText tar {datum} också, men radMall har
      // ingen sådan platshållare, så den delen är ett no-op här.
      atervandTextEl.textContent = formateraBevakarText(antal, '', TRATT.besked.atervand.radMall, TRATT.besked.atervand.radMallSingular);
      atervandEl.hidden = false;
    }

    atervandFortsattKnapp?.addEventListener('click', () => goStep(forstaObesvaradeSteg(profil)));

    atervandMejlaKnapp?.addEventListener('click', () => {
      atervandForm?.removeAttribute('hidden');
      atervandMejlaKnapp.setAttribute('hidden', '');
    });

    atervandForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      atervandFelEl?.setAttribute('hidden', '');
      const data = new FormData(atervandForm);
      data.set('profil', JSON.stringify(profil));

      try {
        const res = await fetch('/api/mejla-tratt-lank', { method: 'POST', body: data });
        const json = await res.json();
        if (!res.ok || !json.ok) throw new Error('svar ej ok');
        atervandForm.hidden = true;
        atervandKvittoEl?.removeAttribute('hidden');
      } catch {
        atervandFelEl?.removeAttribute('hidden');
      }
    });

    // Återställ sparat svar. En återvändande session med sparad kommun
    // hoppar direkt till steg 4 (beskedet, B3.6: tre frågor + besked =
    // fyra steg, inte fem) — "Tillbaka" tar en till valfri fråga för att
    // ändra svar.
    markeraAktivaPillar();
    if (profil.kommunSlug) {
      step = 4;
      // M1: samma händelse som goStep()s väg dit — en återvändande
      // session som hoppar direkt till besked räknas likadant. Väntar in
      // hamtaKommunData() så kommunnamnet är samma slags värde som i
      // goStep() (kommunData.kommun, inte bara sluggen).
      hamtaKommunData(profil.kommunSlug).then(() => {
        trackEvent('tratt_besked', { kommun: kommunData?.kommun ?? null, sokt: profil.sokt });
      });
      visaAtervandOmBehovs();
    } else {
      updateStegUI();
    }
  }
</script>

