---
// Matchningstratten (turn-11, ombyggd 2026-07-27 till stegflöde per turn-12a)
// — "Vad kan er förening söka?" En fråga i fokus åt gången, sticky
// stegbar (räknare + kvittens + progress), besked visas först i steg 6.
// Route kommun-agnostisk (fråga 1 VÄLJER kommun, kan därför inte ligga
// under /kommun/[slug]/) — mitt förslag, inte instruerat.
//
// Källa: incoming/foreningsguiden-tratt-tryck-v3-livedata.html #turn-12
// (12a). All copy ur GUIDE_TRATT_COPY.ts, ingen text uppfunnen här.
// Matchningslogiken är riktig (src/lib/matching.ts) — ingen fejk-räknare,
// och den rörs INTE av denna ombyggnad (se plan:
// twinkling-wondering-emerson.md — "omgörning av ytan, inte av logiken").
//
// "Ändra svar"-knappen (TRATT.start.knappBorjaOm) går till steg 1 UTAN
// att nollställa sparade svar — mockens restart() nollställer allt, men
// sajten lovar "era svar sparas" (TRATT.besked.minne). Jacob 2026-07-27:
// etiketten "Börja om" ljög om vad knappen gör; "Ändra svar" beskriver
// exakt handlingen OCH löser Designs H6 (synlig väg att rätta ett svar).
// En återvändande session med sparad kommun hoppar direkt till steg 6
// (beskedet), samma som innan ombyggnaden; "Tillbaka" eller "Ändra svar"
// tar en till valfri fråga för att justera.
import Base from '../../layouts/Base.astro';
import KommunValjare from '../../components/KommunValjare.astro';
import RegistreringsHjalp from '../../components/RegistreringsHjalp.astro';
import { loadKommuner } from '../../lib/kommuner';
import { TRATT } from '../../../GUIDE_TRATT_COPY';

const kommuner = loadKommuner();
---
<Base title={TRATT.start.rubrik} description={TRATT.start.ingress}>
  <section class="tratt" data-tratt>
    <header class="tratt__header">
      <h1>{TRATT.start.rubrik}</h1>
      <p class="tratt__ingress">{TRATT.start.ingress}</p>
    </header>

    <div class="tratt__stegbar" data-tratt-stegbar>
      <div class="tratt__stegbar-rad">
        <p class="tratt__raknare" data-tratt-raknare aria-live="polite">{TRATT.raknare.tom}</p>
        <span class="tratt__kvittens" data-tratt-kvittens hidden aria-hidden="true"></span>
      </div>
      <span class="tratt__stegbar-progress"><span class="tratt__stegbar-fyllning" data-tratt-progress></span></span>
      <span class="tratt__stegbar-label" data-tratt-steg-label></span>
    </div>

    <div class="tratt__layout">
      <div class="tratt__frageflode">

        <div class="tratt__fraga" data-tratt-steg="1">
          <h2>{TRATT.fraga_kommun.fraga}</h2>
          <p class="tratt__hjalp">{TRATT.fraga_kommun.hjalp}</p>
          <div data-tratt-kommunvaljare>
            <KommunValjare kommuner={kommuner} selectMode={true} />
          </div>
          <div class="tratt__kommun-vald" data-tratt-kommun-vald hidden>
            <span>Vald: <strong data-tratt-kommun-vald-namn></strong></span>
            <button type="button" class="tratt__kommun-byt" data-tratt-kommun-byt>Byt</button>
          </div>
        </div>

        <div class="tratt__fraga" data-tratt-steg="2" data-tratt-fraga-container="verksamhet" hidden>
          <h2>{TRATT.fraga_verksamhet.fraga}</h2>
          <p class="tratt__hjalp">{TRATT.fraga_verksamhet.hjalp}</p>
          <div class="tratt__pillgrupp" data-tratt-fraga="verksamhet" role="group" aria-label={TRATT.fraga_verksamhet.fraga}>
            {TRATT.fraga_verksamhet.alternativ.map((a) => (
              <button type="button" class="tratt__pill" data-tratt-svar={a.id}>{a.etikett}</button>
            ))}
          </div>
          <button type="button" class="tratt__vidare" data-tratt-vidare>Vidare →</button>
        </div>

        <div class="tratt__fraga" data-tratt-steg="3" hidden>
          <h2>{TRATT.fraga_storlek.fraga}</h2>
          <p class="tratt__hjalp">{TRATT.fraga_storlek.hjalp}</p>
          <div class="tratt__pillgrupp" data-tratt-fraga="storlek" role="group" aria-label={TRATT.fraga_storlek.fraga}>
            {TRATT.fraga_storlek.alternativ.map((a) => (
              <button type="button" class="tratt__pill" data-tratt-svar={a.id}>{a.etikett}</button>
            ))}
          </div>
        </div>

        <div class="tratt__fraga" data-tratt-steg="4" hidden>
          <h2>{TRATT.fraga_tid.fraga}</h2>
          <p class="tratt__hjalp">{TRATT.fraga_tid.hjalp}</p>
          <div class="tratt__pillgrupp" data-tratt-fraga="alder" role="group" aria-label={TRATT.fraga_tid.fraga}>
            {TRATT.fraga_tid.alternativ.map((a) => (
              <button type="button" class="tratt__pill" data-tratt-svar={a.id}>{a.etikett}</button>
            ))}
          </div>
        </div>

        <div class="tratt__fraga" data-tratt-steg="5" hidden>
          <h2>{TRATT.fraga_sokt.fraga}</h2>
          <p class="tratt__hjalp">{TRATT.fraga_sokt.hjalp}</p>
          <div class="tratt__pillgrupp" data-tratt-fraga="sokt" role="group" aria-label={TRATT.fraga_sokt.fraga}>
            {TRATT.fraga_sokt.alternativ.map((a) => (
              <button type="button" class="tratt__pill" data-tratt-svar={a.id}>{a.etikett}</button>
            ))}
          </div>
        </div>

        <div class="tratt__nav" data-tratt-nav>
          <button type="button" class="tratt__nav-tillbaka" data-tratt-tillbaka>← Tillbaka</button>
          <button type="button" class="tratt__nav-omstart" data-tratt-omstart>{TRATT.start.knappBorjaOm}</button>
        </div>

      </div>

      <div class="tratt__besked" data-tratt-besked hidden>
        {/* H5 (SPEC: Det som återstår, 2026-07-28): återuppta en
           avbruten tratt. Hidden som default, visas av skriptet bara
           om profilen inte är komplett — se render()-anropande koden
           längst ner. */}
        <div class="tratt__atervand" data-tratt-atervand hidden>
          <p data-tratt-atervand-text></p>
          <div class="tratt__atervand-knappar">
            <button type="button" class="btn-primary" data-tratt-atervand-fortsatt>{TRATT.besked.atervand.knappFortsatt}</button>
            <button type="button" class="fg-btn--ghost" data-tratt-atervand-mejla>{TRATT.besked.atervand.knappMejla}</button>
          </div>
          <form class="tratt__atervand-form" data-tratt-atervand-form hidden>
            <input type="email" name="email" placeholder={TRATT.besked.atervand.epostPlaceholder} required autocomplete="email" />
            <button type="submit" class="btn-primary">{TRATT.besked.atervand.knappSkicka}</button>
            <p class="tratt__atervand-fel" data-tratt-atervand-fel hidden>Något gick fel. Försök igen.</p>
          </form>
          <p class="tratt__atervand-kvitto" data-tratt-atervand-kvitto hidden>{TRATT.besked.atervand.kvitto}</p>
        </div>

        <h2>{TRATT.besked.rubrik}</h2>

        <section class="tratt__grupp tratt__grupp--matchar">
          <h3>{TRATT.besked.kanSoka.rubrik}</h3>
          <p class="tratt__kostnadsram" data-tratt-kostnadsram hidden></p>
          <p class="tratt__sum-fotnot" data-tratt-sum-fotnot hidden></p>
          <p class="tratt__tom" data-tratt-matchar-tom hidden>{TRATT.besked.kanSoka.tom}</p>
          <ul class="tratt__bidraglista" data-tratt-matchar-lista></ul>
          {/* H9 (SPEC: Kluster 3, 2026-07-28): paketpris — bara när fler
             än ett bidrag matchar. Fylls i render(), se skriptet. */}
          <p class="tratt__paket" data-tratt-paket hidden></p>
        </section>

        <section class="tratt__grupp tratt__grupp--saknar" data-tratt-grupp-saknar hidden>
          <h3>{TRATT.besked.behover.rubrik}</h3>
          <ul class="tratt__bidraglista" data-tratt-saknar-lista></ul>
        </section>

        <section class="tratt__grupp tratt__grupp--borjahar" data-tratt-grupp-borjahar hidden>
          <h3>{TRATT.besked.borjaHar.rubrik}</h3>
          <p>{TRATT.besked.borjaHar.brodtext}</p>
          <details class="tratt__disclosure">
            <summary>{TRATT.besked.borjaHar.fallRubrik}</summary>
            <p>{TRATT.besked.borjaHar.fallText}</p>
          </details>
          <RegistreringsHjalp />
        </section>

        <p class="tratt__minne">{TRATT.besked.minne}</p>
        <p class="tratt__ansvar">{TRATT.ansvar}</p>

        {/* H7 (SPEC: Kluster 3, 2026-07-28): delbart besked — köpbeslutet
           fattas av styrelsen, inte kassören ensam. Mejlversionen
           innehåller de matchade bidragen direkt (api/dela-besked.ts),
           ingen länk som kräver att svaren fylls i på nytt. */}
        <div class="tratt__dela" data-tratt-dela>
          <h3>{TRATT.besked.dela.rubrik}</h3>
          <p>{TRATT.besked.dela.brodtext}</p>
          <div class="tratt__dela-knappar">
            <button type="button" class="fg-btn--ghost" data-tratt-dela-mejla>{TRATT.besked.dela.knappMejla}</button>
            <button type="button" class="fg-btn--ghost" data-tratt-dela-skriv-ut>{TRATT.besked.dela.knappSkrivUt}</button>
          </div>
          <form class="tratt__dela-form" data-tratt-dela-form hidden>
            <input type="email" name="email" placeholder={TRATT.besked.dela.epostPlaceholder} required autocomplete="email" />
            <button type="submit" class="btn-primary">{TRATT.besked.dela.knappSkicka}</button>
            <p class="tratt__dela-fel" data-tratt-dela-fel hidden>Något gick fel. Försök igen.</p>
          </form>
          <p class="tratt__dela-kvitto" data-tratt-dela-kvitto hidden>{TRATT.besked.dela.kvitto}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { matchKommun, harMatchningsdata, type MatchSkal } from '../../lib/matching';
  import { getForeningsprofil, saveForeningsprofil, type Foreningsprofil, type Medlemsbucket, type Aldersbucket, type SoktSvar } from '../../lib/foreningsprofil';
  import { formatDate, earliestDeadlineISO, todayISO, svenskLista, sumBeloppTak, daysUntil, getUrgency, type Bidrag, type Kommun, type Verksamhet } from '../../lib/kommunTyper';
  import { TRATT } from '../../../GUIDE_TRATT_COPY';
  import { PRIS_REGISTRERINGSUTKAST_ORE, PRIS_PAKET_ORE } from '../../lib/priser';

  const root = document.querySelector<HTMLElement>('[data-tratt]');
  if (root) {
    const raknareEl = root.querySelector<HTMLElement>('[data-tratt-raknare]');
    const kvittensEl = root.querySelector<HTMLElement>('[data-tratt-kvittens]');
    const progressEl = root.querySelector<HTMLElement>('[data-tratt-progress]');
    const stegLabelEl = root.querySelector<HTMLElement>('[data-tratt-steg-label]');
    const stegElement = root.querySelectorAll<HTMLElement>('[data-tratt-steg]');
    const tillbakaKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-tillbaka]');
    const omstartKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-omstart]');
    const vidareKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-vidare]');
    const beskedEl = root.querySelector<HTMLElement>('[data-tratt-besked]');
    const matcharListaEl = root.querySelector<HTMLElement>('[data-tratt-matchar-lista]');
    const matcharTomEl = root.querySelector<HTMLElement>('[data-tratt-matchar-tom]');
    const saknarGruppEl = root.querySelector<HTMLElement>('[data-tratt-grupp-saknar]');
    const saknarListaEl = root.querySelector<HTMLElement>('[data-tratt-saknar-lista]');
    const borjaHarGruppEl = root.querySelector<HTMLElement>('[data-tratt-grupp-borjahar]');
    const registreringWidget = root.querySelector<HTMLElement>('[data-registrering-hjalp]');
    const kommunvaljareWrapperEl = root.querySelector<HTMLElement>('[data-tratt-kommunvaljare]');
    const kommunValdEl = root.querySelector<HTMLElement>('[data-tratt-kommun-vald]');
    const kommunValdNamnEl = root.querySelector<HTMLElement>('[data-tratt-kommun-vald-namn]');
    const kommunBytKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-kommun-byt]');
    const kostnadsramEl = root.querySelector<HTMLElement>('[data-tratt-kostnadsram]');
    const sumFotnotEl = root.querySelector<HTMLElement>('[data-tratt-sum-fotnot]');
    const paketEl = root.querySelector<HTMLElement>('[data-tratt-paket]');
    const delaMejlaKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-dela-mejla]');
    const delaSkrivUtKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-dela-skriv-ut]');
    const delaForm = root.querySelector<HTMLFormElement>('[data-tratt-dela-form]');
    const delaFelEl = root.querySelector<HTMLElement>('[data-tratt-dela-fel]');
    const delaKvittoEl = root.querySelector<HTMLElement>('[data-tratt-dela-kvitto]');
    const atervandEl = root.querySelector<HTMLElement>('[data-tratt-atervand]');
    const atervandTextEl = root.querySelector<HTMLElement>('[data-tratt-atervand-text]');
    const atervandFortsattKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-atervand-fortsatt]');
    const atervandMejlaKnapp = root.querySelector<HTMLButtonElement>('[data-tratt-atervand-mejla]');
    const atervandForm = root.querySelector<HTMLFormElement>('[data-tratt-atervand-form]');
    const atervandFelEl = root.querySelector<HTMLElement>('[data-tratt-atervand-fel]');
    const atervandKvittoEl = root.querySelector<HTMLElement>('[data-tratt-atervand-kvitto]');

    const today = todayISO();
    let kommunData: Kommun | null = null;

    // Steget som är i fokus (1–5 = fråga N, 6 = klart/besked). En riktig
    // återvändande session (sparad kommun) hoppar direkt till 6 — se
    // motiveringen i filhuvudet.
    let step = 1;
    let advancing = false;
    let kvittensTimer: ReturnType<typeof setTimeout> | undefined;

    // H5 — "Mejla mig en länk": profilen kan komma in via ?fortsatt=
    // (en JSON-kodad Foreningsprofil, se api/mejla-tratt-lank.ts som
    // byggde länken ur SERVERVALIDERADE fält). Sparas i localStorage
    // direkt vid ankomst, så den vanliga sparad-läsningen nedan hittar
    // den — samma "en sanning" som allt annat i profilen.
    const fortsattParam = new URLSearchParams(window.location.search).get('fortsatt');
    if (fortsattParam) {
      try {
        const fortsattProfil = JSON.parse(fortsattParam) as Partial<Foreningsprofil>;
        if (fortsattProfil && typeof fortsattProfil === 'object') {
          saveForeningsprofil(fortsattProfil);
        }
      } catch {
        // Trasig/manipulerad länk — hoppa bara över, ingen krasch.
      }
    }

    const sparad = getForeningsprofil();
    const profil: Foreningsprofil = sparad ?? {
      kommunSlug: null,
      verksamhet: [],
      storlek: null,
      alder: null,
      sokt: null,
      uppdaterad: '',
    };

    function etikett<T extends string>(alternativ: { id: T; etikett: string }[], id: T | null): string {
      return alternativ.find((a) => a.id === id)?.etikett ?? '';
    }

    function manaderTillText(m: number): string {
      if (m < 12) return `${m} ${m === 1 ? 'månad' : 'månader'}`;
      return `${Math.round(m / 12)} år`;
    }

    function skalTillText(skal: MatchSkal, bidrag: Bidrag): string {
      switch (skal.falt) {
        case 'min_verksamhetstid_manader':
          return TRATT.besked.behover.saknarTid
            .replace('{krav}', manaderTillText(bidrag.min_verksamhetstid_manader ?? 0))
            .replace('{angivet}', etikett(TRATT.fraga_tid.alternativ, profil.alder));
        case 'min_medlemmar':
          return TRATT.besked.behover.saknarMedlemmar
            .replace('{krav}', String(bidrag.min_medlemmar))
            .replace('{angivet}', etikett(TRATT.fraga_storlek.alternativ, profil.storlek));
        case 'foreningstyp': {
          const etiketter = (bidrag.foreningstyp ?? []).map((v: Verksamhet) => etikett(TRATT.fraga_verksamhet.alternativ, v));
          return TRATT.besked.behover.saknarTyp.replace('{krav}', svenskLista(etiketter));
        }
        case 'kraver_registrering':
          return TRATT.besked.behover.saknarRegistrering;
        default:
          return '';
      }
    }

    // Fotnoten (Design turn-14) — null-belopp exkluderas ur summan ovan,
    // aldrig tyst. Skriver ALLTID en fotnot när capped > 0 (även vid
    // uncapped=0, "Summan av angivna maxbelopp för N bidrag." bekräftar
    // att INGET utelämnades, lika viktigt som att flagga när något gör det).
    function visaSumFotnot(capped: number, uncapped: number) {
      if (!sumFotnotEl) return;
      if (uncapped === 0) {
        sumFotnotEl.textContent = TRATT.besked.sumFotnotCappat.replace('{antal}', String(capped));
      } else {
        const uncappedText = uncapped === 1
          ? TRATT.besked.sumFotnotOkantEtt
          : TRATT.besked.sumFotnotOkantFlera.replace('{antal}', String(uncapped));
        sumFotnotEl.textContent = TRATT.besked.sumFotnotOkant
          .replace('{antal}', String(capped))
          .replace('{uncappedText}', uncappedText);
      }
      sumFotnotEl.hidden = false;
    }

    const URGENCY_LABEL: Record<'urgent' | 'attention' | 'positive', string> = { urgent: 'Bråttom', attention: 'Snart', positive: 'God tid' };

    function bidragMeta(bidrag: Bidrag): string {
      // dateISO är null för BÅDE löpande och okänd deadlines.typ
      // (earliestDeadlineISO), samma mönster som BidragCard/
      // KommunProgressions formatDeadlines — skilj dem explicit på
      // deadlines.typ, rör aldrig deadlines.datum direkt.
      const dateISO = earliestDeadlineISO(bidrag, today);
      if (!dateISO) {
        const text = bidrag.deadlines.typ === 'okand' ? 'inget publicerat ansökningsdatum' : 'löpande ansökan';
        return `${bidrag.belopp ?? 'Belopp ej publikt'} · ${text}`;
      }
      const dagar = daysUntil(dateISO, today);
      const urgency = getUrgency(dagar);
      const dagarText = dagar === 1 ? '1 dag kvar' : `${dagar} dagar kvar`;
      return `${bidrag.belopp ?? 'Belopp ej publikt'} · <span class="fg-chip fg-chip--${urgency}">${URGENCY_LABEL[urgency]}</span> sista dag ${formatDate(dateISO)} · ${dagarText}`;
    }

    function bidragLank(bidrag: Bidrag): string {
      return kommunData ? `/kommun/${kommunData.kommun_slug}/#bidrag-${bidrag.id}` : '#';
    }

    /** Matchande-antal just nu — 0 om ingen kommun är vald än (samma bas mocken räknar delta mot). */
    function currentMatchCount(): number {
      if (!kommunData) return 0;
      return matchKommun(profil, kommunData).matchar.length;
    }

    /** Kvittensen ("+N bidrag") — synlig kort efter varje svar, mekanisk
     * formatering (tecken + antal + ordet "bidrag"), ingen ny prosa. */
    function visaKvittens(delta: number) {
      if (!kvittensEl) return;
      window.clearTimeout(kvittensTimer);
      if (delta === 0) {
        kvittensEl.hidden = true;
        return;
      }
      kvittensEl.textContent = `${delta > 0 ? '+' : ''}${delta} bidrag`;
      kvittensEl.hidden = false;
      kvittensTimer = setTimeout(() => {
        if (kvittensEl) kvittensEl.hidden = true;
      }, 2500);
    }

    /** Visar exakt ETT tratt__fraga-steg och besked-panelen bara i steg 6
     * — döljs via `hidden` (aldrig tas bort ur DOM, samma regel som
     * KommunValjares sökfilter använder). */
    function updateStegUI() {
      stegElement.forEach((el) => {
        el.hidden = Number(el.dataset.trattSteg) !== step;
      });
      if (beskedEl) beskedEl.hidden = step !== 6 || !kommunData;
      if (tillbakaKnapp) tillbakaKnapp.hidden = step <= 1;
      if (stegLabelEl) stegLabelEl.textContent = step >= 6 ? 'Klart' : `Fråga ${step} av 5`;
      if (progressEl) progressEl.style.width = `${(Math.min(step - 1, 5) / 5) * 100}%`;
    }

    function goStep(n: number) {
      step = Math.max(1, Math.min(6, n));
      updateStegUI();
    }

    function render() {
      if (!kommunData) {
        if (raknareEl) raknareEl.textContent = TRATT.raknare.tom;
        updateStegUI();
        return;
      }

      const resultat = matchKommun(profil, kommunData);
      const antal = resultat.matchar.length;

      if (raknareEl) {
        raknareEl.textContent = antal === 0 ? TRATT.raknare.noll : antal === 1 ? TRATT.raknare.en : TRATT.raknare.trafffar.replace('{antal}', String(antal));
      }

      // harMatchningsdata (matching.ts): sant först när researchpasset
      // fyllt i minst ett matchningsfält för kommunen. Före dess är ALLA
      // bidrag trivialt "MATCHAR" (grov matchning per design — se
      // matchBidrag) och en summa över resultat.matchar vore kommunens
      // HELA pott framställd som personlig. Kostnadsramen väljer därför
      // mellan två helt olika mallar/datakällor beroende på detta flagg,
      // inte bara olika text på samma summa.
      const dataFinns = harMatchningsdata(kommunData);

      if (kostnadsramEl) {
        if (dataFinns) {
          const sum = sumBeloppTak(resultat.matchar);
          if (sum.capped > 0) {
            const mall = sum.capped === 1 ? TRATT.besked.kostnadsramEnkel : TRATT.besked.kostnadsram;
            kostnadsramEl.textContent = mall.replace('{summa}', sum.total.toLocaleString('sv-SE'));
            kostnadsramEl.hidden = false;
            visaSumFotnot(sum.capped, sum.uncapped);
          } else {
            kostnadsramEl.hidden = true;
            if (sumFotnotEl) sumFotnotEl.hidden = true;
          }
        } else {
          const sum = sumBeloppTak(kommunData.bidrag);
          if (sum.capped > 0) {
            kostnadsramEl.textContent = TRATT.besked.kostnadsramOgfiltrerad
              .replace(/{kommun}/g, kommunData.kommun)
              .replace('{summa}', sum.total.toLocaleString('sv-SE'));
            kostnadsramEl.hidden = false;
            visaSumFotnot(sum.capped, sum.uncapped);
          } else {
            kostnadsramEl.hidden = true;
            if (sumFotnotEl) sumFotnotEl.hidden = true;
          }
        }
      }

      if (matcharListaEl) {
        matcharListaEl.innerHTML = '';
        resultat.matchar.forEach((bidrag) => {
          const li = document.createElement('li');
          li.className = 'tratt__bidrag';
          li.innerHTML = `<a href="${bidragLank(bidrag)}">${bidrag.namn}</a><div class="tratt__bidrag-meta">${bidragMeta(bidrag)}</div>`;
          matcharListaEl.appendChild(li);
        });
      }
      if (matcharTomEl) matcharTomEl.hidden = resultat.matchar.length > 0;

      // H9 — paketpris, bara när fler än ETT bidrag matchar (ett enda
      // bidrag har inget "alla" att paketera).
      if (paketEl) {
        if (resultat.matchar.length > 1) {
          paketEl.textContent = TRATT.besked.paket.rad
            .replace('{antal}', String(resultat.matchar.length))
            .replace('{paketpris}', String(PRIS_PAKET_ORE / 100))
            .replace('{styckpris}', String(PRIS_REGISTRERINGSUTKAST_ORE / 100));
          paketEl.hidden = false;
        } else {
          paketEl.hidden = true;
        }
      }

      if (saknarGruppEl) saknarGruppEl.hidden = !dataFinns || resultat.saknar.length === 0;
      if (saknarListaEl) {
        saknarListaEl.innerHTML = '';
        resultat.saknar.forEach(({ bidrag, skal }) => {
          const li = document.createElement('li');
          li.className = 'tratt__bidrag';
          const skalText = skal.map((s) => skalTillText(s, bidrag)).filter(Boolean).join(' ');
          li.innerHTML = `<a href="${bidragLank(bidrag)}">${bidrag.namn}</a><div class="tratt__bidrag-meta">${skalText}</div>`;
          saknarListaEl.appendChild(li);
        });
      }

      if (borjaHarGruppEl) borjaHarGruppEl.hidden = !resultat.borjaHar;
      if (registreringWidget && kommunData) {
        registreringWidget.dataset.kommunSlug = kommunData.kommun_slug;
        const registreringLank = registreringWidget.querySelector<HTMLAnchorElement>('[data-registrering-lank]');
        if (registreringLank) registreringLank.href = `/kommun/${kommunData.kommun_slug}/registrera/`;
      }

      updateStegUI();
    }

    function markeraAktivaPillar() {
      root!.querySelectorAll<HTMLElement>('[data-tratt-fraga]').forEach((grupp) => {
        const fraga = grupp.dataset.trattFraga;
        grupp.querySelectorAll<HTMLButtonElement>('[data-tratt-svar]').forEach((pill) => {
          const varde = pill.dataset.trattSvar ?? '';
          let aktiv = false;
          if (fraga === 'verksamhet') aktiv = profil.verksamhet.includes(varde as Verksamhet);
          else if (fraga === 'storlek') aktiv = profil.storlek === varde;
          else if (fraga === 'alder') aktiv = profil.alder === varde;
          else if (fraga === 'sokt') aktiv = profil.sokt === varde;
          pill.classList.toggle('is-active', aktiv);
          pill.setAttribute('aria-pressed', String(aktiv));
        });
      });
    }

    // Fråga 1 kollapsar till en kort "Vald: {namn}"-rad efter val — annars
    // ligger hela sök+länslistan kvar orörd och ser ut som att klicket inte
    // gjorde något (Jacob-fyndet: väljaren måste synligt reagera).
    function visaValdKommun(namn: string) {
      if (kommunvaljareWrapperEl) kommunvaljareWrapperEl.hidden = true;
      if (kommunValdEl) kommunValdEl.hidden = false;
      if (kommunValdNamnEl) kommunValdNamnEl.textContent = namn;
    }

    function visaKommunvaljare() {
      if (kommunvaljareWrapperEl) kommunvaljareWrapperEl.hidden = false;
      if (kommunValdEl) kommunValdEl.hidden = true;
    }

    async function hamtaKommunData(slug: string, opts: { beforeCount?: number; advance?: boolean } = {}) {
      try {
        const res = await fetch(`/kommun-data/${slug}.json`);
        if (!res.ok) throw new Error('kommun-data 404');
        kommunData = (await res.json()) as Kommun;
      } catch {
        kommunData = null;
      }
      if (kommunData) {
        visaValdKommun(kommunData.kommun);
      }
      render();
      if (opts.advance) {
        visaKvittens(currentMatchCount() - (opts.beforeCount ?? 0));
        setTimeout(() => goStep(2), 450);
      }
    }

    root.addEventListener('kommunvaljare:valj', (event) => {
      const detail = (event as CustomEvent<{ slug: string; namn: string }>).detail;
      if (!detail?.slug) return;
      const before = currentMatchCount();
      profil.kommunSlug = detail.slug;
      saveForeningsprofil({ kommunSlug: profil.kommunSlug });
      hamtaKommunData(detail.slug, { beforeCount: before, advance: true });
    });

    kommunBytKnapp?.addEventListener('click', () => {
      visaKommunvaljare();
    });

    tillbakaKnapp?.addEventListener('click', () => goStep(step - 1));
    omstartKnapp?.addEventListener('click', () => goStep(1));
    vidareKnapp?.addEventListener('click', () => goStep(3));

    // H7 — delbart besked. Mejlversionen skickar bara ID-REFERENSER
    // (kommunSlug + matchade bidrag-id:n) till servern, som slår upp
    // namn/belopp/deadline själv (kommun.ts) — aldrig fritext från
    // klienten rakt in i ett utgående mejl.
    delaMejlaKnapp?.addEventListener('click', () => {
      delaForm?.removeAttribute('hidden');
      delaMejlaKnapp.setAttribute('hidden', '');
    });

    delaSkrivUtKnapp?.addEventListener('click', () => window.print());

    delaForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      delaFelEl?.setAttribute('hidden', '');
      if (!kommunData) return;

      const resultat = matchKommun(profil, kommunData);
      const data = new FormData(delaForm);
      data.set('kommun', kommunData.kommun_slug);
      resultat.matchar.forEach((b) => data.append('bidragId', b.id));

      try {
        const res = await fetch('/api/dela-besked', { method: 'POST', body: data });
        const json = await res.json();
        if (!res.ok || !json.ok) throw new Error('svar ej ok');
        delaForm.hidden = true;
        delaKvittoEl?.removeAttribute('hidden');
      } catch {
        delaFelEl?.removeAttribute('hidden');
      }
    });

    root.querySelectorAll<HTMLElement>('[data-tratt-fraga]').forEach((grupp) => {
      const fraga = grupp.dataset.trattFraga;
      const fragaWrapper = grupp.closest<HTMLElement>('[data-tratt-steg]');
      const eigenStep = fragaWrapper ? Number(fragaWrapper.dataset.trattSteg) : null;

      grupp.querySelectorAll<HTMLButtonElement>('[data-tratt-svar]').forEach((pill) => {
        pill.addEventListener('click', () => {
          if (advancing) return;
          const varde = pill.dataset.trattSvar ?? '';
          const before = currentMatchCount();

          if (fraga === 'verksamhet') {
            const v = varde as Verksamhet;
            profil.verksamhet = profil.verksamhet.includes(v) ? profil.verksamhet.filter((x) => x !== v) : [...profil.verksamhet, v];
            saveForeningsprofil({ verksamhet: profil.verksamhet });
          } else if (fraga === 'storlek') {
            profil.storlek = (profil.storlek === varde ? null : varde) as Medlemsbucket | null;
            saveForeningsprofil({ storlek: profil.storlek });
          } else if (fraga === 'alder') {
            profil.alder = (profil.alder === varde ? null : varde) as Aldersbucket | null;
            saveForeningsprofil({ alder: profil.alder });
          } else if (fraga === 'sokt') {
            profil.sokt = (profil.sokt === varde ? null : varde) as SoktSvar | null;
            saveForeningsprofil({ sokt: profil.sokt });
          }

          markeraAktivaPillar();
          visaKvittens(currentMatchCount() - before);
          render();

          // Verksamhet är flerval — ingen auto-advance, "Vidare"-knappen
          // (steg 2) styr det istället, samma skillnad som mocken gör.
          if (fraga !== 'verksamhet' && eigenStep !== null) {
            advancing = true;
            setTimeout(() => {
              advancing = false;
              goStep(eigenStep + 1);
            }, 450);
          }
        });
      });
    });

    // H5 — antal besvarade frågor (max 5) och vilken som är FÖRSTA
    // obesvarade, för återupptagningsbanderollen. Ren räkning, ingen ny
    // datamodell.
    function antalBesvarade(p: Foreningsprofil): number {
      let n = 0;
      if (p.kommunSlug) n++;
      if (p.verksamhet.length > 0) n++;
      if (p.storlek !== null) n++;
      if (p.alder !== null) n++;
      if (p.sokt !== null) n++;
      return n;
    }

    function forstaObesvaradeSteg(p: Foreningsprofil): number {
      if (p.verksamhet.length === 0) return 2;
      if (p.storlek === null) return 3;
      if (p.alder === null) return 4;
      if (p.sokt === null) return 5;
      return 6;
    }

    function visaAtervandOmBehovs() {
      if (!atervandEl || !atervandTextEl) return;
      const antal = antalBesvarade(profil);
      if (antal >= 5) {
        atervandEl.hidden = true;
        return;
      }
      atervandTextEl.textContent = TRATT.besked.atervand.radMall.replace('{antal}', String(antal));
      atervandEl.hidden = false;
    }

    atervandFortsattKnapp?.addEventListener('click', () => goStep(forstaObesvaradeSteg(profil)));

    atervandMejlaKnapp?.addEventListener('click', () => {
      atervandForm?.removeAttribute('hidden');
      atervandMejlaKnapp.setAttribute('hidden', '');
    });

    atervandForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      atervandFelEl?.setAttribute('hidden', '');
      const data = new FormData(atervandForm);
      data.set('profil', JSON.stringify(profil));

      try {
        const res = await fetch('/api/mejla-tratt-lank', { method: 'POST', body: data });
        const json = await res.json();
        if (!res.ok || !json.ok) throw new Error('svar ej ok');
        atervandForm.hidden = true;
        atervandKvittoEl?.removeAttribute('hidden');
      } catch {
        atervandFelEl?.removeAttribute('hidden');
      }
    });

    // Återställ sparat svar. En återvändande session med sparad kommun
    // hoppar direkt till steg 6 (beskedet) — samma beteende som innan
    // ombyggnaden — "Tillbaka" tar en till valfri fråga för att ändra svar.
    markeraAktivaPillar();
    if (profil.kommunSlug) {
      step = 6;
      hamtaKommunData(profil.kommunSlug);
      visaAtervandOmBehovs();
    } else {
      updateStegUI();
    }
  }
</script>

