---
// Prissidan — J2 (2026-08-16, PRISTEXTER.md): "Två produkter, inte tre —
// registreringschecklistan och bidragsutkastet är samma sak." Ett kort
// (PRIS.hjalp, 249 kr) i stället för de två tidigare {{FABLE:}}-korten.
// Priset hämtas ENBART ur priser.ts (en sanning) — aldrig hårdkodat här.
//
// Abonnemangskortet är bakom ABONNEMANG_LEVERANS_LIVE (priser.ts, false
// idag) — PRISTEXTER.md: "Renderas inte förrän leveransen finns...
// Tills dess visas bara engångspriset." Ingen CTA på abonnemangskortet
// även när grinden öppnas: checkout/abonnemang.ts finns, men ingen sida
// länkar dit än (samma lucka som innan J2, oförändrad, flaggad i
// rapporten).
import Base from '../../layouts/Base.astro';
import BreadcrumbList from '../../components/BreadcrumbList.astro';
import { PRIS, ATERBETALNING } from '../../lib/content';
import { PRIS_REGISTRERINGSUTKAST_ORE, PRIS_ABONNEMANG_ORE, ABONNEMANG_LEVERANS_LIVE } from '../../lib/priser';

const hjalpKr = PRIS_REGISTRERINGSUTKAST_ORE / 100;
const abonnemangKr = PRIS_ABONNEMANG_ORE / 100;
---
<Base title={PRIS.metaTitle} description={PRIS.metaDescription}>
  <BreadcrumbList items={[
    { name: 'Startsida', url: '/' },
    { name: 'Priser', url: '/pris/' },
  ]} />

  <h1>{PRIS.h1}</h1>
  <p class="pris-intro">{PRIS.intro}</p>

  <div class:list={['pris-grid', { 'pris-grid--en': !ABONNEMANG_LEVERANS_LIVE }]}>
    <div class="fg-card pris-kort">
      <h2>{PRIS.hjalp.namn}</h2>
      <p class="pris-kort__pris">{hjalpKr} kr</p>
      {PRIS.hjalp.beskrivning.map((stycke) => <p>{stycke}</p>)}
      <a href="/matcha/" class="btn-primary">{PRIS.cta} →</a>
    </div>

    {ABONNEMANG_LEVERANS_LIVE && (
      <div class="fg-card pris-kort">
        <h2>{PRIS.abonnemang.namn}</h2>
        <p class="pris-kort__pris">{abonnemangKr} kr <span class="pris-kort__per">{PRIS.abonnemang.perAr}</span></p>
        {PRIS.abonnemang.beskrivning.map((stycke) => <p>{stycke}</p>)}
      </div>
    )}
  </div>

  <div class="pris-aterbetalning">
    <h2>{ATERBETALNING.rubrik}</h2>
    {ATERBETALNING.stycken.map((stycke) => <p>{stycke}</p>)}
  </div>
</Base>

<style>
  .pris-intro {
    max-width: 60ch;
    margin: 0 0 var(--fg-space-7);
  }

  .pris-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--fg-space-5);
    margin-bottom: var(--fg-space-8);
  }

  .pris-kort {
    padding: var(--fg-card-padding);
  }

  .pris-kort h2 {
    margin: 0 0 var(--fg-space-2);
    font-size: var(--fg-text-h2);
  }

  .pris-kort__pris {
    font-family: var(--fg-font-display);
    font-weight: var(--fg-weight-display);
    font-size: var(--fg-text-h1);
    color: var(--fg-ink);
    margin: 0 0 var(--fg-space-3);
  }

  .pris-kort__per {
    font-family: var(--fg-font-sans);
    font-weight: normal;
    font-size: var(--fg-text-label);
    color: var(--fg-ink-muted);
  }

  .pris-kort p {
    margin: 0 0 var(--fg-space-4);
  }

  .pris-aterbetalning {
    max-width: 68ch;
    padding-top: var(--fg-space-6);
    border-top: var(--fg-border-inner) dashed var(--fg-border);
  }

  .pris-aterbetalning h2 {
    font-size: var(--fg-text-h2);
    margin: 0 0 var(--fg-space-3);
  }

  @media (min-width: 720px) {
    .pris-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* J2 — abonnemanget bakom sin grind: ett kort ska inte sträckas
       över hela tvåkolumnsbredden när det andra kortet inte renderas. */
    .pris-grid--en {
      grid-template-columns: minmax(0, 1fr) 1fr;
    }

    .pris-grid--en .pris-kort {
      grid-column: 1;
    }
  }
</style>
