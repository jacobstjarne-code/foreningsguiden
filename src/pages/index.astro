---
// Startsida — §5 punkt 1 UPPDRAG_POC.md: värdeproposition, kommunväljare,
// deadlineöversikt. Kommunväljaren och deadlineöversikten är datadrivna
// (Code); all löptext kommer från content.ts (Fable).
import Base from '../layouts/Base.astro';
import UrgencyChip from '../components/UrgencyChip.astro';
import KommunValjare from '../components/KommunValjare.astro';
import { loadKommuner, getDeadlineEntries, formatDate, daysUntil, getUrgency, todayISO, KATEGORI_LABELS } from '../lib/kommuner';
import { START } from '../lib/content';

const kommuner = loadKommuner();
const today = todayISO();
const allaKommandeDeadlines = getDeadlineEntries(today).filter((e) => !e.isLopande);
const kommandeDeadlines = allaKommandeDeadlines.slice(0, 5);
---
<Base title={START.metaTitle} description={START.metaDescription}>
  <h1>{START.h1}</h1>
  <p>{START.hero}</p>

  <p class="forstasida-aggregat" data-forstasida-aggregat data-antal-deadlines={allaKommandeDeadlines.length}></p>

  <section>
    <h2>{START.kommunvaljareRubrik}</h2>
    <KommunValjare kommuner={kommuner} />
  </section>

  <section>
    <h2>Närmast i tid</h2>
    <p>{START.kalenderPuff}</p>
    <table class="deadline-table">
      <thead>
        <tr><th>Läge</th><th>Datum</th><th>Bidrag</th><th>Kommun</th><th>Kategori</th></tr>
      </thead>
      <tbody>
        {kommandeDeadlines.map((e) => (
          <tr>
            <td><UrgencyChip urgency={getUrgency(daysUntil(e.dateISO!, today))} /></td>
            <td>{formatDate(e.dateISO!)}</td>
            <td><a href={`/kommun/${e.kommunSlug}/`}>{e.bidragNamn}</a></td>
            <td>{e.kommun}</td>
            <td>{e.kategori.map((k) => KATEGORI_LABELS[k]).join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p><a href="/deadlines/">Se hela deadlinekalendern →</a></p>
  </section>
</Base>

<script>
  import { hamtaBevakningsantalGlobalt, BEVAKNING_GOLV_GLOBALT } from '../lib/bevakningKlient';

  const el = document.querySelector<HTMLElement>('[data-forstasida-aggregat]');
  if (el) {
    // Under golvet: antal bevakade deadlines (statiskt, redan i sidans
    // data — INTE samma tal som KommunValjares "X KOMMUNER TILLGÄNGLIGA"
    // några rader ner, medvetet valt för att inte upprepa samma siffra).
    const antalDeadlines = Number(el.dataset.antalDeadlines ?? '0');
    hamtaBevakningsantalGlobalt().then((antal) => {
      if (antal !== null && antal >= BEVAKNING_GOLV_GLOBALT) {
        // TODO(Fable): skriv den skarpa raden här — antal är ett riktigt,
        // live tal ur Redis (getAllConfirmedSubscribers().length), aldrig
        // hårdkodat. Platshållaren nedan är medvetet ingen färdig text —
        // Code skriver inte svensk säljcopy. Golvet (50) gör att denna
        // gren i praktiken inte visas än på den nylanserade sajten.
        el.textContent = `[Fable] ${antal} föreningar bevakar sina deadlines`;
      } else if (antalDeadlines > 0) {
        el.textContent = `${antalDeadlines} kommande deadlines bevakade just nu`;
      }
    });
  }
</script>
