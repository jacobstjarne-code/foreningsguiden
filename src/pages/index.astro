---
// Startsida — omgjord D5 (ARBETSORDER 2026-08-11, mock 9e): sökfältet
// primär ingång, tratten kvar som sekundär rad under (Jacobs beslut
// 2026-08-11: "bygg mockens sökfält-först och behåll tratten som
// sekundär rad under, så förlorar vi ingen ingång och beslutet kan tas
// på data om några veckor" — M2/tratt_start-mätningen, samma commit-
// session, ger just det underlaget). De tre förklaringskorten (passar/
// kan gälla/börja här) utgår. 290-kommunerslistan flyttad till en egen
// indexerad URL, /kommuner/ (SEO/GEO, samma princip som D1 redan
// etablerade för bidragssidorna) — sökfältet här postar dit med ?sok=.
//
// Tidigare (2026-07-27–2026-08-11): tratten var ensam primär ingång,
// katalogversionen (sökfält + LiveDataKort överst) hade blivit en
// orefererad orphan. All text ur content.ts/GUIDE_TRATT_COPY.ts +
// mocken (9e, ordagrant — ARBETSORDER: "mockarna är auktoritativa för
// form och ytcopy") — ingen ny svensk prosa skriven här.
//
// H1-bytet: DESCRIPTOR ("Vet vad din förening kan söka") var sidans H1,
// men står REDAN i sidhuvudet på varje sida (Base.astro, .site-header__
// descriptor) — att upprepa den som H1 här var alltid en dubblering.
// Mockens sökrubrik äger H1. content.ts:s START.h1/hero/heroKort (skrivna
// för en tidigare sökfälts-version, medvetet lämnade oanvända "för
// framtida bruk") används INTE här.
//
// G7 (2026-08-12, Jacob): tratt-sektionens H2 återanvände samma DESCRIPTOR-
// sträng — dubblering kvarstod, bara en nivå ner. Bytt mot TRATT.start.rubrik
// ("Vad kan er förening söka?"), som redan fanns i GUIDE_TRATT_COPY.ts men
// aldrig konsumerades här — ingen ny svensk text skriven.
import Base from '../layouts/Base.astro';
import UrgencyChip from '../components/UrgencyChip.astro';
import LiveDataKort from '../components/LiveDataKort.astro';
import { loadKommuner, getDeadlineEntries, formatDate, daysUntil, getUrgency, todayISO } from '../lib/kommuner';
import { START, SIDFOT, SITE_NAMN } from '../lib/content';
import { TRATT } from '../../GUIDE_TRATT_COPY';

const kommuner = loadKommuner();
const today = todayISO();
// Bugg 2026-08-03 (Jacob): flera bidrag i samma kommun kan dela nästa-
// datum, och entries är en rad per (bidrag × datum) — dedupar till
// högst en rad per kommun (listan är redan datumsorterad), tar den
// allra NÄRMASTE för D5:s enda aptitretare-rad (var 5 rader före D5,
// se historik i git — "Närmast i tid"-tabellen är kvar i sin helhet på
// /deadlines/, bara förstasidans FÖRHANDSVISNING kortades till en rad).
const settaKommuner = new Set<string>();
const kommandeDeadlines = [];
for (const e of getDeadlineEntries(today).filter((e) => !e.isLopande)) {
  if (settaKommuner.has(e.kommunSlug)) continue;
  settaKommuner.add(e.kommunSlug);
  kommandeDeadlines.push(e);
  break;
}
const narmast = kommandeDeadlines[0] ?? null;
const totalBidrag = kommuner.reduce((sum, k) => sum + k.bidrag.length, 0);
---
<Base title={START.metaTitle} description={START.metaDescription}>
  {/* D5 — mockens sökfält-först (9e). Postar till /kommuner/ (?sok=),
     som förifyller samma KommunValjare-sökning SSR. */}
  <section class="start-sok">
    <p class="start-sok__eyebrow">{SITE_NAMN}</p>
    <h1>Vad kan er förening få pengar för?</h1>
    <form class="start-sok__form" action="/kommuner/" method="GET">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
      <input type="text" name="sok" placeholder="Skriv er kommun" autocomplete="off" />
    </form>
  </section>

  <p class="start-prisloftet">
    Att hitta bidragen, se vad kommunen kräver och få påminnelse före sista dag är <strong>gratis</strong>. Vi tar betalt för arbetet.
  </p>

  {narmast && (
    <div class="start-aptitretare">
      <UrgencyChip urgency={getUrgency(daysUntil(narmast.dateISO!, today))} />
      <span class="start-aptitretare__namn">
        <span class={narmast.deadlineStatus === 'olast' ? 'fg-void-mark fg-void-mark--inline' : 'fg-read-mark fg-read-mark--inline'} aria-hidden="true"></span>
        {narmast.bidragNamn}
      </span>
      <span class="start-aptitretare__kommun">{narmast.kommun}</span>
    </div>
  )}
  <a href="/deadlines/" class="start-aptitretare__lank">Se alla deadlines →</a>

  <LiveDataKort totalBidrag={totalBidrag} totalKommuner={kommuner.length} />

  {/* D5 — tratten kvar, nu sekundär rad under sökfältet i stället för
     sidans enda ingång (se filhuvudets kommentar om Jacobs beslut). Text
     helt oförändrad, bara rubrikens nivå (H1 → H2, se filhuvudet). */}
  <section class="start-hero">
    <h2>{TRATT.start.rubrik}</h2>
    <p class="start-hero__ingress">{TRATT.start.ingress}</p>
    <a href="/matcha/" class="btn-primary">{TRATT.start.startknapp} →</a>
    <p class="start-disclaimer">{SIDFOT.kortText}</p>
    <p class="start-hero__senast-avlast">{TRATT.start.senastAvlastRad}</p>
  </section>
</Base>

<style>
  .start-sok {
    max-width: var(--fg-lasbredd);
    background: var(--fg-ink);
    color: var(--fg-on-accent);
    border-radius: var(--fg-radius-card);
    padding: var(--fg-space-7) var(--fg-space-6);
    margin-bottom: var(--fg-space-6);
  }

  .start-sok__eyebrow {
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-label);
    font-weight: var(--fg-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg-accent) 65%, var(--fg-on-accent));
    margin: 0 0 var(--fg-space-2);
  }

  .start-sok h1 {
    font-family: var(--fg-font-display);
    font-weight: var(--fg-weight-display);
    font-size: var(--fg-text-display);
    line-height: 1.1;
    color: var(--fg-on-accent);
    margin: 0 0 var(--fg-space-5);
  }

  .start-sok__form {
    display: flex;
    align-items: center;
    gap: var(--fg-space-3);
    background: var(--fg-surface);
    border-radius: var(--fg-radius-control);
    padding: var(--fg-space-3) var(--fg-space-4);
  }

  .start-sok__form svg {
    flex: none;
    color: var(--fg-ink-muted);
  }

  .start-sok__form input {
    flex: 1;
    border: none;
    outline: none;
    font-family: var(--fg-font-sans);
    font-size: var(--fg-text-body-lg);
    color: var(--fg-ink);
    min-height: 28px;
  }

  .start-prisloftet {
    max-width: var(--fg-lasbredd);
    padding-bottom: var(--fg-space-5);
    border-bottom: var(--fg-border-inner) dashed var(--fg-border);
    margin: 0 0 var(--fg-space-5);
  }

  .start-aptitretare {
    display: flex;
    align-items: center;
    gap: var(--fg-space-3);
    background: var(--fg-surface-sunken);
    border-radius: var(--fg-radius-control);
    padding: var(--fg-space-3) var(--fg-space-4);
  }

  .start-aptitretare__namn {
    flex: 1;
    font-weight: var(--fg-weight-bold);
  }

  .start-aptitretare__kommun {
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-mono);
    color: var(--fg-ink-muted);
  }

  .start-aptitretare__lank {
    display: block;
    font-size: var(--fg-text-label);
    font-weight: var(--fg-weight-bold);
    color: var(--fg-accent);
    margin: var(--fg-space-2) 0 var(--fg-space-8);
  }

  .start-hero {
    max-width: 60ch;
    margin-top: var(--fg-space-8);
    padding-top: var(--fg-space-7);
    border-top: var(--fg-border-inner) dashed var(--fg-border);
  }

  .start-hero h2 {
    font-family: var(--fg-font-display);
    font-weight: var(--fg-weight-display);
    font-size: var(--fg-text-h1);
    letter-spacing: -0.01em;
  }

  .start-hero__ingress {
    font-size: var(--fg-text-body-lg);
    color: var(--fg-ink-muted);
    margin: var(--fg-space-4) 0 var(--fg-space-6);
  }

  .start-hero .btn-primary {
    margin-bottom: var(--fg-space-5);
  }

  .start-hero__senast-avlast {
    font-size: var(--fg-text-label);
    color: var(--fg-ink-muted);
    margin-top: var(--fg-space-3);
  }
</style>
