---
// Startsida — omgjord 2026-07-27 (Design turn-12b): tratten är den
// primära ingången, kommunbläddring och deadlinekalendern sekundära/
// tertiära vägar. Tidigare version (katalog med LiveDataKort ovanpå)
// hade ingen länk till /matcha/ någonstans på sajten — tratten var en
// helt orefererad orphan-sida. All text ur content.ts/GUIDE_TRATT_COPY.ts,
// ingen ny svensk prosa här (se plan: twinkling-wondering-emerson.md).
//
// Förhandsvisningskortens underrader och färskhetsraden (Jacob 2026-07-27,
// GUIDE_TRATT_COPY.ts TRATT.besked.kortUnder*/TRATT.start.senastAvlastRad)
// var flaggade som saknad copy vid första leveransen — tillagda nu.
//
// FIX 2026-07-31 (Jacob): senastAvlast var tidigare det SENASTE
// verifierad-datumet — cherry-plockade den enskilt bäst avlästa kommunen
// och presenterade den som om den beskrev HELA korpusen. Ärligt
// färskhetsbesked är det ÄLDSTA verifierad-datumet: "det har gått som
// mest X dagar sedan vi läste av en källa", inte "vår senaste avläsning
// var för Y dagar sedan". Samma resonemang som STALE_THRESHOLD_DAYS
// (kommunTyper.ts) redan bygger på — någon kommun ÄR alltid äldst.
import Base from '../layouts/Base.astro';
import UrgencyChip from '../components/UrgencyChip.astro';
import KommunValjare from '../components/KommunValjare.astro';
import LiveDataKort from '../components/LiveDataKort.astro';
import { loadKommuner, getDeadlineEntries, formatDate, daysUntil, getUrgency, todayISO, KATEGORI_LABELS } from '../lib/kommuner';
import { START, SIDFOT, DESCRIPTOR } from '../lib/content';
import { TRATT } from '../../GUIDE_TRATT_COPY';

const kommuner = loadKommuner();
const today = todayISO();
// Bugg 2026-08-03 (Jacob): fem Pajala-rader i förhandsvisningen — flera
// bidrag i samma kommun kan dela nästa-datum, och entries är en rad per
// (bidrag × datum), inte en rad per kommun. Förhandsvisningen ska visa
// SPRIDNING (vilka kommuner har något snart), inte "vilken kommun råkar
// ha flest bidrag på samma dag" — full listan med alla bidrag finns redan
// på /deadlines/. Dedupar till högst en rad per kommun, tar den NÄRMASTE
// (listan är redan datumsorterad från getDeadlineEntries).
const settaKommuner = new Set<string>();
const kommandeDeadlines = [];
for (const e of getDeadlineEntries(today).filter((e) => !e.isLopande)) {
  if (settaKommuner.has(e.kommunSlug)) continue;
  settaKommuner.add(e.kommunSlug);
  kommandeDeadlines.push(e);
  if (kommandeDeadlines.length >= 5) break;
}
const totalBidrag = kommuner.reduce((sum, k) => sum + k.bidrag.length, 0);
// Sitewide färskhetsdatum för TRATT.start.senastAvlastRad — det ÄLDSTA
// verifierad-datumet över alla kommuner (inte ett påhittat, inte "idag").
const senastAvlast = kommuner.reduce((min, k) => (k.verifierad < min ? k.verifierad : min), kommuner[0]?.verifierad ?? today);
---
<Base title={START.metaTitle} description={START.metaDescription}>
  <section class="start-hero">
    <h1>{DESCRIPTOR}</h1>
    <p class="start-hero__ingress">{TRATT.start.ingress}</p>
    <a href="/matcha/" class="btn-primary">{TRATT.start.startknapp} →</a>
    <p class="start-disclaimer">{SIDFOT.kortText}</p>
    <p class="start-hero__senast-avlast">{TRATT.start.senastAvlastRad.replace('{datum}', formatDate(senastAvlast))}</p>
  </section>

  <div class="start-forhandsvisning">
    <div class="fg-card start-forhandsvisning__kort">
      <h3>{TRATT.besked.kanSoka.rubrik}</h3>
      <p>{TRATT.besked.kortUnderMatchar}</p>
    </div>
    <div class="fg-card start-forhandsvisning__kort">
      <h3>{TRATT.besked.behover.rubrik}</h3>
      <p>{TRATT.besked.kortUnderSaknar}</p>
    </div>
    <div class="fg-card start-forhandsvisning__kort">
      <h3>{TRATT.besked.borjaHar.rubrik}</h3>
      <p>{TRATT.besked.kortUnderBorjaHar}</p>
    </div>
  </div>

  <LiveDataKort totalBidrag={totalBidrag} totalKommuner={kommuner.length} />

  <section class="start-sekundar">
    <h2>{START.kommunvaljareRubrik}</h2>
    <KommunValjare kommuner={kommuner} />
  </section>

  <section>
    <h2>Närmast i tid</h2>
    <p>{START.kalenderPuff}</p>
    <table class="deadline-table">
      <thead>
        <tr><th>Läge</th><th>Datum</th><th>Bidrag</th><th>Kommun</th><th>Kategori</th></tr>
      </thead>
      <tbody>
        {kommandeDeadlines.map((e) => (
          <tr>
            <td><UrgencyChip urgency={getUrgency(daysUntil(e.dateISO!, today))} /></td>
            <td>{formatDate(e.dateISO!)}</td>
            <td><a href={`/kommun/${e.kommunSlug}/#bidrag-${e.bidragId}`}>{e.bidragNamn}</a></td>
            <td>{e.kommun}</td>
            <td>{e.kategori.map((k) => KATEGORI_LABELS[k]).join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p><a href="/deadlines/">Se hela deadlinekalendern →</a></p>
  </section>
</Base>

<style>
  .start-hero {
    max-width: 60ch;
    margin-bottom: var(--fg-space-8);
  }

  .start-hero h1 {
    font-family: var(--fg-font-display);
    font-weight: var(--fg-weight-display);
    font-size: var(--fg-text-display);
    letter-spacing: -0.01em;
  }

  .start-hero__ingress {
    font-size: var(--fg-text-body-lg);
    color: var(--fg-ink-muted);
    margin: var(--fg-space-4) 0 var(--fg-space-6);
  }

  .start-hero .btn-primary {
    margin-bottom: var(--fg-space-5);
  }

  .start-hero__senast-avlast {
    font-size: var(--fg-text-label);
    color: var(--fg-ink-muted);
    margin-top: var(--fg-space-3);
  }

  .start-forhandsvisning {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--fg-space-5);
    margin-bottom: var(--fg-space-8);
  }

  .start-forhandsvisning__kort {
    padding: var(--fg-card-padding);
  }

  .start-forhandsvisning__kort h3 {
    margin: 0;
  }

  .start-forhandsvisning__kort p {
    margin: var(--fg-space-2) 0 0;
    font-size: var(--fg-text-body);
    color: var(--fg-ink-muted);
  }

  .start-sekundar {
    margin-top: var(--fg-space-8);
  }

  @media (max-width: 640px) {
    .start-forhandsvisning {
      grid-template-columns: 1fr;
    }
  }
</style>
