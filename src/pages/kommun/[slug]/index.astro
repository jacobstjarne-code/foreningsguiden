---
// Kommunsidans ROUTE — H4 (SPEC_ATERSTAENDE_HAL.md, Kluster 4): genererar
// EN sida per samtliga 290 KOMMUNFACIT-slugs, inte bara de med datafil.
// Grenar tidigt mellan KommunSidaFull (kommun finns i loadKommuner()) och
// KommunLandningsSida (giltig slug, ingen datafil än — "Vi täcker inte
// {kommun} än" i stället för Vercels generiska 404). Tidigare (innan H4)
// itererade getStaticPaths BARA loadKommuner() — en giltig men otäckt
// slug föll då på 404, oskiljbar från en helt fabricerad slug.
import { loadKommuner } from '../../../lib/kommuner';
import { KOMMUNFACIT } from '../../../lib/kommunlan';
import KommunSidaFull from '../../../components/KommunSidaFull.astro';
import KommunLandningsSida from '../../../components/KommunLandningsSida.astro';

export function getStaticPaths() {
  const bySlug = new Map(loadKommuner().map((k) => [k.kommun_slug, k]));
  return KOMMUNFACIT.map((facit) => ({
    params: { slug: facit.slug },
    props: { kommun: bySlug.get(facit.slug) ?? null, kommunNamn: facit.namn },
  }));
}

const { kommun, kommunNamn } = Astro.props;
const { slug } = Astro.params;
---
{kommun ? (
  <KommunSidaFull kommun={kommun} />
) : (
  <KommunLandningsSida kommunSlug={slug} kommunNamn={kommunNamn} />
)}
