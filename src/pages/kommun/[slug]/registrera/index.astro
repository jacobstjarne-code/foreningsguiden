---
// Registreringsutkastet — SPEC_UTKASTGENERATOR.md §4: den viktigaste grenen,
// leverbar NU utan golden set (till skillnad från bidragsutkastet, §3/§5).
// Formell fullständighet mot kommunens PUBLICERADE forutsattningar — hittar
// aldrig på fakta om föreningen (§8), markerar bara vad som krävs och var.
//
// Struktur mappar direkt mot Kommun.forutsattningar[] (redan validerad data,
// 90/99 kommuner har den ifylld). Samma VAGLEDNING.station3-mallar som
// KommunProgression Station 3 redan använder — ingen ny svensk text skriven
// här, bara samma innehåll i dokumentformat i stället för inline-prosa.
//
// Genereras för ALLA kommuner, även de utan forutsattningar (samma
// "inget särskilt förkrav funnet"-fallback som Station 3).
import Base from '../../../../layouts/Base.astro';
import BreadcrumbList from '../../../../components/BreadcrumbList.astro';
import { loadKommuner } from '../../../../lib/kommuner';
import type { Kommun } from '../../../../lib/kommuner';
import { VAGLEDNING, BEVAKNING, KVITTOSIDA, ATERBETALNING, KOPYTAN_1E } from '../../../../lib/content';
import { TRATT } from '../../../../../GUIDE_TRATT_COPY';
import { PRIS_REGISTRERINGSUTKAST_ORE, momsAndelOre } from '../../../../lib/priser';
import { genereraRegistreringsUtkast } from '../../../../lib/utkastGenerator';
import { harvestBilagor } from '../../../../lib/kopDokument';

export function getStaticPaths() {
  return loadKommuner().map((kommun) => ({
    params: { slug: kommun.kommun_slug },
    props: { kommun },
  }));
}

const { kommun } = Astro.props as { kommun: Kommun };
const forutsattningar = [...kommun.forutsattningar].sort((a, b) => a.ordning - b.ordning);
const titel = `Registreringschecklista — ${kommun.kommun}`;

// B2 (SPRINT: Produkten, Opus/Fable 2026-07-31): bilagorna nämndes aldrig
// på den fria sidan, bara i det köpta dokumentet. genereraRegistreringsUtkast
// + harvestBilagor är REDAN den vitlist-baserade, "gissa aldrig"-motorn
// som kopDokument.ts:s köpta bilagechecklista använder (kopDokument.ts
// filhuvud) — samma härledning, bara körd tidigare i flödet, på den
// fria sidan, inte bara efter köp.
const bilagor = harvestBilagor(genereraRegistreringsUtkast(kommun));
// H3 (GRANSKNING_foreningsguiden.md): priset ska synas INNAN betalknappen,
// inte gömt bakom klicket — samma platshållarkonstant som checkout-routen
// (src/lib/priser.ts), aldrig hårdkodat på två ställen.
const prisKr = PRIS_REGISTRERINGSUTKAST_ORE / 100;
// H31 (SPEC: Kluster 3, 2026-07-28): delaFraga har nu en {kommun}-platshållare.
const delaFraga = KVITTOSIDA.delaFraga.replace(/{kommun}/g, kommun.kommun);

// KÖPRUTAN (Fable, 2026-07-31): {bidrag} blir "registrering" här — den
// här produkten är kommun-scopad, inte ett enskilt bidrag.
//
// 1e (SPEC_HUVUDPROCESSEN §1e, 2026-08-01): prisspecifikationen skriven
// ut i klartext (netto/moms/totalt) i stället för "249 kr inkl moms" —
// en kassör bokför nettot och momsen separat, hon ska inte behöva
// räkna. momsAndelOre() finns redan (priser.ts, H10) — samma tal som
// Stripe-fakturans egen momsspecifikation (checkout/registrering.ts),
// en källa.
const momsOre = momsAndelOre(PRIS_REGISTRERINGSUTKAST_ORE);
const nettoKr = ((PRIS_REGISTRERINGSUTKAST_ORE - momsOre) / 100).toFixed(2).replace('.', ',');
const momsKr = (momsOre / 100).toFixed(2).replace('.', ',');
// {antal} FRÅN MOCKEN UTELÄMNAT MEDVETET: mockens exempel ("Gislaveds
// fem krav") räknar 1d:s framtida bockningsbara punkter — som ännu
// inte finns (1d är blockerad, se B1/kommatecken-fyndet i förra
// sprinten). forutsattningar.length hade gett fel tal (räknar
// FÖRUTSÄTTNINGS-OBJEKT, inte individuella krav inom dem — 1 för
// Gislaved, inte 5). Bättre att inte påstå ett tal än att påstå fel
// tal — samma "gissa aldrig"-disciplin som resten av projektet.
const fyllKopytan = (text: string) => text.replace(/{kommun}/g, kommun.kommun);
---
<Base
  title={`${titel} — Föreningsguiden`}
  description={`Vad en förening behöver för att bli godkänd att söka bidrag i ${kommun.kommun} — steg för steg, med källa och handläggningstid där kommunen publicerat det.`}
>
  <BreadcrumbList items={[
    { name: 'Startsida', url: '/' },
    { name: kommun.kommun, url: `/kommun/${kommun.kommun_slug}/` },
    { name: 'Registrering', url: `/kommun/${kommun.kommun_slug}/registrera/` },
  ]} />

  <div class="registrera-doc">
    <p class="registrera-doc__eyebrow">{kommun.kommun} kommun · registreringschecklista</p>
    <h1>{titel}</h1>

    {forutsattningar.length === 0 ? (
      <p class="registrera-doc__lede">{VAGLEDNING.station3.inget.replace('{kommun}', kommun.kommun)}</p>
    ) : (
      <>
        <p class="registrera-doc__lede">{VAGLEDNING.station3.intro.replace('{kommun}', kommun.kommun)}</p>

        <ol class="registrera-doc__lista">
          {forutsattningar.map((f, i) => (
            <li class="registrera-doc__steg">
              <div class="registrera-doc__steg-nr">{i + 1}</div>
              <div class="registrera-doc__steg-body">
                <h2>{f.vad}</h2>
                <p>{f.beskrivning}</p>
                <p class="registrera-doc__ledtid">
                  {f.ledtid !== null
                    ? VAGLEDNING.station3.ledtidKand.replace('{ledtid}', String(f.ledtid))
                    : (f.ledtid_text ?? VAGLEDNING.station3.ledtidOkand.replace(/{kommun}/g, kommun.kommun))}
                </p>
                {f.giltighet && (
                  <p class="registrera-doc__giltighet">{VAGLEDNING.station3.giltighetVarning.replace('{giltighet}', f.giltighet)}</p>
                )}
                <p class="registrera-doc__kalla">
                  Källa: <a href={f.kalla_url}>{f.kalla_url}</a>
                </p>
              </div>
            </li>
          ))}
        </ol>

        {/* B2 (SPRINT: Produkten) — samma rubrik och radformat som den
           köpta sidans bilagechecklista (mina-sidor/kop/[session]/index.astro),
           bara flyttad till den fria sidan. Visas bara det som faktiskt
           nämns (harvestBilagor's egen princip) — ingen sektion om tomt. */}
        {bilagor.length > 0 && (
          <div class="registrera-doc__bilagor">
            <h2>Underlag som nämns i kraven</h2>
            <ul>
              {bilagor.map((b) => (
                <li>{b.etikett} <span class="registrera-doc__bilaga-kalla">— nämnt under "{b.kallaVad}"</span></li>
              ))}
            </ul>
          </div>
        )}
      </>
    )}

    {forutsattningar.length > 0 && (
      <div class="registrera-doc__hjalp">
        <p class="registrera-doc__hjalp-text">{TRATT.besked.borjaHar.hjalpText}</p>

        {/* 1e — köpytan (SPEC_HUVUDPROCESSEN §1e, 2026-08-01). Ersätter
           den tidigare KÖPRUTAN (Fable, 2026-07-31) med mockens fyra
           punkter + utskriven prisspecifikation + två betalknappar.
           ATERBETALNING (H13) står kvar oförändrad — samma "en garanti,
           inte två" som tidigare, den ersätter fortfarande KOPRUTA.aterbetalning. */}
        <p class="registrera-doc__eyebrow">{fyllKopytan(KOPYTAN_1E.eyebrow)}</p>
        <h2 class="registrera-doc__kopruta-rubrik">{KOPYTAN_1E.rubrik}</h2>
        <ul class="registrera-doc__vad-hon-far">
          {KOPYTAN_1E.vadHonFar.map((punkt) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
              <span>{fyllKopytan(punkt)}</span>
            </li>
          ))}
        </ul>

        {/* H3 (GRANSKNING_foreningsguiden.md): priset ska synas INNAN
           betalknappen. Nu utskrivet netto/moms/totalt (1e) i stället för
           "249 kr inkl moms" — en kassör bokför nettot och momsen
           separat, hon ska inte behöva räkna. */}
        <div class="registrera-doc__prisspec">
          <p><span>{KOPYTAN_1E.prisspecRad}</span><span>{nettoKr} kr</span></p>
          <p class="registrera-doc__prisspec-moms"><span>{KOPYTAN_1E.momsRad}</span><span>{momsKr} kr</span></p>
          <p class="registrera-doc__prisspec-total"><span>{KOPYTAN_1E.attBetalaRad}</span><span>{prisKr} kr</span></p>
          <p class="registrera-doc__prisspec-kvitto">{KOPYTAN_1E.kvittoRad}</p>
        </div>

        {/* H12 (SPEC: Det som återstår, 2026-07-28) + 1e: två betalknappar,
           Swish primärt/kort sekundärt — checkout/registrering.ts läser
           data-metod och låser Stripes hostade kassa till ETT betalsätt
           i stället för att alltid visa båda. Motpartsnamnet
           "Föreningsguiden" sätts i Stripe-kontots inställningar (Jacobs
           jobb, ingen kod) — swish-info-raden förutsätter att det är gjort. */}
        <button type="button" class="btn-primary registrera-doc__betala" data-registrera-betala data-metod="swish">{KOPYTAN_1E.swishKnapp}</button>
        <button type="button" class="fg-btn--ghost registrera-doc__betala" data-registrera-betala data-metod="kort">{KOPYTAN_1E.kortKnapp}</button>
        <p class="registrera-doc__swish-info">{KOPYTAN_1E.swishInfo}</p>

        {/* H13 (SPEC: Det som återstår, 2026-07-30): återbetalningsgarantin
           intill priset — starkast där betalbeslutet fattas (Jacobs
           instruktion), inte bara begravd på integritetspolicyn. Så länge
           "beta" står i loggan är den inte valfri (1e). */}
        <div class="registrera-doc__aterbetalning">
          <p class="registrera-doc__aterbetalning-rubrik">{ATERBETALNING.rubrik}</p>
          {ATERBETALNING.stycken.map((stycke) => <p>{stycke}</p>)}
        </div>
        {/* H8 (GRANSKNING_foreningsguiden.md): produkten levereras nu
           automatiskt (mejl direkt vid betalning) — inte "vi hör av oss"
           som den gamla, manuella Registreringshjälpen. Minimal, funktionell
           statusrad (samma precedent som avregistrera/kontakt-sidornas
           instruktionstext), flaggad till Fable för ev. justering. */}
        <div data-registrera-kvitto hidden>
          <p>Betalningen gick igenom — ni får ert registreringsutkast direkt till angiven e-postadress.</p>

          {/* H20 (SPEC: Kluster 1 — efter-köp-ytan, 2026-07-28): "Medan ni
             är här". Allt beräknas klientsidan (sidan är statiskt byggd,
             föreningsprofilen bor bara i localStorage) — se skriptet
             nedan. Varje rad döljs tills underlaget faktiskt finns. */}
          <div class="kvitto-vidare" data-kvitto-vidare data-kommun-slug={kommun.kommun_slug} data-kommun-namn={kommun.kommun}>
            <h3>{KVITTOSIDA.rubrik}</h3>

            <p class="kvitto-vidare__rad" data-kvitto-matchade hidden>
              <span data-kvitto-matchade-text></span>{' '}
              <a href={`/kommun/${kommun.kommun_slug}/`}>{KVITTOSIDA.matchadeBidragLank}</a>
            </p>

            <div class="kvitto-vidare__rad" data-kvitto-deadline hidden>
              <p><span data-kvitto-deadline-text></span></p>
              <div class="kvitto-vidare__bevaka deadline-table__bevaka" data-bevaka-cell data-kommun-slug={kommun.kommun_slug} data-kommun-namn={kommun.kommun}>
                <button type="button" class="fg-btn--ghost bevaka-rad-knapp">{BEVAKNING.knapp}</button>
              </div>
            </div>

            <p class="kvitto-vidare__rad">
              {delaFraga}{' '}
              <button type="button" class="fg-btn--ghost" data-kvitto-dela>{KVITTOSIDA.delaLank}</button>
              <span class="kvitto-vidare__dela-kvitto" data-kvitto-dela-kvitto hidden>Länk kopierad.</span>
            </p>
          </div>
        </div>
        <p data-registrera-fel hidden>Något gick fel. Försök igen.</p>
      </div>
    )}

    <p class="registrera-doc__ansvar">{VAGLEDNING.station5.ansvar}</p>
  </div>
</Base>

<script>
  import { getForeningsprofil } from '../../../../lib/foreningsprofil';
  import { matchKommun } from '../../../../lib/matching';
  import { formatDate, earliestDeadlineISO, todayISO, type Kommun } from '../../../../lib/kommunTyper';
  import { KVITTOSIDA } from '../../../../lib/content';
  import { initBevakaWidgets } from '../../../../lib/bevakaKlient';

  // 1e — två knappar (Swish/kort) delar samma klickflöde, se nedan.
  const knappar = document.querySelectorAll<HTMLButtonElement>('[data-registrera-betala]');
  const kvitto = document.querySelector<HTMLElement>('[data-registrera-kvitto]');
  const felText = document.querySelector<HTMLElement>('[data-registrera-fel]');
  const kommunSlug = window.location.pathname.split('/').filter(Boolean)[1] ?? '';

  initBevakaWidgets();

  // H20 (SPEC: Kluster 1 — efter-köp-ytan, 2026-07-28): "Medan ni är
  // här". Sidan är statiskt byggd (getStaticPaths) och föreningsprofilen
  // bor bara i localStorage — allt underlag måste alltså hämtas/räknas
  // här, klientsidan, precis som matcha/index.astro redan gör mot samma
  // /kommun-data/{slug}.json-endpoint. Varje rad förblir dold om
  // underlaget saknas (ingen profil, inga fasta deadlines) — se spec:en.
  async function visaMedanNiArHar(): Promise<void> {
    const vidare = document.querySelector<HTMLElement>('[data-kvitto-vidare]');
    if (!vidare || !kommunSlug) return;

    let kommunData: Kommun;
    try {
      const res = await fetch(`/kommun-data/${kommunSlug}.json`);
      if (!res.ok) throw new Error('kommun-data 404');
      kommunData = await res.json();
    } catch {
      return;
    }

    const profil = getForeningsprofil();
    if (profil) {
      const antal = matchKommun(profil, kommunData).matchar.length;
      if (antal > 0) {
        const rad = vidare.querySelector<HTMLElement>('[data-kvitto-matchade]');
        const text = rad?.querySelector<HTMLElement>('[data-kvitto-matchade-text]');
        if (text) {
          text.textContent = KVITTOSIDA.matchadeBidragRad
            .replace('{antal}', String(antal))
            .replace(/{kommun}/g, kommunData.kommun);
        }
        rad?.removeAttribute('hidden');
      }
    }

    const today = todayISO();
    const kommandeDeadlines = kommunData.bidrag
      .filter((b) => b.status === 'aktiv')
      .map((b) => earliestDeadlineISO(b, today))
      .filter((d): d is string => d !== null)
      .sort();
    if (kommandeDeadlines.length > 0) {
      const rad = vidare.querySelector<HTMLElement>('[data-kvitto-deadline]');
      const text = rad?.querySelector<HTMLElement>('[data-kvitto-deadline-text]');
      if (text) {
        text.textContent = KVITTOSIDA.nastaDeadlineRad
          .replace(/{kommun}/g, kommunData.kommun)
          .replace('{datum}', formatDate(kommandeDeadlines[0]));
      }
      rad?.removeAttribute('hidden');
    }
  }

  // "Dela" — alltid tillgänglig (spec:en), ingen villkorad data. Web
  // Share API där webbläsaren stödjer den (mobil), annars kopiera-länk.
  document.querySelector<HTMLButtonElement>('[data-kvitto-dela]')?.addEventListener('click', async () => {
    const url = `${window.location.origin}/kommun/${kommunSlug}/`;
    const kommunNamn = document.querySelector<HTMLElement>('[data-kvitto-vidare]')?.dataset.kommunNamn ?? '';

    if (navigator.share) {
      try {
        await navigator.share({ title: `Föreningsbidrag i ${kommunNamn}`, url });
        return;
      } catch {
        // Avbrutet av användaren eller stött av webbläsaren — faller
        // igenom till kopiera-länk nedan.
      }
    }
    try {
      await navigator.clipboard.writeText(url);
      document.querySelector<HTMLElement>('[data-kvitto-dela-kvitto]')?.removeAttribute('hidden');
    } catch {
      // Clipboard-API otillgängligt — inget att göra åt utan HTTPS.
    }
  });

  // Stripe Checkout skickar tillbaka hit via success_url — se
  // src/pages/api/checkout/registrering.ts. Ingen egen kvittosida:
  // samma data-registrera-kvitto-element som redan fanns för den gamla
  // e-postfångsten återanvänds för betalkvittot.
  if (new URLSearchParams(window.location.search).get('betald') === '1') {
    knappar.forEach((k) => k.setAttribute('hidden', ''));
    kvitto?.removeAttribute('hidden');
    visaMedanNiArHar();
  }

  knappar.forEach((knapp) => {
    knapp.addEventListener('click', async () => {
      felText?.setAttribute('hidden', '');
      knappar.forEach((k) => (k.disabled = true));

      const data = new FormData();
      data.set('kommun', kommunSlug);
      data.set('metod', knapp.dataset.metod ?? 'swish');

      const profil = getForeningsprofil();
      if (profil) data.set('profil', JSON.stringify(profil));

      try {
        const res = await fetch('/api/checkout/registrering', { method: 'POST', body: data });
        const json = await res.json();
        if (!res.ok || !json.ok || !json.url) throw new Error('svar ej ok');
        window.location.href = json.url;
      } catch {
        felText?.removeAttribute('hidden');
        knappar.forEach((k) => (k.disabled = false));
      }
    });
  });
</script>

<style>
  .registrera-doc {
    max-width: 68ch;
  }

  .registrera-doc__eyebrow {
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-mono);
    font-weight: var(--fg-weight-bold);
    letter-spacing: var(--fg-tracking-label);
    text-transform: uppercase;
    color: var(--fg-ink-muted);
  }

  .registrera-doc__lede {
    font-size: var(--fg-text-body-lg);
    line-height: var(--fg-lh-body);
    color: var(--fg-ink);
  }

  .registrera-doc__lista {
    list-style: none;
    padding: 0;
    margin: var(--fg-space-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--fg-space-6);
  }

  .registrera-doc__steg {
    display: flex;
    gap: 14px;
    border: var(--fg-border-structural) solid var(--fg-border);
    border-radius: var(--fg-radius-card);
    padding: var(--fg-space-5);
  }

  .registrera-doc__steg-nr {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--fg-accent);
    color: var(--fg-on-accent);
    font-family: var(--fg-font-display);
    font-weight: var(--fg-weight-bold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .registrera-doc__steg-body h2 {
    font-size: var(--fg-text-h2);
    margin: 0 0 6px;
  }

  .registrera-doc__ledtid {
    font-size: var(--fg-text-label);
    color: var(--fg-ink-muted);
  }

  .registrera-doc__giltighet {
    background: var(--fg-attention-soft, var(--fg-surface-sunken));
    border-left: 3px solid var(--fg-attention);
    padding: 8px 12px;
    font-size: var(--fg-text-label);
  }

  .registrera-doc__kalla {
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-mono);
    color: var(--fg-ink-muted);
    margin-top: 8px;
  }

  .registrera-doc__bilagor {
    margin-top: var(--fg-space-7);
    padding-top: var(--fg-space-6);
    border-top: var(--fg-border-inner) dashed var(--fg-border);
  }

  .registrera-doc__bilagor h2 {
    font-size: var(--fg-text-h2);
    margin: 0 0 var(--fg-space-3);
  }

  .registrera-doc__bilaga-kalla {
    color: var(--fg-ink-muted);
    font-size: var(--fg-text-label);
  }

  .registrera-doc__hjalp {
    background: var(--fg-surface-sunken);
    border-radius: var(--fg-radius-card);
    padding: var(--fg-space-6);
    margin-top: var(--fg-space-7);
  }

  .registrera-doc__eyebrow {
    font-family: var(--fg-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--fg-tracking-label);
    color: var(--fg-ink-muted);
    margin: 0 0 var(--fg-space-2);
  }

  .registrera-doc__kopruta-rubrik {
    font-size: var(--fg-text-h2);
    margin: 0 0 var(--fg-space-3);
  }

  /* 1e — "Vad hon får", fyra punkter med grön bock i --fg-accent-soft-cirkel. */
  .registrera-doc__vad-hon-far {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--fg-space-6);
    display: grid;
    gap: var(--fg-space-3);
  }

  .registrera-doc__vad-hon-far li {
    display: flex;
    align-items: flex-start;
    gap: var(--fg-space-3);
  }

  .registrera-doc__vad-hon-far svg {
    flex-shrink: 0;
    margin-top: 3px;
    padding: 3px;
    border-radius: 50%;
    background: var(--fg-accent-soft);
    color: var(--fg-accent);
    box-sizing: content-box;
  }

  /* 1e — prisspecifikationen: netto/moms utskrivet, totalt framhävt. */
  .registrera-doc__prisspec {
    border-top: var(--fg-border-inner) solid var(--fg-border);
    padding-top: var(--fg-space-4);
    margin-bottom: var(--fg-space-5);
  }

  .registrera-doc__prisspec p {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--fg-space-4);
    font-family: var(--fg-font-sans);
    margin: 0 0 var(--fg-space-2);
  }

  .registrera-doc__prisspec p span:last-child {
    font-family: var(--fg-font-mono);
    white-space: nowrap;
