---
// D1 (ARBETSORDER 2026-08-11) — varje bidrag får en egen URL,
// /kommun/[slug]/bidrag/[bidrag-slug]/, i stället för att bara existera som
// ett fällt <details>-kort på kommunsidan. Innehållet ÄR BidragDjup.astro,
// samma komponent BidragCard.astro (kommunsidans kollapsade rad) redan
// använder — "en sanning, ett ställe", ingen andra kopia av dl/krav-
// listan/käll-footern.
//
// D7: ingen filtrering på bidrag.status — pausade/avskaffade bidrag har
// fortfarande en URL (BidragDjup renderar redan status-notisen i stället
// för CTA:n för dem). "Ingenting raderas ur databasen, allt bor kvar på
// någon URL" gäller lika mycket ett pausat bidrag som ett aktivt.
import Base from '../../../../../layouts/Base.astro';
import BreadcrumbList from '../../../../../components/BreadcrumbList.astro';
import BidragDjup from '../../../../../components/BidragDjup.astro';
import BidragInmatning from '../../../../../components/BidragInmatning.astro';
import UrgencyChip from '../../../../../components/UrgencyChip.astro';
import { arAktivitetsbidrag } from '../../../../../lib/aktivitetsbidragHeuristik';
import {
  loadKommuner, bidragAnsokningsUrl, bidragAnsokningssystemNamn, hittaGiltighetsstatus,
  earliestDeadlineISO, daysUntil, getUrgency, todayISO, relativFrist, formatDate,
  individuelltBelopp, bidragHarNamngivetSystem, possessiv, beloppArEttEnkeltTal, beraknaArbetsbevis,
} from '../../../../../lib/kommuner';
import type { Kommun, Bidrag } from '../../../../../lib/kommuner';
import { KOMMUN, KOPRUTA, KONVERTERINGSSTAPEL, FORSTASIDAN_SVARAR } from '../../../../../lib/content';
import { PRIS_BIDRAGSUTKAST_ORE } from '../../../../../lib/priser';
import { genereraUtkast } from '../../../../../lib/utkastGenerator';
import { harvestBilagorFranKrav } from '../../../../../lib/kopDokument';
import { arBidragSaljbart } from '../../../../../lib/kommunKlar';
import { konservativProfil } from '../../../../../lib/foreningsprofil';

export function getStaticPaths() {
  const paths: { params: { slug: string; bidragId: string }; props: { kommun: Kommun; bidrag: Bidrag } }[] = [];
  for (const kommun of loadKommuner()) {
    for (const bidrag of kommun.bidrag) {
      paths.push({ params: { slug: kommun.kommun_slug, bidragId: bidrag.id }, props: { kommun, bidrag } });
    }
  }
  return paths;
}

const { kommun, bidrag } = Astro.props as { kommun: Kommun; bidrag: Bidrag };

const today = todayISO();
const dateISO = earliestDeadlineISO(bidrag, today);
const radDatumText = dateISO
  ? formatDate(dateISO)
  : bidrag.deadlines.typ === 'relativ' ? (relativFrist(bidrag) ?? 'löpande ansökan')
  : bidrag.deadlines.typ === 'okand' ? 'inget publicerat datum' : 'löpande ansökan';
const beloppPerForening = individuelltBelopp(bidrag);

// Samma kommun-nivå-beräkning som KommunSidaFull.astro gör en gång för
// alla bidragskort på sidan — här bara för DETTA bidrags egen sida.
const giltighetStatus = hittaGiltighetsstatus(kommun.forutsattningar);

const metaTitle = `${bidrag.namn} — ${kommun.kommun} — Föreningsguiden`;
const metaDescription = `${bidrag.namn} i ${kommun.kommun}: krav, belopp och ansökningsdatum, verifierat mot kommunens egen sida.`;

// D3 (ARBETSORDER 2026-08-11): "Så ansöker du"-prosan flyttad hit från
// kommunsidan (D2 tog bort den där som en dubblett av varje bidrags egen
// "Till ansökan"-knapp). Samma text, oförändrad — KOMMUN.ansoknings-
// systemRubrik/-Template fanns redan, ingen ny prosa skriven för flytten.
//
// AA1.4 (Jacobs order): bidrag.ansokningsvag vinner över kommunens
// generella systemtext när satt (t.ex. Falun: RF-anslutna redovisar via
// RF, övriga via ActorSmartbook — en enda kommunövergripande mening kan
// inte bära den skillnaden). Ersätter hela stycket, inte bara {system} —
// en fritextöverskrivning som beskriver flera vägar passar inte in i
// "{kommun} tar emot ansökningar via {system}."-mallens grammatik.
const ansokningstext = bidrag.ansokningsvag
  ?? KOMMUN.ansokningssystemTemplate
    .replace(/{kommun}/g, kommun.kommun)
    .replace(/{system}/g, bidragAnsokningssystemNamn(bidrag, kommun));

// P2.2 (KOMMUNSIDAN_EN_LASARE_2026-08-21.md): köprutan flyttad hit från
// kommunsidans station 5 (KommunProgression.astro) — samma beräkningar,
// nu scopade till DETTA enda bidrag i stället för "första säljbara
// kandidaten i kommunen" (ingen .find() behövs, bidraget är redan valt).
// Ordalydelsen (KOPRUTA-texterna) OFÖRÄNDRAD, Jacobs dom (§5 i ordern).
const visaKopruta = arBidragSaljbart(bidrag);
const prisKr = PRIS_BIDRAGSUTKAST_ORE / 100;
const kopRutaPrisOchKvitto = KOPRUTA.prisOchKvitto.replace('{pris}', String(prisKr));
// AC3 (Jacobs order): {system} ska fyllas med bidragets EGEN
// ansökningsväg när satt, samma "en sanning" som ansokningstext ovan
// redan använder för prosan — bidragAnsokningssystemNamn() är den
// funktionen. Vilken KOPRUTA-mall som väljs (nedan) avgörs separat,
// se bidragHarNamngivetSystem i kommunTyper.ts för varför.
const fyllKopruta = (text: string) =>
  text.replace('{kommun}', kommun.kommun).replace('{kommunPossessiv}', possessiv(kommun.kommun)).replace('{bidrag}', bidrag.namn).replace('{pris}', String(prisKr)).replace('{system}', bidragAnsokningssystemNamn(bidrag, kommun));
const kopRutaBeskrivning = visaKopruta
  ? fyllKopruta(bidragHarNamngivetSystem(bidrag, kommun) ? KOPRUTA.beskrivningEtjanst : KOPRUTA.beskrivning)
  : '';
const kopRutaInnehallsrad = (() => {
  if (!visaKopruta) return '';
  const resultat = genereraUtkast(konservativProfil(kommun.kommun_slug), bidrag, kommun);
  const antalBilagor = resultat.typ === 'bidragsutkast' ? harvestBilagorFranKrav(resultat.kravRader).length : 0;
  const bilagorText = antalBilagor === 1 ? '1 bilaga' : `${antalBilagor} bilagor`;
  return KOPRUTA.innehallsrad.replace('{antalKrav}', String(bidrag.krav.length)).replace('{bilagorText}', bilagorText);
})();
const kopRutaVardeankring = visaKopruta && bidrag.belopp_status === 'kontrollast' && beloppArEttEnkeltTal(bidrag) !== null
  ? fyllKopruta(KONVERTERINGSSTAPEL.vardeankring).replace('{belopp}', individuelltBelopp(bidrag) ?? '')
  : null;
const kopRutaHref = `/kommun/${kommun.kommun_slug}/utkast/${bidrag.id}/`;
// F8: F①:s fallback — samma sajtsomfattande arbetsbevis-tal som
// utkastvyn/förstasidan (EN räkning), inte bidrags- eller kommunspecifikt.
const socialtBevisFallback = visaKopruta
  ? FORSTASIDAN_SVARAR.bevisMall
      .replace('{bidrag}', beraknaArbetsbevis(loadKommuner()).totalBidrag.toLocaleString('sv-SE'))
      .replace('{kontrollasta}', beraknaArbetsbevis(loadKommuner()).kontrollastAntal.toLocaleString('sv-SE'))
  : '';

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${bidrag.namn} — ${kommun.kommun}`,
  dateModified: bidrag.senast_verifierad ?? kommun.verifierad,
};
---
<Base title={metaTitle} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
  <BreadcrumbList items={[
    { name: 'Startsida', url: '/' },
    { name: kommun.kommun, url: `/kommun/${kommun.kommun_slug}/` },
    { name: bidrag.namn, url: `/kommun/${kommun.kommun_slug}/bidrag/${bidrag.id}/` },
  ]} />

  <p class="bidrag-sida__eyebrow">{kommun.kommun} kommun</p>
  <h1>{bidrag.namn}</h1>
  <div class="bidrag-sida__meta">
    {dateISO && <UrgencyChip urgency={getUrgency(daysUntil(dateISO, today))} />}
    <span class="bidrag-sida__belopp">{beloppPerForening ?? 'individuellt belopp inte fastställt'}</span>
    <span class="bidrag-sida__datum">{radDatumText}</span>
  </div>

  <div class="bidrag-card fg-card bidrag-sida__kort">
    <div class="bidrag-card__djup">
      <BidragDjup
        bidrag={bidrag}
        verifierad={kommun.verifierad}
        ansokningsUrl={bidragAnsokningsUrl(bidrag, kommun)}
        kommunSlug={kommun.kommun_slug}
        kommunNamn={kommun.kommun}
        giltighetStatus={giltighetStatus}
      >
        {visaKopruta && (
          <Fragment slot="efter-krav">
            <div class="progression__kopruta" data-progression-kopruta data-kommun-slug={kommun.kommun_slug} data-kommun-namn={kommun.kommun}>
              <h4 class="progression__kopruta-rubrik">{KOPRUTA.rubrik}</h4>
              <p>{kopRutaBeskrivning}</p>
              <p>{kopRutaInnehallsrad}</p>
              <p>{KOPRUTA.leverans}</p>
              <p>{kopRutaPrisOchKvitto}</p>
              {kopRutaVardeankring && (
                <p class="progression__kopruta-vardeankring">{kopRutaVardeankring}</p>
              )}
              <p class="progression__kopruta-aterbetalning">{KOPRUTA.aterbetalning}</p>
              <p class="progression__kopruta-socialt-bevis" data-progression-kopruta-socialt-bevis>{socialtBevisFallback}</p>
              <a href={kopRutaHref} class="fg-btn--ghost progression__goal-cta" data-progression-kopruta-cta>
                Lås upp hela checklistan — {prisKr} kr
              </a>
            </div>
          </Fragment>
        )}
        {/* AH1.3 (Jacobs order): profilen som progressiv inmatning — bara
           för aktivitetsbidrag, AF1:s hela profillager är scopat dit. */}
        {arAktivitetsbidrag(bidrag.namn, bidrag.id) && (
          <Fragment slot="efter-krav">
            <BidragInmatning bidrag={bidrag} kommun={kommun} />
          </Fragment>
        )}
      </BidragDjup>
    </div>
  </div>

  {bidrag.status === 'aktiv' && (
    <section>
      <h2>{KOMMUN.ansokningssystemRubrik}</h2>
      <p>
        {ansokningstext}
        {/* AA1.4: kommunens generella länk visas bara när ingen bidrags-
           specifik ansökningsväg skrivit över texten ovan — en fritext-
           överskrivning kan beskriva flera vägar/system, och den enda
           kommun-länken vore då fel eller ofullständig. */}
        {!bidrag.ansokningsvag && (
          <>{' '}<a href={kommun.ansokningssystem.url}>{kommun.ansokningssystem.url}</a></>
        )}
      </p>
    </section>
  )}
</Base>

<script>
  // BidragDjup renderar felrapport-widgeten (H25) — samma wiring som
  // KommunSidaFull.astro/[kategori]/index.astro redan gör, annars är
  // "Det här stämmer inte"-knappen här bara död markup utan klickhandler.
  import { initFelrapportWidgets } from '../../../../../lib/felrapportKlient';
  initFelrapportWidgets();

  // P2.2: samma progressiva uppgradering av det sociala beviset som
  // köprutan hade på kommunsidan (KommunProgression.astro) — server-
  // sann fallback (F①, sajtsomfattande arbetsbevis-tal) genast,
  // uppgraderad till KOMMUNENS eget köpantal om det når golvet.
  import { hamtaKopantal, arOverSocialtBevisGolv } from '../../../../../lib/kopKlient';
  import { KONVERTERINGSSTAPEL } from '../../../../../lib/content';
  const kopruta = document.querySelector<HTMLElement>('[data-progression-kopruta]');
  const socialtBevisEl = kopruta?.querySelector<HTMLElement>('[data-progression-kopruta-socialt-bevis]');
  if (kopruta && socialtBevisEl) {
    const kommunSlug = kopruta.dataset.kommunSlug ?? '';
    const kommunNamn = kopruta.dataset.kommunNamn ?? kommunSlug;
    hamtaKopantal(kommunSlug).then((antal) => {
      if (antal === null || !arOverSocialtBevisGolv(antal)) return;
      socialtBevisEl.textContent = KONVERTERINGSSTAPEL.socialtBevis.replace('{antal}', String(antal)).replace('{kommun}', kommunNamn);
    });
  }
</script>

<style>
  .bidrag-sida__eyebrow {
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-label);
    font-weight: var(--fg-weight-bold);
    letter-spacing: var(--fg-tracking-label);
    text-transform: uppercase;
    color: var(--fg-ink-muted);
    margin: 0;
  }

  .bidrag-sida__meta {
    display: flex;
    align-items: center;
    gap: var(--fg-space-3);
    font-size: var(--fg-text-body-lg);
    margin: var(--fg-space-2) 0 var(--fg-space-6);
  }

  .bidrag-sida__belopp {
    font-weight: var(--fg-weight-bold);
  }

  .bidrag-sida__datum {
    color: var(--fg-ink-muted);
  }

  .bidrag-sida__kort {
    padding: 0;
    overflow: hidden;
  }
</style>
