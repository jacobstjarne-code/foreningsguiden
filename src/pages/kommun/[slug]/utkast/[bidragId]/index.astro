---
// Utkastvyn med väggen — CODE_UPPDRAG_KOMMERSIELL.md §1.B ("produktens
// viktigaste skärm"), mock: incoming/Föreningsguiden kommersiell.html
// turn-1 (1a). Se plan twinkling-wondering-emerson.md del 3 för hela
// resonemanget.
//
// ⚠️ GOLDEN SET GRÖNT (2026-07-30) — UTKASTVY_LIVE PÅSLAGEN ⚠️
// 45/45 (bidrag×profil) godkända, node scripts/verify-generator.ts,
// se golden-set/README.md. Jacobs instruktion: "Blir grinden grön slås
// UTKASTVY_LIVE på och bidragsutkastet blir säljbart."
//
// VAD SOM FORTFARANDE SAKNAS INNAN DET FAKTISKT ÄR SÄLJBART: den här
// skärmen är fortfarande BARA dokumentet + väggen + köpramen mot EN
// hårdkodad demo-fixtur (Gislaved/arrangemangsbidrag) — inte det
// ungated-formuläret som genererar sidan dynamiskt för ETT VALFRITT
// bidrag (CODE_UPPDRAG_KOMMERSIELL §1.B.2, "egen större uppgift",
// aldrig byggd). Köpknappen längre ner är fortfarande hårdkodad
// `disabled` — ingen Stripe-integration finns för DENNA produkt (skilt
// från registreringsutkastets /kommun/[slug]/registrera/, som redan är
// en riktig köpväg). "Säljbart" i Jacobs mening kräver den dynamiska
// routen + betalflödet + Fables paywall-copy (§4, fortfarande
// {{FABLE:}}-slots nedan) — INTE byggt i denna commit. Rapporterat,
// inte tystat.
//
// UTKASTVY_LIVE ligger MEDVETET inne i getStaticPaths()-kroppen, inte på
// modulnivå — samma Astro-bundling-gotcha som EXEMPELSIDOR_LIVE (se
// src/pages/exempel/[kommun]/[kategori]/index.astro): Astro bundlar
// getStaticPaths till en egen chunk vid prerendering och missar en
// modulnivå-const utanför funktionen.
//
// Avvikelse från mocken, flaggad för Jacob/Design (ingen levande
// Design-kanal i den här sessionen): mocken visar löpande PROSA
// ("Reftele IF ansöker härmed..."). Den riktiga generatorn
// (genereraUtkast(), src/lib/utkastGenerator.ts) producerar en
// STRUKTURERAD krav-checklista, inte prosa — och ska enligt sin egen
// filkommentar aldrig producera fri prosa. Väggens blur/gradient-mekanik
// appliceras därför på krav-listan i stället för på prosastycken, så
// skärmen visar generatorns RIKTIGA arbete, inte fabricerad text bakom
// en vägg som ser ut som något den inte är (KVALITETSSPEC §4/§6).
//
// Demo-data: samma golden-set/gislaved-arrangemangsbidrag.EXEMPEL.yaml-
// fixtur som redan finns (profil kultur/s/etablerad/ja — vald i den
// filen specifikt för att undvika registrering_forst-grenen). Ingen ny
// fejk-förening uppfinns för den här ytan.
//
// Denna yta bygger BARA dokumentet + väggen + köpramen (CODE_UPPDRAG_
// KOMMERSIELL §1.B, "väggen sitter inne i dokumentet"), INTE det
// föregående ungated-formuläret (§1.B.2, egen större uppgift).
import Base from '../../../../../layouts/Base.astro';
import BreadcrumbList from '../../../../../components/BreadcrumbList.astro';
import { getKommunBySlug } from '../../../../../lib/kommuner';
import type { Kommun, Bidrag } from '../../../../../lib/kommuner';
import { genereraUtkast } from '../../../../../lib/utkastGenerator';
import type { Foreningsprofil } from '../../../../../lib/foreningsprofil';

export function getStaticPaths() {
  const UTKASTVY_LIVE = true;
  if (!UTKASTVY_LIVE) return [];

  const kommun = getKommunBySlug('gislaved');
  const bidrag = kommun?.bidrag.find((b) => b.id === 'gislaved-arrangemangsbidrag');
  if (!kommun || !bidrag) return [];

  return [{ params: { slug: kommun.kommun_slug, bidragId: bidrag.id }, props: { kommun, bidrag } }];
}

const { kommun, bidrag } = Astro.props as { kommun: Kommun; bidrag: Bidrag };

// Samma profil som golden-set-fixturen — se filhuvudet.
const demoProfil: Foreningsprofil = {
  kommunSlug: kommun.kommun_slug,
  verksamhet: ['kultur'],
  storlek: 's',
  alder: 'etablerad',
  sokt: 'ja',
  uppdaterad: '',
};

const resultat = genereraUtkast(demoProfil, bidrag, kommun);
const doc = resultat.typ === 'bidragsutkast' ? resultat : null;
const [forstaKrav, ...ovrigaKrav] = doc?.kravRader ?? [];
---
<Base
  title={`Utkast — ${bidrag.namn} (${kommun.kommun}) — Föreningsguiden`}
  description="Förhandsvisning av bidragsutkastet — betalning inte öppnad än."
>
  <BreadcrumbList items={[
    { name: 'Startsida', url: '/' },
    { name: kommun.kommun, url: `/kommun/${kommun.kommun_slug}/` },
    { name: 'Utkast', url: `/kommun/${kommun.kommun_slug}/utkast/${bidrag.id}/` },
  ]} />

  <div class="utkastvy-stubbanner" role="note">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4" /><path d="M12 17h.01" /><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /></svg>
    <span><strong>Förhandsvisning — betalning inte öppnad.</strong> Generatorn är golden set-godkänd (45/45, KVALITETSSPEC.md §7), men den här sidan visar bara en fast exempelfixtur (Gislaved) och köpknappen nedan är fortfarande avstängd i väntan på det dynamiska formuläret och betalflödet.</span>
  </div>

  {doc && (
    <div class="utkastvy fg-card">
      <div class="utkastvy__header">
        <p class="utkastvy__eyebrow">{kommun.kommun} kommun · {doc.bidragNamn}</p>
        <h1>Utkast till ansökan</h1>
        <p class="utkastvy__meta">{doc.belopp ?? 'Belopp ej publikt'} · sista ansökningsdag {doc.deadlineText}</p>
      </div>

      <div class="utkastvy__dokument">
        {forstaKrav && (
          <div class="utkastvy__krav">
            <p class="utkastvy__krav-text">{forstaKrav.kravText}</p>
            <p class="utkastvy__krav-svar" data-status={forstaKrav.status}>{forstaKrav.innehall}</p>
          </div>
        )}

        {ovrigaKrav.length > 0 && (
          <div class="utkastvy__vagg">
            <div class="utkastvy__vagg-innehall">
              {ovrigaKrav.map((rad) => (
                <div class="utkastvy__krav">
                  <p class="utkastvy__krav-text">{rad.kravText}</p>
                  <p class="utkastvy__krav-svar" data-status={rad.status}>{rad.innehall}</p>
                </div>
              ))}
            </div>
            <div class="utkastvy__vagg-gradient"></div>
          </div>
        )}
      </div>

      <div class="utkastvy__kopram">
        <p class="placeholder-slot">{'{{FABLE: köprutans rubrik — utfall, inte funktion}}'}</p>
        <p class="utkastvy__pris">149 kr</p>
        <p class="placeholder-slot">{'{{FABLE: abonnemangsjämförelse — ingår i abonnemang, 495 kr/år}}'}</p>
        <button type="button" class="btn-primary" disabled title="Betalning aktiveras inte förrän golden set är godkänt (KVALITETSSPEC §7)">
          Lås upp hela utkastet — 149 kr
        </button>
        <p class="utkastvy__ansvar">{doc.ansvarsrad}</p>
        <a href={`/kommun/${kommun.kommun_slug}/#bidrag-${bidrag.id}`} class="utkastvy__escape">← Tillbaka till bidraget (gratis)</a>
      </div>
    </div>
  )}
</Base>

<style>
  .utkastvy-stubbanner {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: var(--fg-space-4) var(--fg-space-6);
    background: var(--fg-attention);
    color: var(--fg-on-accent);
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-label);
    font-weight: var(--fg-weight-bold);
    border-radius: var(--fg-radius-control);
    margin-bottom: var(--fg-space-6);
  }

  .utkastvy-stubbanner svg {
    flex: none;
  }

  .utkastvy-stubbanner code {
    background: rgba(255, 255, 255, 0.22);
    border-radius: 4px;
    padding: 1px 5px;
    font-family: var(--fg-font-mono);
  }

  .utkastvy {
    padding: 0;
    overflow: hidden;
  }

  .utkastvy__header {
    padding: var(--fg-space-6) var(--fg-space-7) var(--fg-space-3);
  }

  .utkastvy__eyebrow {
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-label);
    font-weight: var(--fg-weight-bold);
    letter-spacing: var(--fg-tracking-label);
    text-transform: uppercase;
    color: var(--fg-ink-muted);
    margin: 0;
  }

  .utkastvy__header h1 {
    margin: 6px 0 2px;
  }

  .utkastvy__meta {
    font-size: var(--fg-text-body);
    color: var(--fg-ink-muted);
    margin: 0;
  }

  .utkastvy__dokument {
    padding: 0 var(--fg-space-7) var(--fg-space-3);
  }

  .utkastvy__krav {
    padding: var(--fg-space-4) 0;
    border-bottom: 1px solid var(--fg-border);
  }

  .utkastvy__krav-text {
    font-weight: var(--fg-weight-bold);
    margin: 0 0 4px;
  }

  .utkastvy__krav-svar {
    margin: 0;
    color: var(--fg-ink-muted);
  }

  .utkastvy__krav-svar[data-status="lucka"] {
    font-style: italic;
  }

  /* Earned-curiosity-väggen (turn-1, 1a) — tre lager, extraherade ur
     mocken, inte gissade: blur+opacity på texten, ett fönster med fast
     höjd som klipper den, en separat gradient-overlay ovanpå. color-mix
     i stället för mockens rgba(255,255,255,...)/#fff — samma optik, men
     mot --fg-surface-token i stället för ett hårdkodat vitt. */
  .utkastvy__vagg {
    position: relative;
    height: 132px;
    overflow: hidden;
  }

  .utkastvy__vagg-innehall {
    filter: blur(3px);
    opacity: 0.5;
    user-select: none;
    pointer-events: none;
  }

  .utkastvy__vagg-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--fg-surface) 0%, transparent) 0%,
      color-mix(in srgb, var(--fg-surface) 85%, transparent) 78%,
      var(--fg-surface) 100%
    );
  }

  .utkastvy__kopram {
    background: var(--fg-surface-sunken);
    border-top: 2px solid var(--fg-border);
    padding: var(--fg-space-6) var(--fg-space-7);
    display: flex;
    flex-direction: column;
    gap: var(--fg-space-3);
  }

  .utkastvy__pris {
    font-family: var(--fg-font-display);
    font-weight: var(--fg-weight-display);
    font-size: var(--fg-text-h1);
    color: var(--fg-ink);
    margin: 0;
  }

  .utkastvy__ansvar {
    font-size: var(--fg-text-label);
    color: var(--fg-ink-muted);
    margin: var(--fg-space-3) 0 0;
  }

  .utkastvy__escape {
    align-self: center;
    font-size: var(--fg-text-label);
  }
</style>
