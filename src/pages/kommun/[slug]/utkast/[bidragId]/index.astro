---
// Utkastvyn med väggen — CODE_UPPDRAG_KOMMERSIELL.md §1.B ("produktens
// viktigaste skärm"), mock: incoming/Föreningsguiden kommersiell.html
// turn-1 (1a).
//
// DYNAMISK sedan 2026-07-30 (Jacobs order, efter golden set grönt):
// genereras nu för ALLA aktiva bidrag i ALLA kommuner, inte bara
// Gislaved-fixturen. Föreningsprofilen finns bara i localStorage (samma
// skäl som matcha/index.astro och VantelistaFlode.astro) — sidan kan
// alltså INTE serverrendera det personliga innehållet. Det den KAN
// serverrendera (kommun/bidragsnamn, pris, krav-TEXTERNA, första/övriga-
// uppdelningen — den är positionell, inte statusberoende, se
// utkastGenerator.ts) görs här; statusen (ifyllt/lucka) och den faktiska
// innehall-texten fylls av klientskriptet nedan, exakt samma
// fetch(/kommun-data/{slug}.json) + genereraUtkast()-mönster som redan
// är etablerat (VantelistaFlode.astro:s visaLuckor()).
//
// Betalknappen är nu KOPPLAD (api/checkout/bidragsutkast.ts) — se det
// scriptet för server-sidans matchKommun()-spärr (Jacobs order: profilen
// kontrolleras ÄVEN server-side innan en Checkout-session skapas, inte
// bara i UI:t här).
//
// Köprutans copy (Fable, 2026-07-31) — KOPRUTA (content.ts) ersätter de
// tidigare {{FABLE:}}-platshållarna. {kommun}/{bidrag}/{pris} är kända
// server-sidan (oberoende av besökarens profil); {antal} (luckor) är
// PROFILBEROENDE och fylls av klientskriptet tillsammans med resten av
// dokumentet. Ingen abonnemangsjämförelse i denna leverans — det FABLE-
// slotet fanns i mocken men täcks inte av den här copy-leveransen,
// utelämnat ur renderingen (inte ersatt med egen text).
//
// Konverteringsstapeln (F①–⑦, 2026-08-12, Jacob) — gate först i vart och
// ett, se KONVERTERINGSSTAPEL (content.ts) för grindmotiveringen per
// grepp:
//   F① Socialt bevis — server-sant genast (arbetsbeviset, samma två tal
//      som förstasidans bevisrad), klientskriptet UPPGRADERAR till det
//      lokala köpantalet om det når SOCIALT_BEVIS_GOLV (kopKlient.ts).
//      Aldrig en tom container medan fetchen pågår — samma
//      "server-sant genast"-mönster som LiveDataKort.astro.
//   F② Värdeankring — bidrag.belopp_status === 'kontrollast', känt
//      server-sidan, ingen fetch behövs.
//   F③ Förlustaversion — bidrag.deadlines.typ === 'fasta' (årligt
//      återkommande MM-DD, se kommunTyper.ts), känt server-sidan.
//   F④ Värdestapel — KOPRUTAs befintliga meningar omstrukturerade till
//      en lista, ingen ny text.
//   F⑤ Prisankring 249/495 — ABONNEMANG_LEVERANS_LIVE (priser.ts) är
//      false idag (påminnelsemejlet är mallkod) — grinden byggd, inget
//      nytt syns förrän Jacob sätter den true.
//   F⑥/F⑦ Garanti/kvitto — BETALFLODE_SKARPT_VERIFIERAT (priser.ts) är
//      false — grind byggd på Jacobs uttryckliga instruktion, innehållet
//      väntar.
import Base from '../../../../../layouts/Base.astro';
import BreadcrumbList from '../../../../../components/BreadcrumbList.astro';
import { loadKommuner, possessiv, beraknaArbetsbevis, beloppArEttEnkeltTal, individuelltBelopp } from '../../../../../lib/kommuner';
import type { Kommun, Bidrag, Arbetsbevis } from '../../../../../lib/kommuner';
import { PRIS_BIDRAGSUTKAST_ORE, ABONNEMANG_LEVERANS_LIVE, BETALFLODE_SKARPT_VERIFIERAT } from '../../../../../lib/priser';
import { KOPRUTA, KONVERTERINGSSTAPEL, FORSTASIDAN_SVARAR } from '../../../../../lib/content';

export function getStaticPaths() {
  const kommuner = loadKommuner();
  const arbetsbevis = beraknaArbetsbevis(kommuner);
  const paths: { params: { slug: string; bidragId: string }; props: { kommun: Kommun; bidrag: Bidrag; arbetsbevis: Arbetsbevis } }[] = [];
  for (const kommun of kommuner) {
    for (const bidrag of kommun.bidrag) {
      if (bidrag.status !== 'aktiv') continue;
      paths.push({ params: { slug: kommun.kommun_slug, bidragId: bidrag.id }, props: { kommun, bidrag, arbetsbevis } });
    }
  }
  return paths;
}

const { kommun, bidrag, arbetsbevis } = Astro.props as { kommun: Kommun; bidrag: Bidrag; arbetsbevis: Arbetsbevis };
const prisKr = PRIS_BIDRAGSUTKAST_ORE / 100;
const [forstaKravText, ...ovrigaKravText] = bidrag.krav;
const beloppPerForening = individuelltBelopp(bidrag);

const fyllKopruta = (text: string) =>
  text
    .replace('{kommun}', kommun.kommun)
    .replace('{kommunPossessiv}', possessiv(kommun.kommun))
    .replace('{bidrag}', bidrag.namn)
    .replace('{pris}', String(prisKr))
    .replace('{belopp}', beloppPerForening ?? '');

// F① — fallback-texten, server-sant genast (samma mall/tal som H1.5).
const socialtBevisFallback = FORSTASIDAN_SVARAR.bevisMall
  .replace('{bidrag}', arbetsbevis.totalBidrag.toLocaleString('sv-SE'))
  .replace('{kontrollasta}', arbetsbevis.kontrollastAntal.toLocaleString('sv-SE'));

// F② — kräver kontrollast OCH att beloppet är ett rent tal, inte en
// formel/pool ("Bestäms utifrån kommunens totalbelopp...", F8-fyndet:
// samma regel som beloppArEttEnkeltTal ger förstasidans svarsyta).
const vardeankringText =
  bidrag.belopp_status === 'kontrollast' && beloppArEttEnkeltTal(bidrag) !== null ? fyllKopruta(KONVERTERINGSSTAPEL.vardeankring) : null;

// F③ — 'fasta' = årligt återkommande MM-DD-datum (kommunTyper.ts), enda typen där "om ett år" stämmer.
const forlustaversionText = bidrag.deadlines.typ === 'fasta' ? KONVERTERINGSSTAPEL.forlustaversion : null;
---
<Base
  title={`Utkast — ${bidrag.namn} (${kommun.kommun}) — Föreningsguiden`}
  description={`Förhandsvisning av bidragsutkastet för ${bidrag.namn} i ${kommun.kommun} — personligt mot er förenings svar i matchningstratten.`}
  noindex={true}
>
  <BreadcrumbList items={[
    { name: 'Startsida', url: '/' },
    { name: kommun.kommun, url: `/kommun/${kommun.kommun_slug}/` },
    { name: 'Utkast', url: `/kommun/${kommun.kommun_slug}/utkast/${bidrag.id}/` },
  ]} />

  <noscript>
    <p class="utkastvy-noscript">Den här sidan visar ert personliga utkast och kräver JavaScript. Utan det ser ni bara kraven, inte om er förening redan uppfyller dem.</p>
  </noscript>

  <div class="utkastvy fg-card" data-utkastvy data-kommun-slug={kommun.kommun_slug} data-kommun-namn={kommun.kommun} data-bidrag-id={bidrag.id} data-bidrag-namn={bidrag.namn}>
    <div class="utkastvy__header">
      <p class="utkastvy__eyebrow">{kommun.kommun} kommun · {bidrag.namn}</p>
      <h1>Utkast till ansökan</h1>
      <p class="utkastvy__meta" data-utkastvy-meta>{beloppPerForening ?? 'Individuellt belopp inte fastställt'}</p>
    </div>

    <div data-utkastvy-status class="utkastvy__statusrad">Läser er föreningsprofil …</div>

    <div class="utkastvy__dokument" data-utkastvy-dokument hidden>
      {forstaKravText && (
        <div class="utkastvy__krav" data-utkastvy-krav data-krav-text={forstaKravText}>
          <p class="utkastvy__krav-text">{forstaKravText}</p>
          <p class="utkastvy__krav-svar" data-utkastvy-krav-svar>…</p>
        </div>
      )}

      {ovrigaKravText.length > 0 && (
        <div class="utkastvy__vagg">
          <div class="utkastvy__vagg-innehall">
            {ovrigaKravText.map((kravText) => (
              <div class="utkastvy__krav" data-utkastvy-krav data-krav-text={kravText}>
                <p class="utkastvy__krav-text">{kravText}</p>
                <p class="utkastvy__krav-svar" data-utkastvy-krav-svar>…</p>
              </div>
            ))}
          </div>
          <div class="utkastvy__vagg-gradient"></div>
        </div>
      )}
    </div>

    <div class="utkastvy__kopram" data-utkastvy-kopram hidden>
      <h2 class="utkastvy__kopruta-rubrik">{KOPRUTA.rubrik}</h2>

      {/* F① — server-sant genast (arbetsbeviset), klientskriptet
         uppgraderar till kommunens köpantal om det når SOCIALT_BEVIS_GOLV.
         Aldrig tom medan fetchen pågår. */}
      <p class="utkastvy__socialt-bevis" data-utkastvy-socialt-bevis>{socialtBevisFallback}</p>

      <p>{fyllKopruta(KOPRUTA.beskrivning)}</p>
      <p data-utkastvy-luckor-rad hidden></p>

      {/* F④ — värdestapel: samma tre KOPRUTA-meningar som tidigare stod
         som lösa stycken, nu en lista. Ingen ny text. */}
      <ul class="utkastvy__vardestapel">
        <li>{KOPRUTA.leverans}</li>
        <li>{fyllKopruta(KOPRUTA.prisOchKvitto)}</li>
      </ul>

      <p class="utkastvy__aterbetalning">{KOPRUTA.aterbetalning}</p>

      {/* F② — kräver bidrag.belopp_status === 'kontrollast'. */}
      {vardeankringText && <p class="utkastvy__vardeankring">{vardeankringText}</p>}

      {/* F③ — kräver bidrag.deadlines.typ === 'fasta'. */}
      {forlustaversionText && <p class="utkastvy__forlustaversion">{forlustaversionText}</p>}

      {/* F⑤ — ABONNEMANG_LEVERANS_LIVE är false idag (påminnelsemejlet
         är mallkod). Grinden byggd; ingen 495 kr/år-jämförelse renderas
         förrän Jacob sätter konstanten true och skriver jämförelsetexten
         (samma {{FABLE:}}-läge som PRIS.abonnemang.beskrivning). */}
      {ABONNEMANG_LEVERANS_LIVE && null}

      <p class="utkastvy__pris">{prisKr} kr</p>
      <button type="button" class="btn-primary" data-utkastvy-betala>
        Lås upp hela utkastet — {prisKr} kr
      </button>
      <p data-utkastvy-fel class="utkastvy__fel" hidden>Något gick fel. Försök igen.</p>
      <p class="utkastvy__ansvar" data-utkastvy-ansvar></p>

      {/* F⑥/F⑦ — BETALFLODE_SKARPT_VERIFIERAT är false (Jacobs instruktion
         2026-08-12: bygg grinden, låt innehållet vänta). Den befintliga
         ATERBETALNING-garantin ovan renderas oförändrat och ovillkorat —
         det här är en STARKARE, ännu oskriven variant, inte en ersättning. */}
      {BETALFLODE_SKARPT_VERIFIERAT && null}

      <a href={`/kommun/${kommun.kommun_slug}/#bidrag-${bidrag.id}`} class="utkastvy__escape">← Tillbaka till bidraget (gratis)</a>
    </div>

    {/* M2.4 (Jacob 2026-08-17): visas I STÄLLET för köprutan när
       checklistan inte har något ifyllt innehåll att sälja — samma
       spärr som checkout/bidragsutkast.ts (kravRader.length === 0 eller
       luckor === kravRader.length), läst ur samma resultat i
       klientskriptet, ingen hårdkodad lista. "En tom yta där köpknappen
       stod är sämre än en säljande knapp" (Jacob) — bevakning är gratis
       och fungerar i alla 290 kommuner, det enda vi faktiskt kan
       leverera där checklistan inte kan det än. */}
    <div class="utkastvy__kopram utkastvy__kopram--bevaka" data-utkastvy-bevaka hidden>
      <h2 class="utkastvy__kopruta-rubrik">Vi kan inte fylla i något än för det här bidraget</h2>
      <p>Kommunen har inte publicerat tillräckligt för att vi ska kunna skriva en personlig checklista för just det här bidraget än. Bevaka det i stället — gratis, och vi hör av oss i god tid innan sista ansökningsdag.</p>
      <div class="deadline-table__bevaka" data-bevaka-cell data-kommun-slug={kommun.kommun_slug} data-kommun-namn={kommun.kommun} data-bidrag-id={bidrag.id}>
        <a href={`/deadlines/?kommun=${kommun.kommun_slug}#email-signup`} class="btn-primary bevaka-rad-knapp utkastvy__bevaka-knapp">Bevaka det här bidraget</a>
      </div>
      <a href={`/kommun/${kommun.kommun_slug}/#bidrag-${bidrag.id}`} class="utkastvy__escape">← Tillbaka till bidraget (gratis)</a>
    </div>
  </div>
</Base>

<script>
  import { getForeningsprofil } from '../../../../../lib/foreningsprofil';
  import { genereraUtkast } from '../../../../../lib/utkastGenerator';
  import type { Kommun } from '../../../../../lib/kommunTyper';
  import { KOPRUTA, KONVERTERINGSSTAPEL } from '../../../../../lib/content';
  import { trackEvent } from '../../../../../lib/umami';
  import { hamtaKopantal, arOverSocialtBevisGolv } from '../../../../../lib/kopKlient';
  import { initBevakaWidgets } from '../../../../../lib/bevakaKlient';

  const root = document.querySelector<HTMLElement>('[data-utkastvy]');
  if (root) {
    const kommunSlug = root.dataset.kommunSlug ?? '';
    const bidragId = root.dataset.bidragId ?? '';
    const bidragNamn = root.dataset.bidragNamn ?? '';
    const statusEl = root.querySelector<HTMLElement>('[data-utkastvy-status]');
    const dokumentEl = root.querySelector<HTMLElement>('[data-utkastvy-dokument]');
    const kopramEl = root.querySelector<HTMLElement>('[data-utkastvy-kopram]');
    const bevakaEl = root.querySelector<HTMLElement>('[data-utkastvy-bevaka]');
    const metaEl = root.querySelector<HTMLElement>('[data-utkastvy-meta]');
    const ansvarEl = root.querySelector<HTMLElement>('[data-utkastvy-ansvar]');
    const betalaKnapp = root.querySelector<HTMLButtonElement>('[data-utkastvy-betala]');
    const felEl = root.querySelector<HTMLElement>('[data-utkastvy-fel]');
    const luckorRadEl = root.querySelector<HTMLElement>('[data-utkastvy-luckor-rad]');
    const socialtBevisEl = root.querySelector<HTMLElement>('[data-utkastvy-socialt-bevis]');

    // M2.4 — wiras en gång, oavsett om bevaka-slotet visar sig senare.
    // initBevakaWidgets() letar [data-bevaka-cell] i hela dokumentet vid
    // anropstillfället; elementet finns redan i DOM:en (bara hidden).
    initBevakaWidgets();

    // F① — servern har redan fyllt socialtBevisEl med arbetsbeviset
    // (server-sant genast). Uppgraderar TYST till det lokala köpantalet
    // bara om det faktiskt når tröskeln — ett nätverksfel eller en siffra
    // under golvet lämnar fallbacken orörd, den är redan sann.
    const kommunNamn = root.dataset.kommunNamn ?? kommunSlug;
    hamtaKopantal(kommunSlug).then((antal) => {
      if (antal === null || !arOverSocialtBevisGolv(antal) || !socialtBevisEl) return;
      socialtBevisEl.textContent = KONVERTERINGSSTAPEL.socialtBevis.replace('{antal}', String(antal)).replace('{kommun}', kommunNamn);
    });

    function visaStatus(text: string, lank?: { href: string; text: string }) {
      if (!statusEl) return;
      statusEl.textContent = text + ' ';
      if (lank) {
        const a = document.createElement('a');
        a.href = lank.href;
        a.textContent = lank.text;
        statusEl.appendChild(a);
      }
      statusEl.hidden = false;
      dokumentEl?.setAttribute('hidden', '');
      kopramEl?.setAttribute('hidden', '');
      bevakaEl?.setAttribute('hidden', '');
    }

    async function initiera() {
      const profil = getForeningsprofil();
      if (!profil || !profil.kommunSlug) {
        visaStatus('Vi känner inte igen er förening än.', {
          href: `/matcha/?fortsatt=${encodeURIComponent(JSON.stringify({ kommunSlug }))}`,
          text: 'Svara på fem frågor för att se ert utkast',
        });
        return;
      }
      if (profil.kommunSlug !== kommunSlug) {
        visaStatus('Er sparade profil gäller en annan kommun.', {
          href: `/matcha/?fortsatt=${encodeURIComponent(JSON.stringify({ kommunSlug }))}`,
          text: 'Svara för den här kommunen',
        });
        return;
      }

      let kommunData: Kommun;
      try {
        const res = await fetch(`/kommun-data/${kommunSlug}.json`);
        if (!res.ok) throw new Error('kommun-data 404');
        kommunData = (await res.json()) as Kommun;
      } catch {
        visaStatus('Kunde inte läsa kommunens data just nu. Ladda om sidan.');
        return;
      }

      const bidrag = kommunData.bidrag.find((b) => b.id === bidragId);
      if (!bidrag) {
        visaStatus('Det här bidraget hittades inte.');
        return;
      }

      const resultat = genereraUtkast(profil, bidrag, kommunData);

      if (resultat.typ === 'registrering_forst') {
        visaStatus('Er förening behöver registreras hos kommunen innan det här utkastet är aktuellt.', {
          href: `/kommun/${kommunSlug}/registrera/`,
          text: 'Till registreringsutkastet',
        });
        return;
      }

      // Klientens EGNA matchning — samma matchKommun() som resten av
      // tratten. Ren UX-vägvisning: förhindrar inte köpet på egen hand,
      // det gör api/checkout/bidragsutkast.ts server-side (Jacobs order —
      // "kontrollera matchKommun() innan Checkout-sessionen, inte bara i
      // UI:t"). Importeras separat för att inte dra in hela tratt-koden.
      const { matchKommun } = await import('../../../../../lib/matching');
      const matchning = matchKommun(profil, kommunData);
      if (!matchning.matchar.some((b) => b.id === bidragId)) {
        visaStatus('Det här bidraget verkar inte passa er förenings profil.', {
          href: `/kommun/${kommunSlug}/`,
          text: 'Se vad som faktiskt matchar',
        });
        return;
      }

      // Allt klart — fyll dokumentet.
      statusEl?.setAttribute('hidden', '');
      if (metaEl) {
        metaEl.textContent = `${resultat.belopp ?? 'Individuellt belopp inte fastställt'} · sista ansökningsdag ${resultat.deadlineText}`;
      }
      if (ansvarEl) ansvarEl.textContent = resultat.ansvarsrad;
      if (luckorRadEl) {
        luckorRadEl.textContent = KOPRUTA.luckorRad.replace('{antal}', String(resultat.luckor));
        luckorRadEl.hidden = false;
      }

      const kravEls = root!.querySelectorAll<HTMLElement>('[data-utkastvy-krav]');
      kravEls.forEach((el, i) => {
        const rad = resultat.kravRader[i];
        const svarEl = el.querySelector<HTMLElement>('[data-utkastvy-krav-svar]');
        if (!rad || !svarEl) return;
        svarEl.textContent = rad.innehall;
        svarEl.dataset.status = rad.status;
        if (rad.status === 'lucka') svarEl.classList.add('utkastvy__krav-svar--lucka');
      });

      dokumentEl?.removeAttribute('hidden');

      // M2.4 (Jacob 2026-08-17) — samma spärr som checkout/bidragsutkast.
      // ts SPÄRR 3, läst ur samma resultat: inget ifyllt innehåll att
      // sälja. Bevakningsrutan tar köpknappens plats i stället för en
      // tom yta — gratis, fungerar i alla 290 kommuner oavsett kravdata.
      const intetAttSalja = resultat.kravRader.length === 0 || resultat.luckor === resultat.kravRader.length;
      if (intetAttSalja) {
        bevakaEl?.removeAttribute('hidden');
        trackEvent('utkast_bevaka_visad', { kommun: kommunSlug, bidrag: bidragId });
      } else {
        kopramEl?.removeAttribute('hidden');
        // M5 (MÄTNING, Jacob 2026-08-11): köprutan faktiskt synlig — kräver
        // matchning + registrerad profil, så "visad" är redan en riktig
        // filtrering, inte bara en sidladdning.
        trackEvent('kopruta_visad', { kommun: kommunSlug, bidrag: bidragId });
      }
    }

    betalaKnapp?.addEventListener('click', async () => {
      felEl?.setAttribute('hidden', '');
      betalaKnapp.disabled = true;
      trackEvent('kopruta_klick', { kommun: kommunSlug, bidrag: bidragId });

      const profil = getForeningsprofil();
      const data = new FormData();
      data.set('kommun', kommunSlug);
      data.set('bidrag', bidragId);
      if (profil) data.set('profil', JSON.stringify(profil));

      try {
        const res = await fetch('/api/checkout/bidragsutkast', { method: 'POST', body: data });
        const json = await res.json();
        if (!res.ok || !json.ok || !json.url) throw new Error('svar ej ok');
        window.location.href = json.url;
      } catch {
        felEl?.removeAttribute('hidden');
        betalaKnapp.disabled = false;
      }
    });

    initiera();
  }
</script>

<style>
  .utkastvy-noscript {
    background: var(--fg-attention);
    color: var(--fg-on-accent);
    padding: var(--fg-space-4) var(--fg-space-6);
    border-radius: var(--fg-radius-control);
    margin-bottom: var(--fg-space-6);
  }

  .utkastvy {
    padding: 0;
    overflow: hidden;
  }

  .utkastvy__header {
    padding: var(--fg-space-6) var(--fg-space-7) var(--fg-space-3);
  }

  .utkastvy__eyebrow {
    font-family: var(--fg-font-mono);
    font-size: var(--fg-text-label);
    font-weight: var(--fg-weight-bold);
    letter-spacing: var(--fg-tracking-label);
    text-transform: uppercase;
    color: var(--fg-ink-muted);
    margin: 0;
  }

  .utkastvy__header h1 {
    margin: 6px 0 2px;
  }

  .utkastvy__meta {
    font-size: var(--fg-text-body);
    color: var(--fg-ink-muted);
    margin: 0;
  }

  .utkastvy__statusrad {
    margin: 0 var(--fg-space-7) var(--fg-space-6);
    padding: var(--fg-space-5);
    background: var(--fg-surface-sunken);
    border-radius: var(--fg-radius-card);
    font-size: var(--fg-text-body);
  }

  .utkastvy__dokument {
    padding: 0 var(--fg-space-7) var(--fg-space-3);
  }

  .utkastvy__krav {
    padding: var(--fg-space-4) 0;
    border-bottom: 1px solid var(--fg-border);
  }

  .utkastvy__krav-text {
    font-weight: var(--fg-weight-bold);
    margin: 0 0 4px;
